---
// src/layouts/Layout.astro
import siteSettings from '../content/settings/site.json';
import SiteStatusScreen from '../components/SiteStatusScreen.astro';

// ── Site status gate ──────────────────────────────────────────────────────
// Every page (home, /check, /data, EN + DE) renders through this Layout, so
// reading the status here is enough to cover the WHOLE public site with one
// switch. "live" = normal. "preparation"/"maintenance" = the entire site is
// replaced by SiteStatusScreen (see that component + _docs/README-SITE-STATUS.md).
// VD_SITE_STATUS (env) wins when set, so one codebase can produce BOTH builds
// in a single deploy run: the public "in preparation" site and the real site
// that sits behind the preview gate. See scripts/build-deploy.mjs. When the env
// var is absent (normal `npm run dev` / `npm run build`), site.json decides,
// exactly as before.
const siteStatus: string =
  (typeof process !== 'undefined' && process.env?.VD_SITE_STATUS) ||
  (siteSettings as any).siteStatus ||
  'live';
const isPaused = siteStatus === 'preparation' || siteStatus === 'maintenance';

interface Props {
  title:        string;
  theme?:       string;
  description?: string;
  ogImage?:     string;
  siteUrl?:     string;
  lang?:        'en' | 'de';
  // ── Visitor theme toggle (sun/moon) ─────────────────────────────────────
  // autoBg/autoText: the *effective* rendered colors for the "Current"
  // state — i.e. already resolved past any customBackgroundColor/
  // baseTextColor override in Site Settings, not just the theme preset's
  // own fixed values. Optional: pages that don't pass these (e.g. a page
  // that only cares about the theme preset, not per-field overrides) fall
  // back to the preset's own static --zen-bg/--zen-text below, unchanged
  // from how this worked before the toggle existed.
  // themeToggleEnabled: mirrors Site Settings' "enableThemeToggle" — gates
  // the FOUC-prevention script below so a disabled toggle never applies a
  // visitor's stale saved choice from a previous visit.
  autoBg?:            string;
  autoText?:           string;
  // autoFamily: 'light' | 'dark' classification of the Current state
  // (see themeFamily() in siteHelpers.ts) — the click-cycle script needs
  // this to know which forced state to visit first.
  autoFamily?:         'light' | 'dark';
  themeToggleEnabled?: boolean;
  // Force noindex on a single page (e.g. a switched-off Fit Check) even when the site is live.
  noindex?:            boolean;
}
const {
  title,
  theme       = 'light',
  description: descriptionProp = '',
  ogImage:     ogImageProp     = '',
  siteUrl     = (siteSettings as any).seo?.siteUrl || 'https://vortexdeep.ch',
  lang        = 'en',
  autoBg,
  autoText,
  autoFamily,
  themeToggleEnabled = false,
  noindex            = false,
} = Astro.props;

// ── SEO fallbacks ─────────────────────────────────────────────────────────
// Pages that don't pass their own description/ogImage (e.g. /check, /data)
// used to ship an EMPTY meta description and point og:image at
// /og-image.png, a file that does not exist. Fall back to Site Settings so
// every page always has a real description and a real share image.
const settingsDescription = lang === 'de'
  ? ((siteSettings as any).seo?.metaDescription_de || (siteSettings as any).seo?.metaDescription || '')
  : ((siteSettings as any).seo?.metaDescription || '');
const description = descriptionProp || settingsDescription;
const ogImage     = ogImageProp || (siteSettings as any).seo?.ogImage || '/images/vd-logo-512.png';

// ── Copy/right-click protection ──────────────────────────────────────────
// Opt-out via Site Settings (`enableContentProtection: false`). It never
// affected crawlers, but it does block select/copy/print for humans and
// assistive tech, which is a poor signal for a site that wants to be quoted
// by AI search engines. Defaults ON to preserve existing behaviour.
const contentProtection = (siteSettings as any).seo?.enableContentProtection !== false;

const canonical   = `${siteUrl}${Astro.url.pathname}`;
const ogImageFull = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// ── hreflang alternate URLs ───────────────────────────────────────────────────
const currentPath = Astro.url.pathname;
const enPath = currentPath.replace(/^\/de(\/|$)/, '/').replace(/\/+$/, '') || '/';
const dePath = currentPath.startsWith('/de')
  ? currentPath
  : '/de' + currentPath;

const hreflangEn = `${siteUrl}${enPath === '/' ? '/' : enPath}`;
const hreflangDe = `${siteUrl}${dePath}`;

const ogLocale = lang === 'de' ? 'de_CH' : 'en_GB';

// ── FIX 3: theme-color matches page background on mobile browser chrome ───────
const themeColorMap: Record<string, string> = {
  light: '#ffffff',
  dark:  '#000000',
  paper: '#F9F7F2',
  stone: '#f0ede8',
  mist:  '#eef0f2',
  ink:   '#141414',
  sand:  '#f5f0e8',
  deep:  '#0c0f14',
};
const themeColor = autoBg || themeColorMap[theme] || '#ffffff';

// ── Auto-state CSS override ───────────────────────────────────────────────
// The static :root[data-theme="X"] blocks below give every preset its own
// --zen-bg/--zen-text. That's correct for the two FORCED toggle states
// (literal light/dark — deliberately ignore any custom color, see Tina
// field description) but not for "Current", which should reflect any
// customBackgroundColor/baseTextColor override too. Rather than fight CSS
// specificity, this renders a second rule for the *same* attribute selector
// as the current preset, placed after it in source order — same
// specificity, later wins, so it cleanly overrides only the two properties
// that can actually be customized, and only when a page actually passes
// them in.
const autoOverrideCss = (autoBg || autoText)
  ? `:root[data-theme="${theme}"]{${autoBg ? `--zen-bg:${autoBg};` : ''}${autoText ? `--zen-text:${autoText};` : ''}}`
  : '';
---
<!doctype html>
<html lang={lang} data-content-protection={contentProtection ? 'true' : 'false'} data-theme={theme} data-auto-theme={theme} data-auto-family={autoFamily} data-theme-toggle={themeToggleEnabled ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <!-- FIX 2: initial-scale=1 prevents mobile browsers zooming in/out on load -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- FIX 3: browser chrome bar matches page background colour on iOS/Android -->
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- ── SEO: Core ── -->
    <title>{title}</title>
    <meta name="description"        content={description} />
    <link rel="canonical"           href={canonical} />
    <meta name="robots"             content={(isPaused || noindex) ? "noindex, nofollow" : "index, follow"} />

    <!-- ── SEO: hreflang (bilingual) ── -->
    <link rel="alternate" hreflang="en"        href={hreflangEn} />
    <link rel="alternate" hreflang="de"        href={hreflangDe} />
    <link rel="alternate" hreflang="x-default" href={hreflangEn} />

    <!-- ── SEO: Open Graph ── -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageFull} />
    <meta property="og:locale"      content={ogLocale} />
    <meta property="og:site_name"   content="VortexDeep" />

    <!-- ── SEO: Twitter / X Card ── -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageFull} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- The full family set, not just Inter. /check sets font-family from
         settings.appearance.fontPreset but had no stylesheet for it, so it was silently
         falling back to the OS monospace font and looking nothing like the
         homepage. -->
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@100;200;300;400;500;600;700&family=Inter:wght@100;300;400;500;600;700&family=Lora:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Space+Mono:wght@400;700&family=Newsreader:ital,wght@0,100;0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
    <slot name="head" />
    <style is:global>
      :root[data-theme="light"]  { --zen-bg:#ffffff; --zen-text:#0a0a0a; --zen-muted:#737373; --zen-accent:#000000; }
      :root[data-theme="dark"]   { --zen-bg:#000000; --zen-text:#f5f5f5; --zen-muted:#a3a3a3; --zen-accent:#ffffff; }
      :root[data-theme="paper"]  { --zen-bg:#F9F7F2; --zen-text:#0a0a0a; --zen-muted:#737373; --zen-accent:#0a0a0a; }
      :root[data-theme="stone"]  { --zen-bg:#f0ede8; --zen-text:#2c2a28; --zen-muted:#7a6e65; --zen-accent:#7a6e65; }
      :root[data-theme="mist"]   { --zen-bg:#eef0f2; --zen-text:#1e2428; --zen-muted:#5a7080; --zen-accent:#5a7080; }
      :root[data-theme="ink"]    { --zen-bg:#141414; --zen-text:#e8e4de; --zen-muted:#8c7355; --zen-accent:#8c7355; }
      :root[data-theme="sand"]   { --zen-bg:#f5f0e8; --zen-text:#2a2520; --zen-muted:#9a8060; --zen-accent:#9a8060; }
      :root[data-theme="deep"]   { --zen-bg:#0c0f14; --zen-text:#e0e2e8; --zen-muted:#6e7a8a; --zen-accent:#8aa4c0; }
      body {
        background-color: var(--zen-bg);
        color: var(--zen-text);
        font-family: 'Inter', sans-serif;
        transition: background-color 0.7s ease, color 0.7s ease;
        margin: 0;
        -webkit-font-smoothing: antialiased;
      }
      html[data-content-protection="true"] * { -webkit-user-select:none; -moz-user-select:none; -ms-user-select:none; user-select:none; }
      html[data-content-protection="true"] input, html[data-content-protection="true"] textarea, html[data-content-protection="true"] [contenteditable] { -webkit-user-select:text; -moz-user-select:text; user-select:text; }
      html[data-content-protection="true"] img { -webkit-user-drag:none; pointer-events:none; }
      ::-webkit-scrollbar { width:5px; }
      ::-webkit-scrollbar-track { background:var(--zen-bg); }
      ::-webkit-scrollbar-thumb { background:var(--zen-muted); border-radius:10px; }

      /* ── Global motion safeguard ──────────────────────────────────────────
         Applies to every animation across the site (existing vd-load-fade /
         vd-reveal / vd-hint as well as the new logo-draw, status-dot,
         connector-pulse and cascading-reveal animations added in SitePage.astro).
         Users who request reduced motion get an effectively instant,
         non-looping experience instead of every effect being hand-patched. */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
    {autoOverrideCss && <style set:html={autoOverrideCss}></style>}

    <!-- ── Theme toggle: FOUC-prevention ──────────────────────────────────────
         Must run before first paint. Reads any saved visitor choice and, if
         present, applies it immediately — otherwise the page would flash the
         admin's "Current" theme for a frame before JS caught up. Only ever
         reads/writes when the admin has the toggle switched on; if a visitor
         saved a forced choice on an earlier visit and the admin has since
         turned the toggle off, that stored choice is simply never read here,
         so the page shows "Current" as if the visitor had never toggled. -->
    <script is:inline define:vars={{ toggleEnabled: themeToggleEnabled === true }}>
      if (toggleEnabled) {
        try {
          var vdSaved = localStorage.getItem('vd-theme-choice');
          if (vdSaved === 'light' || vdSaved === 'dark') {
            document.documentElement.setAttribute('data-theme', vdSaved);
            document.documentElement.setAttribute('data-theme-forced', vdSaved);
          }
        } catch (e) {}
      }
    </script>

    <!-- ── Theme toggle: click handling ─────────────────────────────────────
         One button (data-vd-theme-cycle) steps through a fixed 3-position
         cycle each click: Current (Auto) → forced state opposite Current's
         own family → forced state matching Current's family → back to
         Auto. E.g. Current = deep (dark family): Auto → forced-light →
         forced-dark → Auto. Delegated on document so it works regardless
         of which page template renders the button. Dispatches
         vd-theme-change so live-rendered elements (e.g. the particle
         background canvas) can react without a reload. -->
    <script is:inline>
      function vdNextThemeState(current, family) {
        // current: null (Auto) | 'light' | 'dark'  — family: 'light' | 'dark'
        var opposite = family === 'light' ? 'dark' : 'light';
        if (current === null) return opposite;
        if (current === opposite) return family;
        return null;
      }
      function vdApplyTheme(mode) {
        var html = document.documentElement;
        if (mode) {
          html.setAttribute('data-theme', mode);
          html.setAttribute('data-theme-forced', mode);
          try { localStorage.setItem('vd-theme-choice', mode); } catch (e) {}
        } else {
          html.setAttribute('data-theme', html.dataset.autoTheme || 'light');
          html.removeAttribute('data-theme-forced');
          try { localStorage.removeItem('vd-theme-choice'); } catch (e) {}
        }
        window.dispatchEvent(new CustomEvent('vd-theme-change', { detail: { mode: mode || 'auto' } }));
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-vd-theme-cycle]');
        if (!btn) return;
        var html = document.documentElement;
        var current = html.getAttribute('data-theme-forced'); // null | 'light' | 'dark'
        var family = html.dataset.autoFamily || 'light';
        vdApplyTheme(vdNextThemeState(current, family));
      });
    </script>
  </head>
  <body>
    {isPaused
      ? <SiteStatusScreen mode={siteStatus as 'preparation' | 'maintenance'} lang={lang} />
      : <slot />}
    <!-- Content & code protection (Site Settings → enableContentProtection) -->
    {contentProtection && (
    <script is:inline>
    (function(){
      // Right-click disabled
      document.addEventListener('contextmenu', function(e){ e.preventDefault(); });

      // Keyboard shortcuts that expose source / devtools
      document.addEventListener('keydown', function(e){
        var c = e.ctrlKey || e.metaKey, s = e.shiftKey, k = e.key;
        if(c && k==='u'){ e.preventDefault(); return; }  // view-source
        if(c && k==='s'){ e.preventDefault(); return; }  // save page
        if(c && k==='a'){ e.preventDefault(); return; }  // select all
        if(c && k==='p'){ e.preventDefault(); return; }  // print
        if(k==='F12'){    e.preventDefault(); return; }  // devtools
        if(c && s && k==='I'){ e.preventDefault(); return; } // devtools
        if(c && s && k==='J'){ e.preventDefault(); return; } // console
        if(c && s && k==='C'){ e.preventDefault(); return; } // element picker
      });

      // Drag disabled
      document.addEventListener('dragstart', function(e){ e.preventDefault(); });

      // Copy disabled outside input fields
      document.addEventListener('copy', function(e){
        var t = document.activeElement ? document.activeElement.tagName : '';
        if(t !== 'INPUT' && t !== 'TEXTAREA'){ e.preventDefault(); }
      });

      // FIX 1: removed window size DevTools detection — it false-positives on
      // every iPhone and iPad because Safari's address bar / toolbar creates an
      // outerHeight vs innerHeight gap that exceeds the 160px threshold, causing
      // document.body.innerHTML='' to fire and produce a blank page on mobile.
    })();
    </script>
    )}
  </body>
</html>
