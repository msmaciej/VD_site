---
// src/pages/check.astro  →  vortexdeep.ch/check
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { themeColors, fontFamily, socialIcon } from '../utils/siteHelpers.ts';

// Pull real Site Settings so this page mimics the rest of the site's header,
// footer, and theme — same data source index.astro passes into
// SitePage.astro — instead of a hardcoded 'paper' theme and a bare text
// link. Note: settings.customBackgroundColor / settings.baseTextColor (the
// per-field colour overrides SitePage supports on top of a theme preset)
// are NOT applied here — this page uses the theme preset only, via
// Layout.astro's existing var(--zen-bg) / var(--zen-text) / var(--zen-muted)
// custom properties. Adding override support cleanly would mean redefining
// those custom properties at :root, which risks fighting Astro's
// define:vars scoping rather than a simple, safe addition — flagging as a
// known gap rather than a silent one.
const settingFiles = await Astro.glob('../content/settings/*.json');
const settings = settingFiles[0]?.default || {};

const currentTheme = settings.theme || 'light';
const currentYear  = new Date().getFullYear();

const activeFont = (settings.fontPreset === 'custom' && settings.customFontName)
  ? settings.customFontName
  : (settings.fontPreset || 'Inter');
const activeFontFamily = fontFamily(activeFont);

const headerHeight     = settings.headerHeight     || '52px';
const footerHeight     = settings.footerHeight     || '44px';
const headerInnerWidth = settings.headerInnerWidth || '680px';

const homeUrl = '/';
const resolvedNavLinks = (settings.navLinks || []).map((link: any) => ({
  label: link.label,
  url:   link.url,
}));

// Fit Check's own header animations (logo ink-draw, breathing status dot,
// page load-fade) are admin-configurable independently of the home page's
// equivalent toggles, and default OFF — this is a conversion-focused funnel
// page, and starts calm/instant by default rather than inheriting the home
// page's animate-by-default behaviour. See tina/config.ts,
// enableCheckPageAnimations.
const checkAnimationsEnabled = settings.enableCheckPageAnimations === true;
---

<Layout title="VortexDeep — Quick Operations Check" theme={currentTheme} lang="en">
  <!-- ── FIXED HEADER — mirrors SitePage.astro's header for parity with the
       rest of the site. See that file's header block if this needs to
       change; the two aren't shared as a component (this page doesn't
       route through SitePage.astro), so keep them in sync by hand. ── -->
  <header class={`vd-fixed-header ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);"
               class={`w-5 h-5 flex-shrink-0 ${checkAnimationsEnabled ? 'vd-logo' : ''}`}>
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class="text-[10px] uppercase tracking-[0.4em]"
              style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
          {settings.siteName || 'VortexDeep'}
        </span>
        {checkAnimationsEnabled && (
          <span class="vd-status-dot" style="color: var(--zen-text);" aria-hidden="true"></span>
        )}
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`${settings.headerLinksFontSize || 'text-[10px]'} uppercase tracking-[0.3em] opacity-50 hover:opacity-100 transition-opacity`}
             style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="en" slug="check" />
      </nav>
    </div>
  </header>

  <!-- FIX 10: min-h-[100svh] avoids the iOS Safari 100vh-includes-chrome trap.
       justify-start on mobile keeps content anchored to the top so all 6 answer
       options are reachable without blind scrolling; justify-center kicks in at sm
       (640px+) where there's room to centre. Padding-top/bottom clear the fixed
       header/footer above instead of the old fixed pt-16/pb-12 — header and
       footer height are both admin-configurable in Site Settings, same as
       every other page. -->
  <main class="min-h-[100svh] flex flex-col items-center justify-start sm:justify-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); padding-top: calc(${headerHeight} + 24px); padding-bottom: calc(${footerHeight} + 24px);`}>
    <div class="max-w-xl w-full mx-auto" id="vd-root">

      <p class="text-[10px] uppercase tracking-[0.4em] mb-8 sm:mb-16 opacity-40 text-center">
        Quick Operations Check
      </p>

      <div class="flex gap-2 mb-8 sm:mb-16" id="vd-progress"></div>

      <!-- Q0: Role -->
      <div class="vd-q" data-q="0">
        <p class="vd-ql">What best describes you right now?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="business">Business owner or manager handling day-to-day operations</button>
          <button class="vd-opt" data-val="consultant">Consultant or agency exploring this for clients</button>
          <button class="vd-opt" data-val="curious">Researching AI automation generally / just curious</button>
        </div>
      </div>

      <!-- Q1: Pain area — aligned to 10 automation categories -->
      <div class="vd-q hidden" data-q="1">
        <p class="vd-ql">Which area of your operations absorbs the most unnecessary time right now?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="comms">Handling incoming inquiries, messages, or customer support requests</button>
          <button class="vd-opt" data-val="sales">Following up with leads or managing the sales pipeline — things fall through the cracks</button>
          <button class="vd-opt" data-val="docs">Processing documents, invoices, contracts, or forms — reading, extracting, re-entering data</button>
          <button class="vd-opt" data-val="ops">Internal approvals, task routing, onboarding sequences, or scheduling</button>
          <button class="vd-opt" data-val="reporting">Pulling together reports or aggregating data from multiple sources</button>
          <button class="vd-opt" data-val="content">Creating or distributing content — social posts, newsletters, or e-commerce flows</button>
          <button class="vd-opt" data-val="several">Several of these at once</button>
        </div>
      </div>

      <!-- Q2: Time cost -->
      <div class="vd-q hidden" data-q="2">
        <p class="vd-ql">Roughly how many hours a week does this kind of work absorb?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="high">More than 5 hours</button>
          <button class="vd-opt" data-val="mid">1–5 hours</button>
          <button class="vd-opt" data-val="low">Less than an hour</button>
          <button class="vd-opt" data-val="unsure">Hard to say — it's spread across the team</button>
        </div>
      </div>

      <!-- Q3: Process ownership -->
      <div class="vd-q hidden" data-q="3">
        <p class="vd-ql">Is there a clear process for this, or does it depend on who's available?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="none">No real process — whoever has time handles it</button>
          <button class="vd-opt" data-val="partial">Some rules exist but it's still inconsistent</button>
          <button class="vd-opt" data-val="full">There's a defined process — we just need it to run faster</button>
        </div>
      </div>

      <!-- Q4: Goal / intent -->
      <div class="vd-q hidden" data-q="4">
        <p class="vd-ql">What would a useful outcome look like for you?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="solve">A practical workflow that takes this off my plate — or at least reduces it</button>
          <button class="vd-opt" data-val="clarity">More visibility into what's happening, so I can make better decisions</button>
          <button class="vd-opt" data-val="explore">A general sense of what's possible before committing to anything</button>
          <button class="vd-opt" data-val="compare">Understanding how others have approached this</button>
        </div>
      </div>

      <div class="flex justify-between items-center mt-12" id="vd-nav">
        <button id="vd-back" class="text-[10px] uppercase tracking-[0.3em] opacity-40 hover:opacity-80 transition-opacity" disabled>← Back</button>
        <span id="vd-step" class="text-[10px] uppercase tracking-[0.3em] opacity-40">1 / 5</span>
      </div>

      <!-- GATE -->
      <div id="vd-gate" class="hidden text-center">
        <p class="vd-tag">One last step</p>
        <h2 class="vd-rh">Leave your email to see your result.</h2>
        <p class="vd-rb">
          We'll show you where you stand and follow up directly if there's a fit.
          No automated sequences.
        </p>
        <form id="vd-gate-form" class="flex flex-col gap-5 max-w-sm mx-auto text-left mt-8">
          <input type="hidden" name="source" value="vortexdeep.ch quick check">
          <input type="hidden" name="bucket"  id="gate-bucket">
          <input type="hidden" name="role"    id="gate-role">
          <input type="hidden" name="pain"    id="gate-pain">
          <input type="hidden" name="time"    id="gate-time">
          <input type="hidden" name="process" id="gate-process">
          <input type="hidden" name="goal"    id="gate-goal">
          <input type="hidden" name="form_load_time" id="gate-load-time">
          <input type="text" name="website_url" style="position:absolute;left:-9999px;width:1px;height:1px;" tabindex="-1" autocomplete="off"/>
          <label class="block">
            <span class="vd-fl">Email</span>
            <input name="email" type="email" required class="vd-input" placeholder="your@email.com"/>
          </label>
          <label class="block">
            <span class="vd-fl">Name (optional)</span>
            <input name="name" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Company (optional)</span>
            <input name="company" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">One line on your situation (optional)</span>
            <textarea name="note" rows="2" class="vd-input"></textarea>
          </label>
          <div style="border:1px solid var(--zen-muted); padding:16px 20px; border-radius:4px; opacity:0.85;">
            <div class="flex items-center justify-between gap-6">
              <div>
                <span class="vd-fl" style="margin-bottom:6px;display:block;">Security check</span>
                <p class="text-[12px] uppercase tracking-[0.08em]" style="color:var(--zen-text); margin:0;">
                  Calculate: <strong id="vd-math-q" style="opacity:1;">···</strong>
                </p>
              </div>
              <input name="math_answer" type="number" required
                     class="vd-input"
                     placeholder="?"
                     style="width:64px; text-align:center; font-size:16px; border-bottom:1px solid var(--zen-text);"/>
            </div>
          </div>
          <p id="vd-gate-error" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            Incorrect answer or invalid email — please try again.
          </p>
          <button type="submit"
                  class="mt-2 text-[10px] uppercase tracking-[0.4em] border-b pb-2 self-center hover:opacity-50 transition-opacity"
                  style="background:none;border-top:none;border-left:none;border-right:none;border-bottom:1px solid var(--zen-text);cursor:pointer;font-family:inherit;color:var(--zen-text);">
            See my result
          </button>
        </form>
      </div>

      <!-- RESULT: Lead -->
      <div class="vd-result hidden text-center" id="vd-res-lead">
        <p class="vd-tag">Likely a fit</p>
        <h2 class="vd-rh">This sounds like exactly the kind of situation we work on.</h2>
        <p class="vd-rb">
          Real operational cost, no clear owner, and a practical outcome in mind —
          that's the pattern behind most of our projects. We'll be in touch directly.
        </p>
        <p id="vd-lead-context" class="vd-rb" style="opacity:0.5; font-style:normal;"></p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">Follow on LinkedIn</a>
        <br><button class="vd-restart mt-8">Start over</button>
      </div>

      <!-- RESULT: Warm -->
      <div class="vd-result hidden text-center" id="vd-res-warm">
        <p class="vd-tag">Worth a closer look</p>
        <h2 class="vd-rh">Knowing your operations well is a good sign, not a disqualifier.</h2>
        <p class="vd-rb">
          Processes that appear low-cost on time are often strong candidates for automation —
          the value shows up in consistency, error reduction, or freed attention rather than hours alone.
          A Discovery session is the right way to evaluate whether there is a genuine fit.
          We have your details and will follow up.
        </p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">Follow on LinkedIn</a>
        <br><button class="vd-restart mt-8">Start over</button>
      </div>

      <!-- RESULT: Other -->
      <div class="vd-result hidden text-center" id="vd-res-other">
        <p class="vd-tag">Thanks for going through this</p>
        <h2 class="vd-rh">If you'd like to see how we work, the best place is our LinkedIn.</h2>
        <p class="vd-rb">
          We share practical case studies and real workflow examples there —
          the kind of detail that gives a clearer picture than a check like this can.
        </p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">Follow on LinkedIn</a>
        <br><button class="vd-restart mt-8">Start over</button>
      </div>

    </div>
  </main>

  <!-- ── FIXED FOOTER — mirrors SitePage.astro's footer ── -->
  <footer class={`vd-fixed-footer ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${settings.footerTextFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30`}
       style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
      {settings.footerText
        ? settings.footerText
        : `© ${currentYear} ${settings.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global>
    /* ── Fixed header / footer chrome — mirrors SitePage.astro ── */
    .vd-fixed-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
    }
    .vd-fixed-header-inner {
      width: 100%;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1rem, 4vw, 2rem);
    }
    .vd-fixed-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
      gap: 1.2rem;
    }
    .vd-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px;
      border: 1px solid currentColor;
      font-size: 8px; font-weight: 600;
      letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none;
      border-radius: 3px; opacity: 0.35;
      transition: opacity 0.25s ease;
    }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    /* ── Logo ink-draw + breathing status dot + page load-fade — same
       effects as SitePage.astro's "NEW 1" / "NEW 2" / .vd-load-fade,
       duplicated here (this page doesn't route through SitePage.astro).
       Only ever applied when checkAnimationsEnabled is true — see
       enableCheckPageAnimations in tina/config.ts, defaults off. ── */
    .vd-logo polygon,
    .vd-logo polyline,
    .vd-logo path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: vdDraw 1.3s ease forwards;
    }
    .vd-logo polyline,
    .vd-logo path { animation-delay: 0.85s; }
    .vd-logo circle {
      opacity: 0;
      animation: vdDot 0.35s ease forwards 1.25s;
    }
    @keyframes vdDraw { to { stroke-dashoffset: 0; } }
    @keyframes vdDot  { to { opacity: 1; } }

    .vd-status-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      display: inline-block; margin-left: 8px;
      animation: vdBreathe 3s ease-in-out infinite;
    }
    @keyframes vdBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1);   }
      50%      { opacity: 0.85; transform: scale(1.5); }
    }

    .vd-load-fade { animation: vdLoad 1.8s cubic-bezier(0.4,0,0.2,1) forwards; }
    @keyframes vdLoad {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0);    }
    }
  </style>

  <style>
    .vd-ql { font-size:14px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 2rem; text-align:center; }
    .vd-opt { text-align:left; font-size:11px; letter-spacing:0.05em; text-transform:uppercase; padding:14px 4px; border:none; border-bottom:1px solid var(--zen-muted); background:transparent; color:var(--zen-text); opacity:0.6; cursor:pointer; font-family:inherit; transition:opacity 0.2s ease, border-color 0.2s ease; width:100%; }
    .vd-opt:hover { opacity:1; border-color:var(--zen-text); }
    .vd-opt.selected { opacity:1; border-color:var(--zen-text); font-weight:600; }
    .vd-tag { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; opacity:0.5; border-bottom:1px solid var(--zen-muted); display:inline-block; padding-bottom:6px; margin-bottom:1.5rem; }
    .vd-rh { font-size:16px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 1rem; }
    .vd-rb { opacity:0.65; font-size:13px; line-height:1.7; max-width:38rem; margin:0 auto 2rem; }
    .vd-fl { font-size:9px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; display:block; margin-bottom:4px; }
    .vd-input { width:100%; background:transparent; border:none; border-bottom:1px solid var(--zen-muted); color:var(--zen-text); font-family:inherit; font-size:13px; padding:8px 2px; resize:vertical; }
    .vd-input:focus { outline:none; border-color:var(--zen-text); }
    .vd-soft-link { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; color:var(--zen-text); border-bottom:1px solid var(--zen-muted); padding-bottom:3px; text-decoration:none; }
    .vd-soft-link:hover { opacity:1; }
    .vd-restart { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.4; background:none; border:none; cursor:pointer; font-family:inherit; color:var(--zen-text); }
    .vd-restart:hover { opacity:0.9; }
    #vd-progress span { height:1px; flex:1; background:var(--zen-muted); opacity:0.3; transition:opacity 0.3s ease, background 0.3s ease; }
    #vd-progress span.done { opacity:1; background:var(--zen-text); }
    .hidden { display:none; }
  </style>

  <script>
    const TOTAL = 5;
    const answers: Record<number, string> = {};
    let current = 0;

    const progressWrap = document.getElementById('vd-progress')!;
    for (let i = 0; i < TOTAL; i++) progressWrap.appendChild(document.createElement('span'));

    const backBtn = document.getElementById('vd-back') as HTMLButtonElement;
    const stepEl  = document.getElementById('vd-step')!;
    const nav     = document.getElementById('vd-nav')!;
    const qEls    = Array.from(document.querySelectorAll<HTMLElement>('.vd-q'));

    function render() {
      qEls.forEach(q => q.classList.toggle('hidden', Number(q.dataset.q) !== current));
      progressWrap.querySelectorAll('span').forEach((s, i) => s.classList.toggle('done', i <= current));
      stepEl.textContent = `${current + 1} / ${TOTAL}`;
      backBtn.disabled = current === 0;
    }

    qEls.forEach(q => {
      q.querySelectorAll<HTMLButtonElement>('.vd-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(q.dataset.q);
          answers[idx] = btn.dataset.val || '';
          q.querySelectorAll('.vd-opt').forEach(o => o.classList.remove('selected'));
          btn.classList.add('selected');
          setTimeout(() => {
            if (idx < TOTAL - 1) { current = idx + 1; render(); }
            else showGate();
          }, 160);
        });
      });
    });

    backBtn.addEventListener('click', () => { if (current > 0) { current--; render(); } });

    // pain values: comms | sales | docs | ops | reporting | content | several
    // Categories covered:
    //   comms     → Communication & Intake + Customer Support & After-Sales
    //   sales     → Lead & Sales Pipeline
    //   docs      → Document & Data Processing + Finance & Admin
    //   ops       → Internal Operations & Approvals + Scheduling & Booking
    //   reporting → Reporting & Analytics
    //   content   → Content & Marketing + E-commerce & Fulfilment
    //   several   → multiple categories (strongest signal)
    function calcBucket(): 'lead' | 'warm' | 'other' {
      const role = answers[0], pain = answers[1], time = answers[2], process = answers[3], goal = answers[4];
      if (role === 'consultant' || goal === 'compare' || role === 'curious') return 'other';
      const hasRealTimeCost = time === 'high' || time === 'mid' || time === 'unsure';
      const hasMultiPain   = pain === 'several';
      const wantsOutcome   = goal === 'solve' || goal === 'clarity';
      const processGap     = process !== 'full';
      if (role === 'business' && (hasRealTimeCost || hasMultiPain) && processGap && wantsOutcome) return 'lead';
      if (role === 'business') return 'warm';
      return 'other';
    }

    async function showGate() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');

      const bucket = calcBucket();
      (document.getElementById('gate-bucket')  as HTMLInputElement).value = bucket;
      (document.getElementById('gate-role')    as HTMLInputElement).value = answers[0] || '';
      (document.getElementById('gate-pain')    as HTMLInputElement).value = answers[1] || '';
      (document.getElementById('gate-time')    as HTMLInputElement).value = answers[2] || '';
      (document.getElementById('gate-process') as HTMLInputElement).value = answers[3] || '';
      (document.getElementById('gate-goal')    as HTMLInputElement).value = answers[4] || '';
      (document.getElementById('gate-load-time') as HTMLInputElement).value = String(Math.floor(Date.now() / 1000));

      try {
        const res = await fetch('/get-math.php');
        const data = await res.json();
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = data.question;
      } catch (_) {
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = '3 + 5';
      }
      document.getElementById('vd-gate')!.classList.remove('hidden');
    }

    document.getElementById('vd-gate-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const errorEl = document.getElementById('vd-gate-error')!;
      const bucket  = (document.getElementById('gate-bucket') as HTMLInputElement).value;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.textContent = '...'; btn.disabled = true; errorEl.classList.add('hidden');
      try {
        const res = await fetch('/send-check.php', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.status === 'ok') {
          document.getElementById('vd-gate')!.classList.add('hidden');
          document.getElementById('vd-res-' + bucket)!.classList.remove('hidden');
          // Inject category-specific line into lead result
          if (bucket === 'lead') {
            const ctx: Record<string, string> = {
              comms:     'Communication and inquiry handling is one of our most active areas — classification, routing, and draft replies.',
              sales:     'Sales pipeline automation fits the phase-gated approach well — clear scope, measurable outcome from day one.',
              docs:      'Document processing — invoice extraction, contract handling, form capture — is where we see some of the fastest project gains.',
              ops:       'Internal workflow automation — approvals, onboarding, scheduling — reduces coordination overhead quickly and durably.',
              reporting: 'Automated reporting runs well as a managed service — once built, it runs and you receive the output monthly.',
              content:   'Content and e-commerce automation scales output without scaling headcount — exactly the kind of leverage we build for.',
              several:   'Multi-area operational pain is often the clearest fit for what we do — we scope and prioritise together in Phase 1.',
            };
            const ctxEl = document.getElementById('vd-lead-context');
            if (ctxEl) ctxEl.textContent = ctx[answers[1]] || '';
          }
        } else {
          errorEl.classList.remove('hidden');
          btn.textContent = 'See my result'; btn.disabled = false;
          const mathRes = await fetch('/get-math.php');
          const mathData = await mathRes.json();
          const mathEl = document.getElementById('vd-math-q');
          if (mathEl) mathEl.textContent = mathData.question;
          (form.querySelector('input[name="math_answer"]') as HTMLInputElement).value = '';
        }
      } catch (_) {
        errorEl.classList.remove('hidden'); btn.textContent = 'See my result'; btn.disabled = false;
      }
    });

    document.querySelectorAll('.vd-restart').forEach(btn => btn.addEventListener('click', () => window.location.reload()));
    render();
  </script>
</Layout>
