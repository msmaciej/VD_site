---
// src/pages/check.astro  →  vortexdeep.ch/check
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { themeColors, themeFamily, fontFamily, fontScaleFactor, socialIcon, fontSizeClass, textStyle, fontSizePx, fontWeightNumber, trackingEm } from '../utils/siteHelpers.ts';

// Pull real Site Settings so this page mimics the rest of the site's header,
// footer, and theme — same data source index.astro passes into
// SitePage.astro — instead of a hardcoded 'paper' theme and a bare text
// link. Note: settings.appearance.customBackgroundColor / settings.appearance.baseTextColor (the
// per-field colour overrides SitePage supports on top of a theme preset)
// are NOT applied here — this page uses the theme preset only, via
// Layout.astro's existing var(--zen-bg) / var(--zen-text) / var(--zen-muted)
// custom properties. Adding override support cleanly would mean redefining
// those custom properties at :root, which risks fighting Astro's
// define:vars scoping rather than a simple, safe addition — flagging as a
// known gap rather than a silent one.
const settingFiles = await Astro.glob('../content/settings/*.json');
const settings = settingFiles[0]?.default || {};
const typo = (settings.typography || {}) as any;

// Fit Check quiz content — was entirely hardcoded CSS, now driven by
// Typography → Label / Fit Check roles (blank there = these exact values).
// The existing fcTextScale multiplier is preserved on top, unchanged.
const qz = {
  qlSize: typo.quizTitle?.size ? fontSizePx(typo.quizTitle.size) : '15px',
  qlWeight: typo.quizTitle?.weight ? fontWeightNumber(typo.quizTitle.weight) : '200',
  qlTracking: typo.quizTitle?.tracking ? trackingEm(typo.quizTitle.tracking) : '0.04em',
  qlOpacity: typo.quizTitle?.opacity ?? 100,
  rhSize: typo.quizTitle?.size ? fontSizePx(typo.quizTitle.size) : '17px',
  optSize: typo.label?.size ? fontSizePx(typo.label.size) : '13px',
  optTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.05em',
  tagSize: typo.label?.size ? fontSizePx(typo.label.size) : '11px',
  tagTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.2em',
  flTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.3em',
  labelWeight: typo.label?.weight ? fontWeightNumber(typo.label.weight) : '400',
  rbSize: typo.quizBody?.size ? fontSizePx(typo.quizBody.size) : '14px',
  rbOpacity: typo.quizBody?.opacity ?? 65,
  inputSize: typo.quizBody?.size ? fontSizePx(typo.quizBody.size) : '14px',
  quizFont: typo.quizTitle?.font ? fontFamily(typo.quizTitle.font) : null,
  labelFont: typo.label?.font ? fontFamily(typo.label.font) : null,
  bodyFont: typo.quizBody?.font ? fontFamily(typo.quizBody.font) : null,
};

const currentTheme = settings.appearance.theme || 'light';
const currentYear  = new Date().getFullYear();

// Mirror SitePage.astro so the Fit Check behaves like the rest of the site:
// pass the visitor theme-toggle gate and the light/dark family classification
// into Layout. Without these, Layout's FOUC-restore script stays gated off
// (const toggleEnabled = false), so a visitor's saved light/dark choice made
// elsewhere on the site is ignored here and the page renders in the admin's
// preset theme regardless — which is why the Fit Check didn't match the site.
const themeToggleEnabled = settings.appearance.enableThemeToggle === true;
const autoFamily = themeFamily(themeColors[currentTheme]?.bg || '#ffffff');

const activeFont = (settings.appearance.fontPreset === 'custom' && settings.appearance.customFontName)
  ? settings.appearance.customFontName
  : (settings.appearance.fontPreset || 'Inter');
let activeFontFamily = fontFamily(activeFont);
const headerHeight     = settings.layout.headerHeight     || '52px';
const footerHeight     = settings.layout.footerHeight     || '44px';
const headerInnerWidth = settings.layout.headerInnerWidth || '680px';

const homeUrl = '/';

const contactEmail = settings.seo.contactEmail || 'info@vortexdeep.ch';

// Fit Check's own header animations (logo ink-draw, breathing status dot,
// page load-fade) are admin-configurable independently of the home page's
// equivalent toggles, and default OFF — this is a conversion-focused funnel
// page, and starts calm/instant by default rather than inheriting the home
// page's animate-by-default behaviour. See tina/config.ts,
// enableCheckPageAnimations.
const checkAnimationsEnabled = settings.animations.enableCheckPageAnimations === true;

// ── Fit Check content (Tina-managed) ────────────────────────────────────────
// All question/option copy below comes from src/content/fitcheck/config.json,
// registered in Tina as the "fitCheck" collection (tina/fitcheck-schema.ts).
// Every question — including Q2 "time cost" — now reads its labels from Tina.
// Only the option VALUES (data-val="high" etc.) stay hardcoded, because the
// server-side scoring keys off them; the visible labels are all CMS-editable.
const fitCheckFiles = await Astro.glob('../content/fitcheck/*.json');
const fc = fitCheckFiles[0]?.default || {};

// Master switch (Tina: Fit Check → "Fit Check enabled"). Off = this page's
// own nav link hides itself and the quiz below is replaced by a short
// "not available" notice — see the vd-root conditional further down.
const fitCheckEnabled = fc.enabled !== false;
const resolvedNavLinks = (settings.header.navLinks || [])
  .filter((link: any) => fitCheckEnabled || link.url !== '/check')
  .map((link: any) => ({
    label: link.label,
    url:   link.url,
  }));

// ── Fit Check appearance overrides (Tina: fitCheck → Appearance) ─────────────
// Font: if set, overrides the site Global Default Font on this page only;
// blank = inherit Site Settings (computed above). Text size: a scale factor
// exposed as --vd-fs-scale and multiplied into the small .vd-* type below.
const fcAppear = fc.appearance || {};
const fcFontChoice = fcAppear.fontPreset || '';
if (fcFontChoice) {
  const fcFontName = (fcFontChoice === 'custom' && fcAppear.customFontName)
    ? fcAppear.customFontName
    : fcFontChoice;
  activeFontFamily = fontFamily(fcFontName);
}
const fcTextScale = fontScaleFactor(fcAppear.baseSize, 'base');

const categoryKeysList = ['comms', 'sales', 'docs', 'ops', 'reporting', 'content', 'several'] as const;

// Per-category follow-up question + options, built at build time so the
// client only ever needs to look up the category the visitor picked — no
// hardcoded copy, no logic embedded beyond "look up this key".
// "several" has no options of its own — it reuses the other six categories'
// buttonLabel text as its options (see tina/fitcheck-schema.ts).
type FollowupOption = { value: string; label: string };
type FollowupEntry = { question: string; options: FollowupOption[] };
const followupData: Record<string, FollowupEntry> = {};
for (const key of categoryKeysList) {
  const cat = (fc.categoryQuestion && fc.categoryQuestion[key]) || {};
  const fu = cat.followup || {};
  let options: FollowupOption[];
  if (key === 'several') {
    options = categoryKeysList
      .filter((k) => k !== 'several')
      .map((k) => ({
        value: k,
        label: (fc.categoryQuestion && fc.categoryQuestion[k]?.buttonLabel) || k,
      }));
  } else {
    options = [1, 2, 3, 4].map((n) => ({
      value: `option${n}`,
      label: fu[`option${n}`] || '',
    }));
  }
  followupData[key] = { question: fu.questionLabel || '', options };
}
---

<Layout title="VortexDeep — Quick Operations Check" theme={currentTheme} lang="en" autoFamily={autoFamily} themeToggleEnabled={themeToggleEnabled}>
  <!-- ── FIXED HEADER — mirrors SitePage.astro's header for parity with the
       rest of the site. See that file's header block if this needs to
       change; the two aren't shared as a component (this page doesn't
       route through SitePage.astro), so keep them in sync by hand. ── -->
  <header class={`vd-fixed-header ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.appearance.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);"
               class={`w-5 h-5 flex-shrink-0 ${checkAnimationsEnabled ? 'vd-logo' : ''}`}>
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class={`${fontSizeClass(settings.header.wordmarkFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.wordmarkFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.wordmarkTracking || typo.header?.tracking || 'tracking-[0.4em]'}`}
              style={textStyle('var(--zen-text)', settings.header.wordmarkFont || typo.header?.font, settings.header.wordmarkOpacity ?? typo.header?.opacity ?? 100) + ` font-family: ${settings.header.wordmarkFont || typo.header?.font ? fontFamily(settings.header.wordmarkFont || typo.header?.font) : activeFontFamily};`}>
          {settings.hero.siteName || 'VortexDeep'}
        </span>
        {checkAnimationsEnabled && (
          <span class="vd-status-dot" style="color: var(--zen-text);" aria-hidden="true"></span>
        )}
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`vd-nav-link ${fontSizeClass(settings.header.headerLinksFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.headerLinksFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.headerLinksTracking || typo.header?.tracking || 'tracking-[0.3em]'}`}
             style={`color: var(--zen-text); opacity: ${settings.header.headerLinksOpacity ?? typo.header?.opacity ?? 50}%; font-family: ${settings.header.headerLinksFont || typo.header?.font ? fontFamily(settings.header.headerLinksFont || typo.header?.font) : activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="en" slug="check" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style="color: var(--zen-text);"
                  aria-label="Switch light/dark view">
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  <!-- min-h-[100svh] avoids the iOS Safari 100vh-includes-chrome trap. Vertical
       placement is handled by `my-auto` on the inner block below, NOT by
       justify-* here: auto margins centre the content when there's room (so the
       intro and short steps sit centred like every other page), but collapse to
       0 and let content flow from the top — fully scrollable, never clipped —
       when a step is taller than the viewport (so all answer options stay
       reachable). justify-content:center would clip the top of a too-tall step;
       my-auto does not. Padding clears the fixed header/footer, both
       admin-configurable in Site Settings, and includes the iOS safe-area inset
       at the bottom so the footer never overlaps the home-indicator bar. -->
  <main class="min-h-[100svh] flex flex-col items-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); font-family: ${activeFontFamily}; padding-top: calc(${headerHeight} + 24px); padding-bottom: calc(${footerHeight} + env(safe-area-inset-bottom, 0px) + 24px);`}>
    <div class="max-w-xl w-full mx-auto my-auto" id="vd-root">
      {!fitCheckEnabled ? (
        <div class="text-center">
          <p class="vd-tag">The Fit Check</p>
          <h2 class="vd-rh">Not available right now</h2>
          <p class="vd-rb">The Fit Check is temporarily unavailable. Please check back soon, or get in touch directly.</p>
          <a href={`mailto:${contactEmail}`} class="vd-soft-link">Get in touch</a>
        </div>
      ) : (<>

      <p class="text-[10px] uppercase tracking-[0.4em] mb-8 opacity-40 text-center">
        The Fit Check
      </p>


      <div class="flex justify-center gap-3 mb-3" id="vd-progress"></div>
      <p id="vd-stepname" class="text-[10px] uppercase tracking-[0.3em] opacity-35 text-center mb-10 sm:mb-16"></p>

      <!-- Q0: Role -->
      <div class="vd-q" data-q="role">
        <p class="vd-ql">{fc.roleQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="business">{fc.roleQuestion?.businessLabel}</button>
          <button class="vd-opt" data-val="consultant">{fc.roleQuestion?.consultantLabel}</button>
          <button class="vd-opt" data-val="curious">{fc.roleQuestion?.curiousLabel}</button>
        </div>
      </div>

      <!-- Q1: Category — aligned to VortexDeep's automation categories -->
      <div class="vd-q hidden" data-q="category">
        <p class="vd-ql">{fc.categoryQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          {categoryKeysList.map((k) => (
            <button class="vd-opt" data-val={k}>{fc.categoryQuestion?.[k]?.buttonLabel}</button>
          ))}
        </div>
      </div>

      <!-- Q1b: Category follow-up — business only, built client-side from
           the per-category data embedded below. -->
      <!-- Rendered statically per category (not built with client-side JS) so
           Astro's scoped .vd-opt/.vd-ql styles actually apply — elements
           created via document.createElement never receive Astro's
           data-astro-cid scoping attribute, which was the bug here. -->
      {categoryKeysList.map((k) => (
        <div class="vd-q hidden" data-q={`followup-${k}`}>
          <p class="vd-ql">{followupData[k].question}</p>
          <div class="flex flex-col gap-1">
            {followupData[k].options.map((opt) => (
              <button class="vd-opt" data-val={opt.value}>{opt.label}</button>
            ))}
          </div>
        </div>
      ))}

      <!-- Q2: Time cost — labels from Tina (fc.timeQuestion); the data-val
           values (high/mid/low/unsure) stay hardcoded because the scoring
           keys off them. Same label-editable / value-fixed split as every
           other question. -->
      <div class="vd-q hidden" data-q="time">
        <p class="vd-ql">{fc.timeQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="high">{fc.timeQuestion?.highLabel}</button>
          <button class="vd-opt" data-val="mid">{fc.timeQuestion?.midLabel}</button>
          <button class="vd-opt" data-val="low">{fc.timeQuestion?.lowLabel}</button>
          <button class="vd-opt" data-val="unsure">{fc.timeQuestion?.unsureLabel}</button>
        </div>
      </div>

      <!-- Q3: Process ownership -->
      <div class="vd-q hidden" data-q="process">
        <p class="vd-ql">{fc.processQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="none">{fc.processQuestion?.noneLabel}</button>
          <button class="vd-opt" data-val="partial">{fc.processQuestion?.partialLabel}</button>
          <button class="vd-opt" data-val="full">{fc.processQuestion?.fullLabel}</button>
        </div>
      </div>

      <!-- Q4: Goal / intent -->
      <div class="vd-q hidden" data-q="goal">
        <p class="vd-ql">{fc.goalQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="solve">{fc.goalQuestion?.solveLabel}</button>
          <button class="vd-opt" data-val="clarity">{fc.goalQuestion?.clarityLabel}</button>
          <button class="vd-opt" data-val="explore">{fc.goalQuestion?.exploreLabel}</button>
          <button class="vd-opt" data-val="compare">{fc.goalQuestion?.compareLabel}</button>
        </div>
      </div>

      <div class="flex justify-between items-center mt-12" id="vd-nav">
        <button id="vd-back" class="text-[10px] uppercase tracking-[0.3em] opacity-40 hover:opacity-80 transition-opacity" disabled>← Back</button>
        <span id="vd-step" class="text-[10px] uppercase tracking-[0.3em] opacity-40">1 / 6</span>
      </div>

      <!-- SHORT CLOSE — role = consultant / curious skip straight here, no
           email capture, no scoring, no result content of any kind. -->
      <div id="vd-shortclose" class="hidden text-center">
        <h2 class="vd-rh">{fc.shortClose?.heading}</h2>
        <p class="vd-rb">{fc.shortClose?.body}</p>
        <a href={`mailto:${contactEmail}`} class="vd-soft-link">{fc.shortClose?.ctaLabel}</a>
        <br><button class="vd-restart mt-8">Start over</button>
      </div>

      <!-- GATE -->
      <div id="vd-gate" class="hidden text-center">
        <p class="vd-tag">One last step</p>
        <h2 class="vd-rh">Leave your email to see your result</h2>
        <p class="vd-rb">
          Your result appears right here. We keep your answers so that if there's
          a fit, we can follow up personally — no automated sequences.
        </p>
        <form id="vd-gate-form" class="flex flex-col gap-5 max-w-sm mx-auto text-left mt-8">
          <input type="hidden" name="source" value="vortexdeep.ch quick check">
          <input type="hidden" name="lang"     value="en">
          <input type="hidden" name="role"     id="gate-role">
          <input type="hidden" name="category" id="gate-category">
          <input type="hidden" name="followup" id="gate-followup">
          <input type="hidden" name="time"     id="gate-time">
          <input type="hidden" name="process"  id="gate-process">
          <input type="hidden" name="goal"     id="gate-goal">
          <input type="hidden" name="form_load_time" id="gate-load-time">
          <input type="text" name="hp_field_9x2" style="position:absolute;left:-9999px;width:1px;height:1px;" tabindex="-1" autocomplete="off" aria-hidden="true"/>
          <label class="block">
            <span class="vd-fl">Email</span>
            <input name="email" type="email" required class="vd-input" placeholder="your@email.com"/>
          </label>
          <label class="block">
            <span class="vd-fl">Name (optional)</span>
            <input name="name" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Company (optional)</span>
            <input name="company" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">One line on your situation (optional)</span>
            <textarea name="note" rows="2" class="vd-input"></textarea>
          </label>
          <div style="border:1px solid var(--zen-muted); padding:16px 20px; border-radius:4px; opacity:0.85;">
            <div class="flex items-center justify-between gap-6">
              <div>
                <span class="vd-fl" style="margin-bottom:6px;display:block;">Security check</span>
                <p class="text-[12px] uppercase tracking-[0.08em]" style="color:var(--zen-text); margin:0;">
                  Calculate: <strong id="vd-math-q" style="opacity:1;">···</strong>
                </p>
              </div>
              <input name="math_answer" type="number" required
                     class="vd-input"
                     placeholder="?"
                     style="width:64px; text-align:center; font-size:16px; border-bottom:1px solid var(--zen-text);"/>
            </div>
          </div>
          <p id="vd-gate-error" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            Incorrect answer or invalid email — please try again.
          </p>
          <p id="vd-gate-error-fallback" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            If this keeps happening, email us directly at <a href={`mailto:${contactEmail}`} class="vd-soft-link" style="text-transform:none; letter-spacing:normal;">{contactEmail}</a>.
          </p>
          <button type="submit"
                  class="mt-2 text-[10px] uppercase tracking-[0.4em] border-b pb-2 self-center hover:opacity-50 transition-opacity"
                  style="background:none;border-top:none;border-left:none;border-right:none;border-bottom:1px solid var(--zen-text);cursor:pointer;font-family:inherit;color:var(--zen-text);">
            See my result
          </button>
        </form>
      </div>

      {/* RESULT — shown on-page after a valid submission. The server returns
          only the matched result text; all scoring stays server-side and never
          reaches this page. (JSX comment — not emitted to the built HTML.) */}
      <div class="hidden text-center" id="vd-result">
        <p class="vd-tag" id="vd-result-tag">Your result</p>
        <h2 class="vd-rh" id="vd-result-tagline"></h2>
        <p class="vd-rb" id="vd-result-description"></p>
        <p class="vd-rb" id="vd-result-disclaimer" style="opacity:0.5;"></p>
        <a href={`mailto:${contactEmail}`} class="vd-soft-link" id="vd-result-cta">Let's talk it through</a>
        <br><button class="vd-restart mt-8">Start over</button>
      </div>

      </>)}
    </div>
  </main>

  <!-- ── FIXED FOOTER — mirrors SitePage.astro's footer ── -->
  <footer class={`vd-fixed-footer ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.footer.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.footer.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${fontSizeClass(settings.footer.footerTextFontSize || typo.footer?.size || 'text-[9px]')} ${settings.footer.footerTextFontWeight || typo.footer?.weight || ''} ${typo.footer?.uppercase !== false ? 'uppercase' : ''} ${settings.footer.footerTextTracking || typo.footer?.tracking || 'tracking-[0.25em]'}`}
       style={`color: var(--zen-text); opacity: ${settings.footer.footerTextOpacity ?? typo.footer?.opacity ?? 30}%; font-family: ${settings.footer.footerTextFont || typo.footer?.font ? fontFamily(settings.footer.footerTextFont || typo.footer?.font) : activeFontFamily};`}>
      {settings.footer.footerText
        ? settings.footer.footerText
        : `© ${currentYear} ${settings.hero.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global define:vars={{ activeFontFamily, fcTextScale,
    qlSize: qz.qlSize, qlWeight: qz.qlWeight, qlTracking: qz.qlTracking, qlOpacity: qz.qlOpacity, rhSize: qz.rhSize,
    optSize: qz.optSize, optTracking: qz.optTracking, tagSize: qz.tagSize, tagTracking: qz.tagTracking,
    flTracking: qz.flTracking, labelWeight: qz.labelWeight,
    rbSize: qz.rbSize, rbOpacity: qz.rbOpacity, inputSize: qz.inputSize,
    quizFont: qz.quizFont || activeFontFamily, labelFont: qz.labelFont || activeFontFamily, fcBodyFont: qz.bodyFont || activeFontFamily,
  }}>
    .vd-nav-link { transition: opacity 0.2s ease; }
    .vd-nav-link:hover { opacity: 1 !important; }
    /* ── Font parity with the rest of the site ───────────────────────────────
       Layout.astro defaults body to Inter; SitePage.astro overrides that
       globally with the configured font. The Fit Check bypasses SitePage, so
       without this rule its body-level text fell back to Inter instead of the
       admin's fontPreset (e.g. IBM Plex Mono) — the "no font settings" gap.
       Set it globally here, exactly as SitePage does, so every element (incl.
       the runtime-built quiz DOM) inherits the configured family. ── */
    html, body { font-family: var(--activeFontFamily); }

    /* ── Theme toggle button (sun/moon) — mirrors SitePage.astro so the Fit
       Check gets the same light/dark selector as the rest of the site. Click
       handling is delegated globally in Layout.astro (data-vd-theme-cycle). ── */
    .vd-theme-btn {
      position: relative;
      display: inline-flex; align-items: center; justify-content: center;
      width: 20px; height: 20px; padding: 0; border: none; background: none;
      cursor: pointer;
    }
    .vd-theme-icon {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transform: scale(0.4) rotate(-70deg);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .vd-theme-icon svg { width: 100%; height: 100%; }
    /* Auto: opposite-of-current icon, dimmed — an invitation, not a selection */
    html:not([data-theme-forced])[data-auto-family="dark"]  .vd-theme-icon-sun  { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced])[data-auto-family="light"] .vd-theme-icon-moon { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced]) .vd-theme-btn:hover .vd-theme-icon { opacity: 0.62; }
    /* Forced: selected icon, fully solid, unaffected by hover */
    html[data-theme-forced="light"] .vd-theme-icon-sun  { opacity: 1; transform: scale(1) rotate(0deg); }
    html[data-theme-forced="dark"]  .vd-theme-icon-moon { opacity: 1; transform: scale(1) rotate(0deg); }

    /* ── Fixed header / footer chrome — mirrors SitePage.astro ── */
    .vd-fixed-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
    }
    .vd-fixed-header-inner {
      width: 100%;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1rem, 4vw, 2rem);
    }
    .vd-fixed-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
      gap: 1.2rem;
    }
    .vd-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px;
      border: 1px solid currentColor;
      font-size: 8px; font-weight: 600;
      letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none;
      border-radius: 3px; opacity: 0.35;
      transition: opacity 0.25s ease;
    }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    /* ── Logo ink-draw + breathing status dot + page load-fade — same
       effects as SitePage.astro's "NEW 1" / "NEW 2" / .vd-load-fade,
       duplicated here (this page doesn't route through SitePage.astro).
       Only ever applied when checkAnimationsEnabled is true — see
       enableCheckPageAnimations in tina/config.ts, defaults off. ── */
    .vd-logo polygon,
    .vd-logo polyline,
    .vd-logo path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: vdDraw 1.3s ease forwards;
    }
    .vd-logo polyline,
    .vd-logo path { animation-delay: 0.85s; }
    .vd-logo circle {
      opacity: 0;
      animation: vdDot 0.35s ease forwards 1.25s;
    }
    @keyframes vdDraw { to { stroke-dashoffset: 0; } }
    @keyframes vdDot  { to { opacity: 1; } }

    .vd-status-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      display: inline-block; margin-left: 8px;
      animation: vdBreathe 3s ease-in-out infinite;
    }
    @keyframes vdBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1);   }
      50%      { opacity: 0.85; transform: scale(1.5); }
    }

    .vd-load-fade { animation: vdLoad 1.8s cubic-bezier(0.4,0,0.2,1) forwards; }
    @keyframes vdLoad {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0);    }
    }
  </style>

  <style>
    /* Font sizes bumped for readability — the original 9–11px uppercase type
       was hard to read (the "small letters" complaint). Raised the smallest
       elements to a comfortable floor (option text 11→13, field labels 9→11,
       tags/links 10→11) while keeping the minimalist uppercase/tracking look.
       Tune these numbers freely — they're the only readability lever here. */
    .vd-ql { font-size:calc(var(--qlSize) * var(--fcTextScale, 1)); font-weight:var(--qlWeight); letter-spacing:var(--qlTracking); opacity:calc(var(--qlOpacity, 100) * 1%); text-transform:uppercase; line-height:1.5; margin:0 0 2rem; text-align:center; font-family:var(--quizFont); }
    .vd-opt { text-align:left; font-size:calc(var(--optSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:var(--optTracking); text-transform:uppercase; padding:14px 4px; border:none; border-bottom:1px solid var(--zen-muted); background:transparent; color:var(--zen-text); opacity:0.6; cursor:pointer; font-family:var(--labelFont); transition:opacity 0.2s ease, border-color 0.2s ease; width:100%; }
    .vd-opt:hover { opacity:1; border-color:var(--zen-text); }
    .vd-opt.selected { opacity:1; border-color:var(--zen-text); font-weight:600; }
    .vd-tag { font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:var(--tagTracking); text-transform:uppercase; opacity:0.5; border-bottom:1px solid var(--zen-muted); display:inline-block; padding-bottom:6px; margin-bottom:1.5rem; font-family:var(--labelFont); }
    .vd-rh { font-size:calc(var(--rhSize) * var(--fcTextScale, 1)); font-weight:var(--qlWeight); letter-spacing:var(--qlTracking); opacity:calc(var(--qlOpacity, 100) * 1%); text-transform:uppercase; line-height:1.5; margin:0 0 1rem; font-family:var(--quizFont); }
    .vd-rb { opacity:calc(var(--rbOpacity, 65) * 1%); font-size:calc(var(--rbSize) * var(--fcTextScale, 1)); line-height:1.7; max-width:38rem; margin:0 auto 2rem; font-family:var(--fcBodyFont); }
    .vd-fl { font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:var(--flTracking); text-transform:uppercase; opacity:0.5; display:block; margin-bottom:4px; font-family:var(--labelFont); }
    .vd-input { width:100%; background:transparent; border:none; border-bottom:1px solid var(--zen-muted); color:var(--zen-text); font-family:var(--fcBodyFont); font-size:calc(var(--inputSize) * var(--fcTextScale, 1)); padding:8px 2px; resize:vertical; }
    .vd-input:focus { outline:none; border-color:var(--zen-text); }
    .vd-soft-link { font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:var(--flTracking); text-transform:uppercase; opacity:0.5; color:var(--zen-text); border-bottom:1px solid var(--zen-muted); padding-bottom:3px; text-decoration:none; font-family:var(--labelFont); }
    .vd-soft-link:hover { opacity:1; }
    .vd-restart { font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:var(--flTracking); text-transform:uppercase; opacity:0.4; background:none; border:none; cursor:pointer; font-family:var(--labelFont); color:var(--zen-text); }
    .vd-restart:hover { opacity:0.9; }
    /* Progress: the same dot motif as the background network and the process flow.
       Replaces six 1px hairlines at 0.3 opacity — present in the DOM, invisible on screen. */
    #vd-progress span { width:7px; height:7px; border-radius:50%; background:var(--zen-text); opacity:0.22; transition:opacity 0.3s ease; }
    #vd-progress span.done { opacity:0.9; }
    .hidden { display:none; }
  </style>

  <script>
    // Astro hoists this module script unconditionally regardless of the
    // {!fitCheckEnabled ? ... : ...} branch taken above, so guard here too:
    // when the master switch is off, #vd-progress was never rendered and
    // none of the element lookups below would resolve — do nothing instead
    // of throwing on the first non-null assertion.
    if (document.getElementById('vd-progress')) {
    const STEPS_BUSINESS = ['role', 'category', 'followup', 'time', 'process', 'goal'];
    const answers: Record<string, string> = {};
    let current = 'role';
    const stepHistory: string[] = [];

    const progressWrap = document.getElementById('vd-progress')!;
    const backBtn = document.getElementById('vd-back') as HTMLButtonElement;
    const stepEl  = document.getElementById('vd-step')!;
    const nav     = document.getElementById('vd-nav')!;
    const qEls    = Array.from(document.querySelectorAll<HTMLElement>('.vd-q'));

    // "followup" is a logical step (for progress/back-button purposes), but
    // there are 7 pre-rendered DOM blocks for it (one per category, each
    // statically built at build time — see the .map() above — so Astro's
    // scoped styles apply correctly, unlike client-built DOM). This maps the
    // logical step to the one that should actually be visible.
    function domKeyFor(step: string): string {
      if (step === 'followup') return `followup-${answers.category}`;
      return step;
    }

    function renderProgress() {
      progressWrap.innerHTML = '';
      progressWrap.classList.remove('hidden');
      STEPS_BUSINESS.forEach(() => progressWrap.appendChild(document.createElement('span')));
      const idx = STEPS_BUSINESS.indexOf(current);
      progressWrap.querySelectorAll('span').forEach((s, i) => s.classList.toggle('done', idx >= 0 && i <= idx));
    }

    // A bare "3 / 6" gives an index. Someone mid-questionnaire wants two other
    // things: what this step is, and how much is left.
    const STEP_NAMES: Record<string, string> = { role: 'Your role', category: 'Your area', followup: "What's driving it", time: 'The hours', process: 'Where you are today', goal: 'Your goal' };

    function renderStepChrome() {
      const idx = STEPS_BUSINESS.indexOf(current);
      const nameEl = document.getElementById('vd-stepname');
      if (nameEl) {
        nameEl.textContent = idx >= 0 ? `${idx + 1} / ${STEPS_BUSINESS.length} · ${STEP_NAMES[current] || ''}` : '';
      }
      const left = idx >= 0 ? STEPS_BUSINESS.length - idx - 1 : 0;
      stepEl.textContent = idx < 0 ? '' : (left === 0 ? 'Last question' : `${left} more`);
      backBtn.disabled = stepHistory.length === 0;
    }

    function showStep(step: string) {
      current = step;
      const domKey = domKeyFor(step);
      qEls.forEach(q => q.classList.toggle('hidden', q.dataset.q !== domKey));
      renderProgress();
      renderStepChrome();
    }

    function goTo(step: string) {
      stepHistory.push(current);
      showStep(step);
    }

    backBtn.addEventListener('click', () => {
      if (!stepHistory.length) return;
      const prev = stepHistory.pop()!;
      current = prev;
      const domKey = domKeyFor(prev);
      qEls.forEach(q => q.classList.toggle('hidden', q.dataset.q !== domKey));
      renderProgress();
      renderStepChrome();
    });

    function advance(fromStep: string) {
      if (fromStep === 'role') {
        if (answers.role === 'business') {
          goTo('category');
        } else {
          showShortClose();
        }
        return;
      }
      if (fromStep === 'category') { goTo('followup'); return; }
      if (fromStep === 'followup') { goTo('time'); return; }
      if (fromStep === 'time')     { goTo('process'); return; }
      if (fromStep === 'process')  { goTo('goal'); return; }
      if (fromStep === 'goal')     { showGate(); return; }
    }

    function selectOption(step: string, btn: HTMLButtonElement) {
      answers[step] = btn.dataset.val || '';
      const parent = btn.closest('.vd-q')!;
      parent.querySelectorAll('.vd-opt').forEach(o => o.classList.remove('selected'));
      btn.classList.add('selected');
      setTimeout(() => advance(step), 160);
    }

    // Every question — including all 7 per-category follow-up blocks — is
    // pre-rendered in the HTML, so every option button can be wired up
    // directly here; nothing is built client-side.
    qEls.forEach(q => {
      const domKey = q.dataset.q!;
      const step = domKey.startsWith('followup-') ? 'followup' : domKey;
      q.querySelectorAll<HTMLButtonElement>('.vd-opt').forEach(btn => {
        btn.addEventListener('click', () => selectOption(step, btn));
      });
    });

    function showShortClose() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');
      document.getElementById('vd-stepname')?.classList.add('hidden');
      document.getElementById('vd-shortclose')!.classList.remove('hidden');
    }

    async function showGate() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');
      document.getElementById('vd-stepname')?.classList.add('hidden');

      (document.getElementById('gate-role')     as HTMLInputElement).value = answers.role || '';
      (document.getElementById('gate-category') as HTMLInputElement).value = answers.category || '';
      (document.getElementById('gate-followup') as HTMLInputElement).value = answers.followup || '';
      (document.getElementById('gate-time')     as HTMLInputElement).value = answers.time || '';
      (document.getElementById('gate-process')  as HTMLInputElement).value = answers.process || '';
      (document.getElementById('gate-goal')     as HTMLInputElement).value = answers.goal || '';
      (document.getElementById('gate-load-time') as HTMLInputElement).value = String(Math.floor(Date.now() / 1000));

      try {
        const res = await fetch('/get-math.php');
        const data = await res.json();
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = data.question;
      } catch (_) {
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = '3 + 5';
      }
      document.getElementById('vd-gate')!.classList.remove('hidden');
    }

    document.getElementById('vd-gate-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const errorEl = document.getElementById('vd-gate-error')!;
      const fallbackEl = document.getElementById('vd-gate-error-fallback')!;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.textContent = '...'; btn.disabled = true;
      errorEl.classList.add('hidden');
      fallbackEl.classList.add('hidden');
      try {
        const res = await fetch('/send-check.php', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.status === 'ok') {
          const setTxt = (id: string, txt: string) => {
            const el = document.getElementById(id);
            if (el && txt) el.textContent = txt;
          };
          setTxt('vd-result-tag', data.resultTag);
          setTxt('vd-result-tagline', data.tagline);
          setTxt('vd-result-description', data.description);
          const disc = document.getElementById('vd-result-disclaimer')!;
          if (data.disclaimer) { disc.textContent = data.disclaimer; disc.classList.remove('hidden'); }
          else { disc.classList.add('hidden'); }
          setTxt('vd-result-cta', data.ctaLabel);
          document.getElementById('vd-gate')!.classList.add('hidden');
          document.getElementById('vd-result')!.classList.remove('hidden');
        } else {
          // Distinct, accurate messaging per failure reason — a mail-server
          // problem isn't the visitor's fault, and telling them their math
          // was wrong when it wasn't just makes them retry pointlessly.
          const messages: Record<string, string> = {
            security_check: 'Incorrect answer — please try again.',
            invalid_email:  "That email address doesn't look valid — please check it and try again.",
            mail_failed:    'Something went wrong on our end sending this — please try again, or reach out directly below.',
          };
          errorEl.textContent = messages[data.reason] || 'Something went wrong — please try again, or reach out directly below.';
          errorEl.classList.remove('hidden');
          if (data.reason === 'mail_failed' || !data.reason) {
            fallbackEl.classList.remove('hidden');
          }
          btn.textContent = 'See my result'; btn.disabled = false;
          const mathRes = await fetch('/get-math.php');
          const mathData = await mathRes.json();
          const mathEl = document.getElementById('vd-math-q');
          if (mathEl) mathEl.textContent = mathData.question;
          (form.querySelector('input[name="math_answer"]') as HTMLInputElement).value = '';
        }
      } catch (_) {
        errorEl.textContent = 'Something went wrong — please try again, or reach out directly below.';
        errorEl.classList.remove('hidden');
        fallbackEl.classList.remove('hidden');
        btn.textContent = 'See my result'; btn.disabled = false;
      }
    });

    document.querySelectorAll('.vd-restart').forEach(btn => btn.addEventListener('click', () => window.location.reload()));
    showStep('role');
    } // end fitCheckEnabled guard
  </script>
</Layout>
