---
// src/pages/check.astro  →  vortexdeep.ch/check
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Fold from '../components/Fold.astro';
import { themeColors, themeFamily, fontFamily, fontScaleFactor, socialIcon, fontSizeClass, textStyle, fontSizePx, fontWeightNumber, trackingEm } from '../utils/siteHelpers.ts';

// Pull real Site Settings so this page mimics the rest of the site's header,
// footer, and theme — same data source index.astro passes into
// SitePage.astro — instead of a hardcoded 'paper' theme and a bare text
// link. Note: settings.appearance.customBackgroundColor / settings.appearance.baseTextColor (the
// per-field colour overrides SitePage supports on top of a theme preset)
// are NOT applied here — this page uses the theme preset only, via
// Layout.astro's existing var(--zen-bg) / var(--zen-text) / var(--zen-muted)
// custom properties. Adding override support cleanly would mean redefining
// those custom properties at :root, which risks fighting Astro's
// define:vars scoping rather than a simple, safe addition — flagging as a
// known gap rather than a silent one.
const settingFiles = await Astro.glob('../content/settings/*.json');
const settings = settingFiles[0]?.default || {};
const typo = (settings.typography || {}) as any;

// Fit Check quiz content — driven by Typography → Fit Check roles when set,
// otherwise now falls through to the SAME global Title/Body roles every
// other title/body on the site reads, before finally landing on a hard
// literal. Previously quizTitle/quizBody fell straight to a hardcoded
// number when unset, skipping the global roles entirely — see the matching
// fix (and full rationale) on /data for why this changed.
// The existing fcTextScale multiplier is preserved on top, unchanged.
const roleSize     = (specific: any, fallback: any, hard: string) => specific?.size     ? fontSizePx(specific.size)          : fallback?.size     ? fontSizePx(fallback.size)          : hard;
const roleWeight   = (specific: any, fallback: any, hard: string) => specific?.weight   ? fontWeightNumber(specific.weight)  : fallback?.weight   ? fontWeightNumber(fallback.weight)  : hard;
const roleTracking = (specific: any, fallback: any, hard: string) => specific?.tracking ? trackingEm(specific.tracking)     : fallback?.tracking ? trackingEm(fallback.tracking)      : hard;
const roleOpacity  = (specific: any, fallback: any, hard: number) => specific?.opacity ?? fallback?.opacity ?? hard;
const roleFont     = (specific: any, fallback: any) => specific?.font ? fontFamily(specific.font) : fallback?.font ? fontFamily(fallback.font) : null;

const qz = {
  qlSize: roleSize(typo.quizTitle, typo.title, '15px'),
  qlWeight: roleWeight(typo.quizTitle, typo.title, '200'),
  qlTracking: roleTracking(typo.quizTitle, typo.title, '1.2em'),
  qlOpacity: roleOpacity(typo.quizTitle, typo.title, 100),
  rhSize: roleSize(typo.quizTitle, typo.title, '17px'),
  optSize: typo.label?.size ? fontSizePx(typo.label.size) : '13px',
  optTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.05em',
  tagSize: typo.label?.size ? fontSizePx(typo.label.size) : '11px',
  // The intro screen's step-preview labels — matched to the SAME defaults
  // "The Fit Check" home-page teaser uses for its own steps (a processFlow
  // block, rendered by SitePage.astro): the Label role, thin weight, 75%
  // opacity. Previously these reused the question-title styling (qlSize/
  // qlWeight/qlOpacity) instead — a heavier, title-weight treatment that
  // never matched the teaser these steps are meant to mirror.
  stepWeight: typo.label?.weight ? fontWeightNumber(typo.label.weight) : '100',
  stepOpacity: typo.label?.opacity ?? 75,
  stepTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.25em',
  tagTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.2em',
  flTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.3em',
  labelWeight: typo.label?.weight ? fontWeightNumber(typo.label.weight) : '400',
  rbSize: roleSize(typo.quizBody, typo.body, '14px'),
  rbOpacity: roleOpacity(typo.quizBody, typo.body, 65),
  inputSize: roleSize(typo.quizBody, typo.body, '14px'),
  quizFont: roleFont(typo.quizTitle, typo.title),
  labelFont: typo.label?.font ? fontFamily(typo.label.font) : null,
  bodyFont: roleFont(typo.quizBody, typo.body),
  // The intro screen's "timing" line (e.g. "Six questions | About two
  // minutes") is the closest thing this page has to a sub-title — matched
  // to that global role directly, same as processFlow blocks' own subtitle,
  // rather than the generic Label role it inherited by default before.
  subSize: typo.subTitle?.size ? fontSizePx(typo.subTitle.size) : (typo.label?.size ? fontSizePx(typo.label.size) : '11px'),
  subWeight: typo.subTitle?.weight ? fontWeightNumber(typo.subTitle.weight) : (typo.label?.weight ? fontWeightNumber(typo.label.weight) : '400'),
  subTracking: typo.subTitle?.tracking ? trackingEm(typo.subTitle.tracking) : (typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.15em'),
  subOpacity: typo.subTitle?.opacity ?? typo.label?.opacity ?? 55,
  subFont: typo.subTitle?.font ? fontFamily(typo.subTitle.font) : (typo.label?.font ? fontFamily(typo.label.font) : null),
  subTransform: (typo.subTitle?.uppercase !== false) ? 'uppercase' : 'none',
};

const currentTheme = settings.appearance.theme || 'light';
const currentYear  = new Date().getFullYear();

// Mirror SitePage.astro so the Fit Check behaves like the rest of the site:
// pass the visitor theme-toggle gate and the light/dark family classification
// into Layout. Without these, Layout's FOUC-restore script stays gated off
// (const toggleEnabled = false), so a visitor's saved light/dark choice made
// elsewhere on the site is ignored here and the page renders in the admin's
// preset theme regardless — which is why the Fit Check didn't match the site.
const themeToggleEnabled = settings.appearance.enableThemeToggle === true;
const autoFamily = themeFamily(themeColors[currentTheme]?.bg || '#ffffff');

const activeFont = (settings.appearance.fontPreset === 'custom' && settings.appearance.customFontName)
  ? settings.appearance.customFontName
  : (settings.appearance.fontPreset || 'Inter');
let activeFontFamily = fontFamily(activeFont);
const headerHeight     = settings.layout.headerHeight     || '52px';
const footerHeight     = settings.layout.footerHeight     || '44px';
const headerInnerWidth = settings.layout.headerInnerWidth || '680px';

const homeUrl = '/';

const contactEmail = settings.seo.contactEmail || 'info@vortexdeep.ch';

// Fit Check's own header animations (logo ink-draw, breathing status dot,
// page load-fade) are admin-configurable independently of the home page's
// equivalent toggles, and default OFF — this is a conversion-focused funnel
// page, and starts calm/instant by default rather than inheriting the home
// page's animate-by-default behaviour. See tina/config.ts,
// enableCheckPageAnimations.
const checkAnimationsEnabled = settings.animations.enableCheckPageAnimations === true;

// ── Fit Check content (Tina-managed) ────────────────────────────────────────
// All question/option copy below comes from src/content/fitcheck/config.json,
// registered in Tina as the "fitCheck" collection (tina/fitcheck-schema.ts).
// Every question — including Q2 "time cost" — now reads its labels from Tina.
// Only the option VALUES (data-val="high" etc.) stay hardcoded, because the
// server-side scoring keys off them; the visible labels are all CMS-editable.
const fitCheckFiles = await Astro.glob('../content/fitcheck/*.json');
const fc = fitCheckFiles[0]?.default || {};

// ── Intro-screen step connector animation ──────────────────────────────────
// Faithfully replicated from SitePage.astro's processFlow dot-pulse system
// (same defaults, same keyframe math) rather than importing it — check.astro
// doesn't share SitePage.astro's component tree, and this is the one piece
// of "The Fit Check" teaser's rendering that was still purely static here:
// the teaser's connector dots visibly pulse/travel in sequence; these didn't
// animate at all. Self-contained so it can't affect the (working, separate)
// home-page teaser it's modeled on.
const animFlow = settings.animations.processFlow?.enabled !== false;
function dotPulseKeyframes(name: string, i: number, k: number, count: number, dotsN: number, restOpacity: number, peakOpacity: number) {
  const slot = 100 / count;
  const dotSlot = slot / dotsN;
  const mid = i * slot + k * dotSlot + dotSlot * 0.5;
  const spread = dotSlot * 1.7;
  const riseStart = mid - spread / 2;
  const fallEnd = mid + spread / 2;
  const raw: [number, string][] = [
    [0, `opacity: ${restOpacity};`],
    [riseStart, `opacity: ${restOpacity};`],
    [mid, `opacity: ${peakOpacity};`],
    [fallEnd, `opacity: ${restOpacity};`],
    [100, `opacity: ${restOpacity};`],
  ];
  const stops = new Map<string, string>();
  raw.sort((a, b) => a[0] - b[0]).forEach(([pct, decl]) => {
    stops.set(`${Math.min(100, Math.max(0, pct)).toFixed(3)}%`, decl);
  });
  return `@keyframes ${name} { ${Array.from(stops.entries()).map(([pct, decl]) => `${pct} { ${decl} }`).join(' ')} }`;
}
const introStepsN = fc.introScreen?.steps?.length || 0;
const introConnectorCount = Math.max(introStepsN - 1, 0);
const introDotsN = 2;      // matches the fixed dotsPerConnector already used below
const introRelayDuration = 2 * introConnectorCount; // matches defaultFlowSpeed=2s/connector
let introRelayCss = '';
if (animFlow && introConnectorCount > 0) {
  for (let i = 0; i < introConnectorCount; i++) {
    for (let k = 0; k < introDotsN; k++) {
      introRelayCss += dotPulseKeyframes(`vdRelayDot_fcintro_${i}_${k}`, i, k, introConnectorCount, introDotsN, 0.14, 0.85) + '\n';
    }
  }
}

// Shows the new intro screen only when explicitly enabled AND actually
// filled in — an empty/unfinished draft can't accidentally go live between
// a Tina edit and someone filling in the Heading. When false, this page
// behaves exactly as it did before this screen existed: opens directly on
// "Your role".
const showIntroScreen = fc.introScreen?.showIntro !== false && !!fc.introScreen?.heading;

// Master switch (Tina: Fit Check → "Fit Check enabled"). Off = this page's
// own nav link hides itself and the quiz below is replaced by a short
// "not available" notice — see the vd-root conditional further down.
const fitCheckEnabled = fc.enabled !== false;
const resolvedNavLinks = (settings.header.navLinks || [])
  .filter((link: any) => fitCheckEnabled || link.url !== '/check')
  .map((link: any) => ({
    label: link.label,
    url:   link.url,
  }));

// ── Fit Check appearance overrides (Tina: fitCheck → Appearance) ─────────────
// Font: if set, overrides the site Global Default Font on this page only;
// blank = inherit Site Settings (computed above). Text size: a scale factor
// exposed as --vd-fs-scale and multiplied into the small .vd-* type below.
const fcAppear = fc.appearance || {};
const fcFontChoice = fcAppear.fontPreset || '';
if (fcFontChoice) {
  const fcFontName = (fcFontChoice === 'custom' && fcAppear.customFontName)
    ? fcAppear.customFontName
    : fcFontChoice;
  activeFontFamily = fontFamily(fcFontName);
}
const fcTextScale = fontScaleFactor(fcAppear.baseSize, 'base');

const categoryKeysList = ['comms', 'sales', 'docs', 'ops', 'reporting', 'content', 'several'] as const;

// Per-category follow-up question + options, built at build time so the
// client only ever needs to look up the category the visitor picked — no
// hardcoded copy, no logic embedded beyond "look up this key".
// "several" has no options of its own — it reuses the other six categories'
// buttonLabel text as its options (see tina/fitcheck-schema.ts).
type FollowupOption = { value: string; label: string };
type FollowupEntry = { question: string; options: FollowupOption[] };
const followupData: Record<string, FollowupEntry> = {};
for (const key of categoryKeysList) {
  const cat = (fc.categoryQuestion && fc.categoryQuestion[key]) || {};
  const fu = cat.followup || {};
  let options: FollowupOption[];
  if (key === 'several') {
    options = categoryKeysList
      .filter((k) => k !== 'several')
      .map((k) => ({
        value: k,
        label: (fc.categoryQuestion && fc.categoryQuestion[k]?.buttonLabel) || k,
      }));
  } else {
    options = [1, 2, 3, 4].map((n) => ({
      value: `option${n}`,
      label: fu[`option${n}`] || '',
    }));
  }
  followupData[key] = { question: fu.questionLabel || '', options };
}
---

<Layout title="VortexDeep — Quick Operations Check" theme={currentTheme} lang="en" autoFamily={autoFamily} themeToggleEnabled={themeToggleEnabled}>
  <!-- ── FIXED HEADER — mirrors SitePage.astro's header for parity with the
       rest of the site. See that file's header block if this needs to
       change; the two aren't shared as a component (this page doesn't
       route through SitePage.astro), so keep them in sync by hand. ── -->
  <header class={`vd-fixed-header ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.appearance.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);"
               class={`w-5 h-5 flex-shrink-0 ${checkAnimationsEnabled ? 'vd-logo' : ''}`}>
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class={`${fontSizeClass(settings.header.wordmarkFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.wordmarkFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.wordmarkTracking || typo.header?.tracking || 'tracking-[0.4em]'}`}
              style={textStyle('var(--zen-text)', settings.header.wordmarkFont || typo.header?.font, settings.header.wordmarkOpacity ?? typo.header?.opacity ?? 100) + ` font-family: ${settings.header.wordmarkFont || typo.header?.font ? fontFamily(settings.header.wordmarkFont || typo.header?.font) : activeFontFamily};`}>
          {settings.hero.siteName || 'VortexDeep'}
        </span>
        {checkAnimationsEnabled && (
          <span class="vd-status-dot" style="color: var(--zen-text);" aria-hidden="true"></span>
        )}
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`vd-nav-link ${fontSizeClass(settings.header.headerLinksFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.headerLinksFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.headerLinksTracking || typo.header?.tracking || 'tracking-[0.3em]'}`}
             style={`color: var(--zen-text); opacity: ${settings.header.headerLinksOpacity ?? typo.header?.opacity ?? 50}%; font-family: ${settings.header.headerLinksFont || typo.header?.font ? fontFamily(settings.header.headerLinksFont || typo.header?.font) : activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="en" slug="check" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style="color: var(--zen-text);"
                  aria-label="Switch light/dark view">
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  <!-- min-h-[100svh] avoids the iOS Safari 100vh-includes-chrome trap. Vertical
       placement is handled by `my-auto` on the inner block below, NOT by
       justify-* here: auto margins centre the content when there's room (so the
       intro and short steps sit centred like every other page), but collapse to
       0 and let content flow from the top — fully scrollable, never clipped —
       when a step is taller than the viewport (so all answer options stay
       reachable). justify-content:center would clip the top of a too-tall step;
       my-auto does not. Padding clears the fixed header/footer, both
       admin-configurable in Site Settings, and includes the iOS safe-area inset
       at the bottom so the footer never overlaps the home-indicator bar. -->
  <main class="min-h-[100svh] flex flex-col items-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); font-family: ${activeFontFamily}; padding-top: calc(${headerHeight} + 24px); padding-bottom: calc(${footerHeight} + env(safe-area-inset-bottom, 0px) + 24px);`}>
    <div class="max-w-xl w-full mx-auto my-auto" id="vd-root">
      {!fitCheckEnabled ? (
        <div class="text-center">
          <p class="vd-tag">The Fit Check</p>
          <h2 class="vd-rh">Not available right now</h2>
          <p class="vd-rb">The Fit Check is temporarily unavailable. Please check back soon, or get in touch directly.</p>
          <a href={`mailto:${contactEmail}`} class="vd-soft-link">Get in touch</a>
        </div>
      ) : (<>

      <p class="mb-8 text-center" style="font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:0.4em; text-transform:uppercase; opacity:0.4; font-family:var(--labelFont);">
        The Fit Check
      </p>

      {showIntroScreen && (
        <div id="vd-intro" class="text-center">
          <h1 class="vd-rh">{fc.introScreen.heading}</h1>
          {fc.introScreen.timing && (
            <p class="vd-fl-sub mb-3">
              {fc.introScreen.timing.split('|').map((line: string) => <>{line.trim()}<br/></>)}
            </p>
          )}

          {/* Same dot-connector diagram as the home-page teaser (processFlow,
              vertical orientation) — not a separate list style — copied here
              rather than imported since check.astro doesn't otherwise share
              SitePage.astro's component tree. Numbered per step, as asked;
              the teaser's own diagram is left exactly as it is (unnumbered),
              this only affects this one intro screen. Fold is OPT-IN via
              introScreen.foldSteps (Tina), exactly like processFlow blocks'
              own foldProcess toggle ("The Six Phases" etc.) — off by default,
              steps show straight away; on, they start behind the same
              breathing-dots cue. */}
          {fc.introScreen.steps?.length > 0 && (
            fc.introScreen.foldSteps === true ? (
              <Fold id="vd-intro-steps" cueStyle="dots" ariaClosed="Show the six steps" ariaOpen="Hide the six steps" color="var(--zen-text)">
                <div class="flex flex-col items-center gap-0 mb-2">
                  {fc.introScreen.steps.map((s: any, i: number) => (
                    <div class="flex flex-col items-center">
                      <span class="vd-step-label" style="display:flex; align-items:baseline; gap:8px; padding-top:5px; padding-bottom:5px; margin:0;">
                        <span style="opacity:0.4; font-size:0.75em;">{String(i + 1).padStart(2, '0')}</span>
                        <span>{s.label}</span>
                      </span>
                      {i < fc.introScreen.steps.length - 1 && (
                        <span class="vd-connector-v" style="color: var(--zen-text); gap: 5px;" aria-hidden="true">
                          {Array.from({ length: introDotsN }).map((_, k) => (
                            <span class="vd-relay-dot"
                                  style={`width:1px; height:1px;${animFlow ? ` animation-name: vdRelayDot_fcintro_${i}_${k}; animation-duration: ${introRelayDuration}s;` : ''}`}></span>
                          ))}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
                {fc.introScreen.note && (<p class="vd-rb mt-10">{fc.introScreen.note}</p>)}
              </Fold>
            ) : (
              <>
                <div class="flex flex-col items-center gap-0 mb-2">
                  {fc.introScreen.steps.map((s: any, i: number) => (
                    <div class="flex flex-col items-center">
                      <span class="vd-step-label" style="display:flex; align-items:baseline; gap:8px; padding-top:5px; padding-bottom:5px; margin:0;">
                        <span style="opacity:0.4; font-size:0.75em;">{String(i + 1).padStart(2, '0')}</span>
                        <span>{s.label}</span>
                      </span>
                      {i < fc.introScreen.steps.length - 1 && (
                        <span class="vd-connector-v" style="color: var(--zen-text); gap: 5px;" aria-hidden="true">
                          {Array.from({ length: introDotsN }).map((_, k) => (
                            <span class="vd-relay-dot"
                                  style={`width:1px; height:1px;${animFlow ? ` animation-name: vdRelayDot_fcintro_${i}_${k}; animation-duration: ${introRelayDuration}s;` : ''}`}></span>
                          ))}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
                {fc.introScreen.note && (<p class="vd-rb mt-10">{fc.introScreen.note}</p>)}
              </>
            )
          )}

          <div class="mt-6">
            <button id="vd-begin" class="vd-soft-link" style="background:none; border:none; border-bottom:1px solid var(--zen-muted); cursor:pointer; display:inline-block;">{fc.introScreen.beginLabel || 'Begin'}</button>
          </div>
        </div>
      )}

      <div class={`flex justify-center gap-3 mb-3 ${showIntroScreen ? 'hidden' : ''}`} id="vd-progress"></div>
      <p id="vd-stepname" class={`text-center mb-10 sm:mb-16 ${showIntroScreen ? 'hidden' : ''}`} style="font-size:calc(var(--tagSize) * var(--fcTextScale, 1)); font-weight:var(--labelWeight); letter-spacing:0.3em; text-transform:uppercase; opacity:0.35; font-family:var(--labelFont);"></p>

      <!-- Q0: Role -->
      <div class={`vd-q ${showIntroScreen ? 'hidden' : ''}`} data-q="role">
        <p class="vd-ql">{fc.roleQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="business">{fc.roleQuestion?.businessLabel}</button>
          <button class="vd-opt" data-val="consultant">{fc.roleQuestion?.consultantLabel}</button>
          <button class="vd-opt" data-val="curious">{fc.roleQuestion?.curiousLabel}</button>
        </div>
      </div>

      <!-- Q1: Category — aligned to VortexDeep's automation categories -->
      <div class="vd-q hidden" data-q="category">
        <p class="vd-ql">{fc.categoryQuestion?.questionLabel}</p>
        <div class="flex flex-col gap-1">
          {categoryKeysList.map((k) => (
            <button class="vd-opt" data-val={k}>{fc.categoryQuestion?.[k]?.buttonLabel}</button>
          ))}
        </div>
      </div>

      <!-- Q1b: Category follow-up — business only, built client-side from
           the per-category data embedded below. -->
      <!-- Rendered statically per category (not built with client-side JS) so
           Astro's scoped .vd-opt/.vd-ql styles actually apply — elements
           created via document.createElement never receive Astro's
           data-astro-cid scoping attribute, which was the bug here. -->
      {categoryKeysList.map((k) => (
        <div class="vd-q hidden" data-q={`followup-${k}`}>
          <p class="vd-ql">{followupData[k].question}</p>
          <div class="flex flex-col gap-1">
            {followupData[k].options.map((opt) => (
