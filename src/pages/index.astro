---
// src/pages/index.astro  →  vortexdeep.ch/
import SitePage from '../components/SitePage.astro';

const artFiles     = await Astro.glob('../content/art/*.json');
const pageFiles    = await Astro.glob('../content/pages/en/*.json');
const settingFiles = await Astro.glob('../content/settings/*.json');
---
<SitePage
  lang="en"
  pageData={pageFiles[0]?.default?.blocks || []}
  settings={settingFiles[0]?.default || {}}
  artFiles={artFiles}
/>
