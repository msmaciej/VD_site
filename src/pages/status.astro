---
// src/pages/status.astro  →  vortexdeep.ch/status
// Full explanation behind the "In preparation" notice-banner pill.
//
// Previous version of this page rendered SiteStatusScreen (the component
// that also backs the full-site gate) and then patched its independent
// typography from outside with CSS overrides computed to (in theory) match
// the hero. That kept drifting in practice, apparently — so this version
// takes a more direct approach: no separate component, no override, no
// recomputation of values that are supposed to match something else. The
// title, badge, body text and background below are built with the exact
// same fontSizeClass()/textStyle() calls, the exact same Typography-role
// lookups (typo.title / typo.body / typo.noticeBannerText), and the exact
// same background-muting formula that SitePage.astro's own hero uses — not
// a parallel copy of the numbers, the literal same function calls on the
// literal same settings object. If the hero ever changes, so does this.
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import DepthNetworkBackground from '../components/DepthNetworkBackground.astro';
import PlanetarySystemsBackground from '../components/PlanetarySystemsBackground.astro';
import { fontFamily, filterNavLinks, isFitCheckEnabled, fontSizeClass, textStyle, themeColors, themeFamily, socialIcon, fontSizePx, trackingEm } from '../utils/siteHelpers.ts';

const settingFiles = await Astro.glob('../content/settings/*.json');
const settings = settingFiles[0]?.default || {};
const typo = (settings.typography || {}) as any;

const currentTheme = settings.appearance.theme || 'light';

const getBgColor = () => {
  if (settings.appearance.customBackgroundColor) return settings.appearance.customBackgroundColor;
  return themeColors[currentTheme]?.bg || '#ffffff';
};
const getTextColor = (customColor?: string) => {
  const base = customColor || settings.appearance.baseTextColor;
  if (!base) return themeColors[currentTheme]?.text || '#0a0a0a';
  return base;
};
const themeToggleEnabled = settings.appearance.enableThemeToggle === true;
const autoFamily = themeFamily(getBgColor());
const zenText = 'var(--zen-text)';
const zenBg   = 'var(--zen-bg)';

const activeFont = (settings.appearance.fontPreset === 'custom' && settings.appearance.customFontName)
  ? settings.appearance.customFontName
  : (settings.appearance.fontPreset || 'Inter');
const activeFontFamily = fontFamily(activeFont);

const headerHeight     = settings.layout.headerHeight     || '52px';
const footerHeight     = settings.layout.footerHeight     || '44px';
const headerInnerWidth = settings.layout.headerInnerWidth || '680px';
const currentYear      = new Date().getFullYear();

const homeUrl = '/';
const fitCheckFiles = await Astro.glob('../content/fitcheck/*.json');
const fitCheckEnabled = isFitCheckEnabled(fitCheckFiles[0]?.default);
const resolvedNavLinks = filterNavLinks(settings.header.navLinks, fitCheckEnabled).map((link: any) => ({
  label: link.label,
  url:   link.url,
}));

// ── Background: identical formula to SitePage.astro's hero (not a copy of
// its output, the same color-mix() calculation on the same settings) ──────
const backgroundStyle = settings.animations.backgroundStyle || 'none';
const animDepthBg   = backgroundStyle === 'depth';
const animPlanetary = backgroundStyle === 'planetary';
const anyFixedBackground = animDepthBg || animPlanetary;
const headerFooterBg = anyFixedBackground
  ? `background-color: color-mix(in srgb, ${zenBg} 70%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);`
  : `background-color: ${zenBg};`;
const contentWrapperBg = anyFixedBackground
  ? `background-color: color-mix(in srgb, ${zenBg} 82%, transparent); position: relative; z-index: 1;`
  : `background-color: ${zenBg};`;

// ── Badge: the exact "pill" notice-banner values (this badge IS that pill,
// just standing alone on its own page instead of sitting atop the hero) ───
const noticeTextSize     = fontSizePx(settings.noticeBanner?.noticeBannerTextFontSize || typo.noticeBannerText?.size, 'xs');
const noticeTextWeight   = settings.noticeBanner?.noticeBannerTextFontWeight || typo.noticeBannerText?.weight || '400';
const noticeTextFont     = settings.noticeBanner?.noticeBannerFont || typo.noticeBannerText?.font;
const noticeTextOpacity  = settings.noticeBanner?.noticeBannerOpacity ?? typo.noticeBannerText?.opacity;
const noticeTextTracking = trackingEm(settings.noticeBanner?.noticeBannerTracking || typo.noticeBannerText?.tracking);
const noticeDot          = settings.noticeBanner?.noticeBannerDot || 'static';

// ── Status copy: Tina override (Site Settings → Site status — custom
// wording) if filled in, else the same bilingual defaults the full-site gate
// uses — kept here rather than importing SiteStatusScreen just for its
// constants, since this page no longer renders that component. ───────────
const sc: any = settings.siteStatusContent || {};
const badgeDe = sc.preparationBadge_de   || 'In Vorbereitung';
const badgeEn = sc.preparationBadge_en   || 'In preparation';
const msgDe   = sc.preparationMessage_de || 'VortexDeep befindet sich derzeit in Vorbereitung und ist noch nicht kommerziell am Markt tätig. Es bestehen keine Kundenaufträge, keine laufenden Projekte, keine Rechnungsstellung und keine Einnahmen.';
const msgEn   = sc.preparationMessage_en || 'VortexDeep is currently in preparation and is not yet commercially active. There are no customer orders, no ongoing projects, no invoicing, and no revenue.';
const updated = new Date().toLocaleDateString('de-CH', { year: 'numeric', month: 'long' });

const title = 'In preparation — VortexDeep';
const description = 'VortexDeep is currently in preparation and is not yet commercially active.';
---

<Layout title={title} description={description} ogImage={settings.seo.ogImage || ''} siteUrl={settings.seo.siteUrl || 'https://vortexdeep.ch'} theme={currentTheme} lang="en"
        autoBg={getBgColor()} autoText={getTextColor()} autoFamily={autoFamily} themeToggleEnabled={themeToggleEnabled} noindex={true}>
  <header class="vd-fixed-header" style={headerFooterBg}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth}; color: var(--zen-text);`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.appearance.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);" class="w-5 h-5 flex-shrink-0">
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class={`${fontSizeClass(settings.header.wordmarkFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.wordmarkFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.wordmarkTracking || typo.header?.tracking || 'tracking-[0.4em]'}`}
              style={textStyle('var(--zen-text)', settings.header.wordmarkFont || typo.header?.font, settings.header.wordmarkOpacity ?? typo.header?.opacity ?? 100) + ` font-family: ${settings.header.wordmarkFont || typo.header?.font ? fontFamily(settings.header.wordmarkFont || typo.header?.font) : activeFontFamily};`}>
          {settings.hero.siteName || 'VortexDeep'}
        </span>
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`vd-nav-link ${fontSizeClass(settings.header.headerLinksFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.headerLinksFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.headerLinksTracking || typo.header?.tracking || 'tracking-[0.3em]'}`}
             style={`color: var(--zen-text); opacity: ${settings.header.headerLinksOpacity ?? typo.header?.opacity ?? 50}%; font-family: ${settings.header.headerLinksFont || typo.header?.font ? fontFamily(settings.header.headerLinksFont || typo.header?.font) : activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="en" slug="status" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style="color: var(--zen-text);"
                  aria-label="Switch light/dark view">
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  {animDepthBg && (
    <DepthNetworkBackground
      nodeColor={settings.animations.depthBackground?.nodeColor || getTextColor()}
      fogColor={settings.animations.depthBackground?.fogColor || getBgColor()}
      nodeCount={settings.animations.depthBackground?.nodeCount || undefined}
      connectDistance={settings.animations.depthBackground?.connectDistance || undefined}
      lineOpacity={settings.animations.depthBackground?.lineOpacity ?? undefined}
      nodeOpacity={settings.animations.depthBackground?.nodeOpacity ?? undefined}
      lightNodeColor={themeColors.light.text}
      lightFogColor={themeColors.light.bg}
      darkNodeColor={themeColors.dark.text}
      darkFogColor={themeColors.dark.bg}
    />
  )}
  {animPlanetary && (
    <PlanetarySystemsBackground
      starColor={settings.animations.planetarySystems?.starColor || getTextColor()}
      fogColor={settings.animations.depthBackground?.fogColor || getBgColor()}
      systemCount={settings.animations.planetarySystems?.systemCount ?? undefined}
      maxPlanets={settings.animations.planetarySystems?.maxPlanets ?? undefined}
      orbitMinRadius={settings.animations.planetarySystems?.orbitMinRadius ?? undefined}
      orbitMaxRadius={settings.animations.planetarySystems?.orbitMaxRadius ?? undefined}
      pathOpacity={settings.animations.planetarySystems?.pathOpacity ?? undefined}
      lightStarColor={themeColors.light.text}
      lightFogColor={themeColors.light.bg}
      darkStarColor={themeColors.dark.text}
      darkFogColor={themeColors.dark.bg}
    />
  )}

  <div style={contentWrapperBg}>
    <main class="min-h-[100svh] flex flex-col items-center justify-center px-6 text-center"
          style={`padding-top: calc(${headerHeight} + 40px); padding-bottom: calc(${footerHeight} + env(safe-area-inset-bottom, 0px) + 40px);`}>
      <div class="w-full max-w-xl">

        {/* Brand line — the literal hero h1 JSX from SitePage.astro. */}
        <h1 class={`${fontSizeClass(settings.hero.siteNameFontSize || typo.title?.size || 'text-3xl md:text-4xl')} ${settings.hero.siteNameFontWeight || typo.title?.weight || 'font-thin'} text-center ${settings.hero.siteNameTracking || typo.title?.tracking || 'tracking-[0.5em]'} ${typo.title?.uppercase !== false ? 'uppercase' : ''} leading-none translate-x-[0.25em] mb-8`}
            style={textStyle(zenText, settings.hero.siteNameFont || typo.title?.font, settings.hero.siteNameOpacity ?? typo.title?.opacity ?? 100)}>
          {settings.hero.siteName || 'VortexDeep'}
        </h1>

        {/* Badge — the literal 'pill' notice-banner JSX, as a static (non-link)
            span since we're already on the page it would otherwise link to. */}
        <span style={`display:inline-flex; align-items:center; gap:9px; padding:6px 15px; border:1px solid var(--zen-muted); border-radius:999px; color:var(--zen-muted); font-size:${noticeTextSize}; font-weight:${noticeTextWeight}; letter-spacing:${noticeTextTracking || '0.16em'}; text-transform:${typo.noticeBannerText?.uppercase !== false ? 'uppercase' : 'none'}; font-family:${fontFamily(noticeTextFont || activeFont)}; opacity:${noticeTextOpacity ?? 100}%; margin-bottom: 30px;`}>
          {noticeDot !== 'none' && (<span aria-hidden="true" class={`vd-notice-dot ${noticeDot === 'animated' ? 'vd-notice-dot--pulse' : ''}`}></span>)}{badgeDe} · {badgeEn}
        </span>

        {/* Body — the literal section-body paragraph pattern (typo.body),
            same as any other section's `content` field on the home page. */}
        <p class={`${fontSizeClass(typo.body?.size || 'text-[15.5px]')} ${typo.body?.weight || 'font-normal'} leading-relaxed max-w-md mx-auto`}
           style={`${(typo.body?.font) ? `font-family: ${fontFamily(typo.body.font)};` : ''} color: ${zenText}; opacity: ${typo.body?.opacity ?? 100}%; margin-top: 30px;`} lang="de">
          {msgDe}
        </p>
        <div style="width: 40px; height: 1px; margin: 22px auto; background: var(--zen-muted); opacity: 0.5;" aria-hidden="true"></div>
        <p class={`${fontSizeClass(typo.body?.size || 'text-[15.5px]')} ${typo.body?.weight || 'font-normal'} leading-relaxed max-w-md mx-auto`}
           style={`${(typo.body?.font) ? `font-family: ${fontFamily(typo.body.font)};` : ''} color: var(--zen-muted); opacity: 90%;`} lang="en">
          {msgEn}
        </p>

        <p class={`${fontSizeClass(typo.label?.size || 'text-[11px]')} tracking-[0.08em]`}
           style={`color: var(--zen-muted); opacity: ${typo.label?.opacity ?? 80}%; margin-top: 34px; ${typo.label?.font ? `font-family: ${fontFamily(typo.label.font)};` : ''}`}>
          Stand · Last updated: {updated}
        </p>

      </div>
    </main>
  </div>

  <footer class="vd-fixed-footer"
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.footer.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`} title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.footer.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${fontSizeClass(settings.footer.footerTextFontSize || typo.footer?.size || 'text-[9px]')} ${settings.footer.footerTextFontWeight || typo.footer?.weight || ''} ${typo.footer?.uppercase !== false ? 'uppercase' : ''} ${settings.footer.footerTextTracking || typo.footer?.tracking || 'tracking-[0.25em]'}`}
       style={`color: var(--zen-text); opacity: ${settings.footer.footerTextOpacity ?? typo.footer?.opacity ?? 30}%; font-family: ${settings.footer.footerTextFont || typo.footer?.font ? fontFamily(settings.footer.footerTextFont || typo.footer?.font) : activeFontFamily};`}>
      {settings.footer.footerText ? settings.footer.footerText : `© ${currentYear} ${settings.hero.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global>
    .vd-nav-link { transition: opacity 0.2s ease; }
    .vd-nav-link:hover { opacity: 1 !important; }
    .vd-fixed-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: center; }
    .vd-fixed-header-inner { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(1rem, 4vw, 2rem); }
    .vd-fixed-footer { position: fixed; bottom: 0; left: 0; right: 0; padding-bottom: env(safe-area-inset-bottom, 0px); z-index: 50; display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
    .vd-icon { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border: 1px solid currentColor; font-size: 8px; font-weight: 600; letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none; border-radius: 3px; opacity: 0.35; transition: opacity 0.25s ease; }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }
    .vd-notice-dot { width:7px; height:7px; border-radius:50%; background:var(--zen-accent); box-shadow:0 0 11px 1px var(--zen-accent); flex:none; display:inline-block; }
    .vd-notice-dot--pulse { animation: vdNoticePulse 3s ease-in-out infinite; }
    @keyframes vdNoticePulse { 0%,100%{ opacity:1; box-shadow:0 0 11px 1px var(--zen-accent); } 50%{ opacity:0.45; box-shadow:0 0 4px 0 var(--zen-accent); } }
    @media (prefers-reduced-motion: reduce){ .vd-notice-dot--pulse{ animation:none; } }

    .vd-theme-btn {
      position: relative;
      display: inline-flex; align-items: center; justify-content: center;
      width: 20px; height: 20px; padding: 0; border: none; background: none;
      cursor: pointer;
    }
    .vd-theme-icon {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transform: scale(0.4) rotate(-70deg);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .vd-theme-icon svg { width: 100%; height: 100%; }
    html:not([data-theme-forced])[data-auto-family="dark"]  .vd-theme-icon-sun  { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced])[data-auto-family="light"] .vd-theme-icon-moon { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced]) .vd-theme-btn:hover .vd-theme-icon { opacity: 0.62; }
    html[data-theme-forced="light"] .vd-theme-icon-sun  { opacity: 1; transform: scale(1) rotate(0deg); }
    html[data-theme-forced="dark"]  .vd-theme-icon-moon { opacity: 1; transform: scale(1) rotate(0deg); }
  </style>
</Layout>
