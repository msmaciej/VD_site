---
// src/pages/de/check.astro  →  vortexdeep.ch/de/check
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { themeColors, fontFamily, socialIcon } from '../../utils/siteHelpers.ts';

// Pull real Site Settings so this page mimics the rest of the site's header,
// footer, and theme — same data source de/index.astro passes into
// SitePage.astro — instead of a hardcoded 'paper' theme and a bare text
// link. Note: settings.customBackgroundColor / settings.baseTextColor (the
// per-field colour overrides SitePage supports on top of a theme preset)
// are NOT applied here — this page uses the theme preset only, via
// Layout.astro's existing var(--zen-bg) / var(--zen-text) / var(--zen-muted)
// custom properties. Adding override support cleanly would mean redefining
// those custom properties at :root, which risks fighting Astro's
// define:vars scoping rather than a simple, safe addition — flagging as a
// known gap rather than a silent one.
const settingFiles = await Astro.glob('../../content/settings/*.json');
const settings = settingFiles[0]?.default || {};

const currentTheme = settings.theme || 'light';
const currentYear  = new Date().getFullYear();

const activeFont = (settings.fontPreset === 'custom' && settings.customFontName)
  ? settings.customFontName
  : (settings.fontPreset || 'Inter');
const activeFontFamily = fontFamily(activeFont);

const headerHeight     = settings.headerHeight     || '52px';
const footerHeight     = settings.footerHeight     || '44px';
const headerInnerWidth = settings.headerInnerWidth || '680px';

const homeUrl = '/de/';
const resolvedNavLinks = (settings.navLinks || []).map((link: any) => ({
  label: link.label_de || link.label,
  url:   `/de${link.url}`,
}));

const contactEmail = settings.contactEmail || 'info@vortexdeep.ch';

// Fit Check's own header animations (logo ink-draw, breathing status dot,
// page load-fade) are admin-configurable independently of the home page's
// equivalent toggles, and default OFF — this is a conversion-focused funnel
// page, and starts calm/instant by default rather than inheriting the home
// page's animate-by-default behaviour. See tina/config.ts,
// enableCheckPageAnimations.
const checkAnimationsEnabled = settings.enableCheckPageAnimations === true;

// ── Fit Check content (Tina-managed) ────────────────────────────────────────
// All question/option copy below comes from src/content/fitcheck/config.json
// (the _de suffixed fields), registered in Tina as the "fitCheck" collection
// (tina/fitcheck-schema.ts). Only the Q2 "time cost" question has no Tina
// field (out of scope for the content model) and stays hardcoded, same as
// before.
const fitCheckFiles = await Astro.glob('../../content/fitcheck/*.json');
const fc = fitCheckFiles[0]?.default || {};

const categoryKeysList = ['comms', 'sales', 'docs', 'ops', 'reporting', 'content', 'several'] as const;

// Per-category follow-up question + options (DE), built at build time.
// "several" has no options of its own — it reuses the other six categories'
// buttonLabel_de text as its options (see tina/fitcheck-schema.ts).
type FollowupOption = { value: string; label: string };
type FollowupEntry = { question: string; options: FollowupOption[] };
const followupData: Record<string, FollowupEntry> = {};
for (const key of categoryKeysList) {
  const cat = (fc.categoryQuestion && fc.categoryQuestion[key]) || {};
  const fu = cat.followup || {};
  let options: FollowupOption[];
  if (key === 'several') {
    options = categoryKeysList
      .filter((k) => k !== 'several')
      .map((k) => ({
        value: k,
        label: (fc.categoryQuestion && (fc.categoryQuestion[k]?.buttonLabel_de || fc.categoryQuestion[k]?.buttonLabel)) || k,
      }));
  } else {
    options = [1, 2, 3, 4].map((n) => ({
      value: `option${n}`,
      label: fu[`option${n}_de`] || fu[`option${n}`] || '',
    }));
  }
  followupData[key] = { question: fu.questionLabel_de || fu.questionLabel || '', options };
}
---

<Layout title="VortexDeep — Schnell-Check" theme={currentTheme} lang="de">
  <!-- ── FIXED HEADER — mirrors SitePage.astro's header for parity with the
       rest of the site. See that file's header block if this needs to
       change; the two aren't shared as a component (this page doesn't
       route through SitePage.astro), so keep them in sync by hand. ── -->
  <header class={`vd-fixed-header ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);"
               class={`w-5 h-5 flex-shrink-0 ${checkAnimationsEnabled ? 'vd-logo' : ''}`}>
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class="text-[10px] uppercase tracking-[0.4em]"
              style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
          {settings.siteName || 'VortexDeep'}
        </span>
        {checkAnimationsEnabled && (
          <span class="vd-status-dot" style="color: var(--zen-text);" aria-hidden="true"></span>
        )}
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`${settings.headerLinksFontSize || 'text-[10px]'} uppercase tracking-[0.3em] opacity-50 hover:opacity-100 transition-opacity`}
             style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="de" slug="check" />
      </nav>
    </div>
  </header>

  <main class="min-h-[100svh] flex flex-col items-center justify-start sm:justify-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); font-family: ${activeFontFamily}; padding-top: calc(${headerHeight} + 24px); padding-bottom: calc(${footerHeight} + 24px);`}>
    <div class="max-w-xl w-full mx-auto" id="vd-root">

      <p class="text-[10px] uppercase tracking-[0.4em] mb-8 opacity-40 text-center">
        Der Fit-Check
      </p>


      <div class="flex justify-center gap-3 mb-3" id="vd-progress"></div>
      <p id="vd-stepname" class="text-[10px] uppercase tracking-[0.3em] opacity-35 text-center mb-10 sm:mb-16"></p>

      <!-- F0: Rolle -->
      <div class="vd-q" data-q="role">
        <p class="vd-ql">{fc.roleQuestion?.questionLabel_de}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="business">{fc.roleQuestion?.businessLabel_de}</button>
          <button class="vd-opt" data-val="consultant">{fc.roleQuestion?.consultantLabel_de}</button>
          <button class="vd-opt" data-val="curious">{fc.roleQuestion?.curiousLabel_de}</button>
        </div>
      </div>

      <!-- F1: Bereich — abgestimmt auf die Automatisierungskategorien -->
      <div class="vd-q hidden" data-q="category">
        <p class="vd-ql">{fc.categoryQuestion?.questionLabel_de}</p>
        <div class="flex flex-col gap-1">
          {categoryKeysList.map((k) => (
            <button class="vd-opt" data-val={k}>{fc.categoryQuestion?.[k]?.buttonLabel_de}</button>
          ))}
        </div>
      </div>

      <!-- F1b: Kategorie-Folgefrage — nur für "Geschäftsführer/Inhaber",
           clientseitig aus den unten eingebetteten Daten gebaut. -->
      <!-- Statisch pro Kategorie gerendert (nicht per Client-JS gebaut), damit
           Astros gescopte .vd-opt/.vd-ql-Styles tatsächlich greifen — per
           document.createElement erzeugte Elemente erhalten Astros
           data-astro-cid-Attribut nie, das war der Bug hier. -->
      {categoryKeysList.map((k) => (
        <div class="vd-q hidden" data-q={`followup-${k}`}>
          <p class="vd-ql">{followupData[k].question}</p>
          <div class="flex flex-col gap-1">
            {followupData[k].options.map((opt) => (
              <button class="vd-opt" data-val={opt.value}>{opt.label}</button>
            ))}
          </div>
        </div>
      ))}

      <!-- F2: Zeitaufwand — nicht Teil des Fit-Check-Contentmodells, bleibt statisch -->
      <div class="vd-q hidden" data-q="time">
        <p class="vd-ql">Wie viele Stunden pro Woche bindet das in etwa?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="high">Mehr als 5 Stunden</button>
          <button class="vd-opt" data-val="mid">1 bis 5 Stunden</button>
          <button class="vd-opt" data-val="low">Weniger als eine Stunde</button>
          <button class="vd-opt" data-val="unsure">Schwer zu sagen – es verteilt sich quer durchs Team</button>
        </div>
      </div>

      <!-- F3: Prozessklarheit -->
      <div class="vd-q hidden" data-q="process">
        <p class="vd-ql">{fc.processQuestion?.questionLabel_de}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="none">{fc.processQuestion?.noneLabel_de}</button>
          <button class="vd-opt" data-val="partial">{fc.processQuestion?.partialLabel_de}</button>
          <button class="vd-opt" data-val="full">{fc.processQuestion?.fullLabel_de}</button>
        </div>
      </div>

      <!-- F4: Ziel -->
      <div class="vd-q hidden" data-q="goal">
        <p class="vd-ql">{fc.goalQuestion?.questionLabel_de}</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="solve">{fc.goalQuestion?.solveLabel_de}</button>
          <button class="vd-opt" data-val="clarity">{fc.goalQuestion?.clarityLabel_de}</button>
          <button class="vd-opt" data-val="explore">{fc.goalQuestion?.exploreLabel_de}</button>
          <button class="vd-opt" data-val="compare">{fc.goalQuestion?.compareLabel_de}</button>
        </div>
      </div>

      <div class="flex justify-between items-center mt-12" id="vd-nav">
        <button id="vd-back" class="text-[10px] uppercase tracking-[0.3em] opacity-40 hover:opacity-80 transition-opacity" disabled>← Zurück</button>
        <span id="vd-step" class="text-[10px] uppercase tracking-[0.3em] opacity-40">1 / 6</span>
      </div>

      <!-- KURZSCHLUSS — Rolle = Berater/Neugierig springen direkt hierher,
           keine E-Mail-Abfrage, keine Auswertung, kein Ergebnisinhalt. -->
      <div id="vd-shortclose" class="hidden text-center">
        <h2 class="vd-rh">{fc.shortClose?.heading_de}</h2>
        <p class="vd-rb">{fc.shortClose?.body_de}</p>
        <a href={`mailto:${contactEmail}`} class="vd-soft-link">{fc.shortClose?.ctaLabel_de}</a>
        <br><button class="vd-restart mt-8">Nochmals starten</button>
      </div>

      <!-- GATE -->
      <div id="vd-gate" class="hidden text-center">
        <p class="vd-tag">Noch ein Schritt</p>
        <h2 class="vd-rh">Ihre E-Mail genügt – dann sehen Sie Ihr Ergebnis.</h2>
        <p class="vd-rb">
          Wir zeigen Ihnen, wo Sie stehen, und melden uns persönlich bei Ihnen,
          wenn es passt. Keine automatisierten E-Mails.
        </p>
        <form id="vd-gate-form" class="flex flex-col gap-5 max-w-sm mx-auto text-left mt-8">
          <input type="hidden" name="source" value="vortexdeep.ch/de schnell-check">
          <input type="hidden" name="lang"     value="de">
          <input type="hidden" name="role"     id="gate-role">
          <input type="hidden" name="category" id="gate-category">
          <input type="hidden" name="followup" id="gate-followup">
          <input type="hidden" name="time"     id="gate-time">
          <input type="hidden" name="process"  id="gate-process">
          <input type="hidden" name="goal"     id="gate-goal">
          <input type="hidden" name="form_load_time" id="gate-load-time">
          <input type="text" name="hp_field_9x2" style="position:absolute;left:-9999px;width:1px;height:1px;" tabindex="-1" autocomplete="off" aria-hidden="true"/>
          <label class="block">
            <span class="vd-fl">E-Mail</span>
            <input name="email" type="email" required class="vd-input" placeholder="ihre@email.com"/>
          </label>
          <label class="block">
            <span class="vd-fl">Name (optional)</span>
            <input name="name" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Unternehmen (optional)</span>
            <input name="company" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Kurze Situationsbeschreibung (optional)</span>
            <textarea name="note" rows="2" class="vd-input"></textarea>
          </label>
          <div style="border:1px solid var(--zen-muted); padding:16px 20px; border-radius:4px; opacity:0.85;">
            <div class="flex items-center justify-between gap-6">
              <div>
                <span class="vd-fl" style="margin-bottom:6px;display:block;">Sicherheitsfrage</span>
                <p class="text-[12px] uppercase tracking-[0.08em]" style="color:var(--zen-text); margin:0;">
                  Berechnen: <strong id="vd-math-q" style="opacity:1;">···</strong>
                </p>
              </div>
              <input name="math_answer" type="number" required
                     class="vd-input"
                     placeholder="?"
                     style="width:64px; text-align:center; font-size:16px; border-bottom:1px solid var(--zen-text);"/>
            </div>
          </div>
          <p id="vd-gate-error" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            Falsche Antwort oder ungültige E-Mail – bitte nochmal versuchen.
          </p>
          <p id="vd-gate-error-fallback" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            Falls das weiterhin passiert, schreiben Sie uns direkt an <a href={`mailto:${contactEmail}`} class="vd-soft-link" style="text-transform:none; letter-spacing:normal;">{contactEmail}</a>.
          </p>
          <button type="submit"
                  class="mt-2 text-[10px] uppercase tracking-[0.4em] border-b pb-2 self-center hover:opacity-50 transition-opacity"
                  style="background:none;border-top:none;border-left:none;border-right:none;border-bottom:1px solid var(--zen-text);cursor:pointer;font-family:inherit;color:var(--zen-text);">
            Mein Ergebnis sehen
          </button>
        </form>
      </div>

      <!-- Ergebnis: wird nach dem Absenden aus der Server-Antwort befüllt.
           Kein Profilname/Label wird hier angezeigt oder übertragen — nur
           Tagline und Beschreibung für das eigene Ergebnis. -->
      <div class="vd-result hidden text-center" id="vd-result">
        <p class="vd-tag">Ihr Ergebnis</p>
        <h2 class="vd-rh" id="vd-result-tagline"></h2>
        <p class="vd-rb" id="vd-result-description"></p>
        <p class="vd-rb" id="vd-result-disclaimer" style="opacity:0.5; font-style:normal;">{fc.resultShared?.disclaimer_de}</p>
        <a href={`mailto:${contactEmail}`} class="vd-soft-link" id="vd-result-cta">{fc.resultShared?.ctaLabel_de}</a>
        <br><button class="vd-restart mt-8">Nochmals starten</button>
      </div>

    </div>
  </main>

  <!-- ── FIXED FOOTER — mirrors SitePage.astro's footer ── -->
  <footer class={`vd-fixed-footer ${checkAnimationsEnabled ? 'vd-load-fade' : ''}`}
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${settings.footerTextFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30`}
       style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
      {settings.footerText
        ? settings.footerText
        : `© ${currentYear} ${settings.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global>
    /* ── Fixed header / footer chrome — mirrors SitePage.astro ── */
    .vd-fixed-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
    }
    .vd-fixed-header-inner {
      width: 100%;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 clamp(1rem, 4vw, 2rem);
    }
    .vd-fixed-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
      gap: 1.2rem;
    }
    .vd-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px;
      border: 1px solid currentColor;
      font-size: 8px; font-weight: 600;
      letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none;
      border-radius: 3px; opacity: 0.35;
      transition: opacity 0.25s ease;
    }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    .vd-logo polygon,
    .vd-logo polyline,
    .vd-logo path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: vdDraw 1.3s ease forwards;
    }
    .vd-logo polyline,
    .vd-logo path { animation-delay: 0.85s; }
    .vd-logo circle {
      opacity: 0;
      animation: vdDot 0.35s ease forwards 1.25s;
    }
    @keyframes vdDraw { to { stroke-dashoffset: 0; } }
    @keyframes vdDot  { to { opacity: 1; } }

    .vd-status-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      display: inline-block; margin-left: 8px;
      animation: vdBreathe 3s ease-in-out infinite;
    }
    @keyframes vdBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1);   }
      50%      { opacity: 0.85; transform: scale(1.5); }
    }

    .vd-load-fade { animation: vdLoad 1.8s cubic-bezier(0.4,0,0.2,1) forwards; }
    @keyframes vdLoad {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0);    }
    }
  </style>

  <style>
    .vd-ql { font-size:14px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 2rem; text-align:center; }
    .vd-opt { text-align:left; font-size:11px; letter-spacing:0.05em; text-transform:uppercase; padding:14px 4px; border:none; border-bottom:1px solid var(--zen-muted); background:transparent; color:var(--zen-text); opacity:0.6; cursor:pointer; font-family:inherit; transition:opacity 0.2s ease, border-color 0.2s ease; width:100%; }
    .vd-opt:hover { opacity:1; border-color:var(--zen-text); }
    .vd-opt.selected { opacity:1; border-color:var(--zen-text); font-weight:600; }
    .vd-tag { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; opacity:0.5; border-bottom:1px solid var(--zen-muted); display:inline-block; padding-bottom:6px; margin-bottom:1.5rem; }
    .vd-rh { font-size:16px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 1rem; }
    .vd-rb { opacity:0.65; font-size:13px; line-height:1.7; max-width:38rem; margin:0 auto 2rem; }
    .vd-fl { font-size:9px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; display:block; margin-bottom:4px; }
    .vd-input { width:100%; background:transparent; border:none; border-bottom:1px solid var(--zen-muted); color:var(--zen-text); font-family:inherit; font-size:13px; padding:8px 2px; resize:vertical; }
    .vd-input:focus { outline:none; border-color:var(--zen-text); }
    .vd-soft-link { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; color:var(--zen-text); border-bottom:1px solid var(--zen-muted); padding-bottom:3px; text-decoration:none; }
    .vd-soft-link:hover { opacity:1; }
    .vd-restart { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.4; background:none; border:none; cursor:pointer; font-family:inherit; color:var(--zen-text); }
    .vd-restart:hover { opacity:0.9; }
    /* Progress: the same dot motif as the background network and the process flow.
       Replaces six 1px hairlines at 0.3 opacity — present in the DOM, invisible on screen. */
    #vd-progress span { width:7px; height:7px; border-radius:50%; background:var(--zen-text); opacity:0.22; transition:opacity 0.3s ease; }
    #vd-progress span.done { opacity:0.9; }
    .hidden { display:none; }
  </style>

  <script>
    const STEPS_BUSINESS = ['role', 'category', 'followup', 'time', 'process', 'goal'];
    const answers: Record<string, string> = {};
    let current = 'role';
    const stepHistory: string[] = [];

    const progressWrap = document.getElementById('vd-progress')!;
    const backBtn = document.getElementById('vd-back') as HTMLButtonElement;
    const stepEl  = document.getElementById('vd-step')!;
    const nav     = document.getElementById('vd-nav')!;
    const qEls    = Array.from(document.querySelectorAll<HTMLElement>('.vd-q'));

    // "followup" ist ein logischer Schritt (für Fortschritt/Zurück-Button),
    // hat aber 7 vorgerenderte DOM-Blöcke (einer pro Kategorie, statisch zur
    // Build-Zeit erzeugt — siehe .map() oben —, damit Astros gescopte Styles
    // greifen, anders als bei client-seitig gebautem DOM). Diese Funktion
    // bildet den logischen Schritt auf den tatsächlich sichtbaren ab.
    function domKeyFor(step: string): string {
      if (step === 'followup') return `followup-${answers.category}`;
      return step;
    }

    function renderProgress() {
      progressWrap.innerHTML = '';
      progressWrap.classList.remove('hidden');
      STEPS_BUSINESS.forEach(() => progressWrap.appendChild(document.createElement('span')));
      const idx = STEPS_BUSINESS.indexOf(current);
      progressWrap.querySelectorAll('span').forEach((s, i) => s.classList.toggle('done', idx >= 0 && i <= idx));
    }

    // A bare "3 / 6" gives an index. Someone mid-questionnaire wants two other
    // things: what this step is, and how much is left.
    const STEP_NAMES: Record<string, string> = { role: 'Ihre Rolle', category: 'Ihr Bereich', followup: 'Die Ursache', time: 'Der Aufwand', process: 'Ihr Stand heute', goal: 'Ihr Ziel' };

    function renderStepChrome() {
      const idx = STEPS_BUSINESS.indexOf(current);
      const nameEl = document.getElementById('vd-stepname');
      if (nameEl) {
        nameEl.textContent = idx >= 0 ? `${idx + 1} / ${STEPS_BUSINESS.length} · ${STEP_NAMES[current] || ''}` : '';
      }
      const left = idx >= 0 ? STEPS_BUSINESS.length - idx - 1 : 0;
      stepEl.textContent = idx < 0 ? '' : (left === 0 ? 'Letzte Frage' : `${left} weitere`);
      backBtn.disabled = stepHistory.length === 0;
    }

    function showStep(step: string) {
      current = step;
      const domKey = domKeyFor(step);
      qEls.forEach(q => q.classList.toggle('hidden', q.dataset.q !== domKey));
      renderProgress();
      renderStepChrome();
    }

    function goTo(step: string) {
      stepHistory.push(current);
      showStep(step);
    }

    backBtn.addEventListener('click', () => {
      if (!stepHistory.length) return;
      const prev = stepHistory.pop()!;
      current = prev;
      const domKey = domKeyFor(prev);
      qEls.forEach(q => q.classList.toggle('hidden', q.dataset.q !== domKey));
      renderProgress();
      renderStepChrome();
    });

    function advance(fromStep: string) {
      if (fromStep === 'role') {
        if (answers.role === 'business') {
          goTo('category');
        } else {
          showShortClose();
        }
        return;
      }
      if (fromStep === 'category') { goTo('followup'); return; }
      if (fromStep === 'followup') { goTo('time'); return; }
      if (fromStep === 'time')     { goTo('process'); return; }
      if (fromStep === 'process')  { goTo('goal'); return; }
      if (fromStep === 'goal')     { showGate(); return; }
    }

    function selectOption(step: string, btn: HTMLButtonElement) {
      answers[step] = btn.dataset.val || '';
      const parent = btn.closest('.vd-q')!;
      parent.querySelectorAll('.vd-opt').forEach(o => o.classList.remove('selected'));
      btn.classList.add('selected');
      setTimeout(() => advance(step), 160);
    }

    // Jede Frage — inklusive aller 7 kategoriespezifischen Folgefrage-Blöcke —
    // ist bereits im HTML vorgerendert, daher kann jeder Options-Button hier
    // direkt verdrahtet werden; nichts wird client-seitig gebaut.
    qEls.forEach(q => {
      const domKey = q.dataset.q!;
      const step = domKey.startsWith('followup-') ? 'followup' : domKey;
      q.querySelectorAll<HTMLButtonElement>('.vd-opt').forEach(btn => {
        btn.addEventListener('click', () => selectOption(step, btn));
      });
    });

    function showShortClose() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');
      document.getElementById('vd-stepname')?.classList.add('hidden');
      document.getElementById('vd-shortclose')!.classList.remove('hidden');
    }

    async function showGate() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');
      document.getElementById('vd-stepname')?.classList.add('hidden');

      (document.getElementById('gate-role')     as HTMLInputElement).value = answers.role || '';
      (document.getElementById('gate-category') as HTMLInputElement).value = answers.category || '';
      (document.getElementById('gate-followup') as HTMLInputElement).value = answers.followup || '';
      (document.getElementById('gate-time')     as HTMLInputElement).value = answers.time || '';
      (document.getElementById('gate-process')  as HTMLInputElement).value = answers.process || '';
      (document.getElementById('gate-goal')     as HTMLInputElement).value = answers.goal || '';
      (document.getElementById('gate-load-time') as HTMLInputElement).value = String(Math.floor(Date.now() / 1000));

      try {
        const res = await fetch('/get-math.php');
        const data = await res.json();
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = data.question;
      } catch (_) {
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = '3 + 5';
      }
      document.getElementById('vd-gate')!.classList.remove('hidden');
    }

    document.getElementById('vd-gate-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const errorEl = document.getElementById('vd-gate-error')!;
      const fallbackEl = document.getElementById('vd-gate-error-fallback')!;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.textContent = '...'; btn.disabled = true;
      errorEl.classList.add('hidden');
      fallbackEl.classList.add('hidden');
      try {
        const res = await fetch('/send-check.php', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.status === 'ok' && data.profile) {
          document.getElementById('vd-gate')!.classList.add('hidden');
          (document.getElementById('vd-result-tagline') as HTMLElement).textContent = data.profile.tagline || '';
          (document.getElementById('vd-result-description') as HTMLElement).textContent = data.profile.description || '';
          document.getElementById('vd-result')!.classList.remove('hidden');
        } else {
          // Unterschiedliche, ehrliche Meldung je Fehlergrund — ein
          // Mailserver-Problem ist nicht die Schuld der Besucherin, und "Ihre
          // Rechnung war falsch" zu sagen, wenn das nicht stimmt, führt nur
          // zu sinnlosen Versuchen.
          const messages: Record<string, string> = {
            security_check: 'Falsche Antwort – bitte nochmal versuchen.',
            invalid_email:  'Diese E-Mail-Adresse scheint ungültig zu sein – bitte prüfen und nochmal versuchen.',
            mail_failed:    'Beim Versenden ist auf unserer Seite etwas schiefgelaufen – bitte nochmal versuchen, oder unten direkt schreiben.',
          };
          errorEl.textContent = messages[data.reason] || 'Etwas ist schiefgelaufen – bitte nochmal versuchen, oder unten direkt schreiben.';
          errorEl.classList.remove('hidden');
          if (data.reason === 'mail_failed' || !data.reason) {
            fallbackEl.classList.remove('hidden');
          }
          btn.textContent = 'Mein Ergebnis sehen'; btn.disabled = false;
          const mathRes = await fetch('/get-math.php');
          const mathData = await mathRes.json();
          const mathEl = document.getElementById('vd-math-q');
          if (mathEl) mathEl.textContent = mathData.question;
          (form.querySelector('input[name="math_answer"]') as HTMLInputElement).value = '';
        }
      } catch (_) {
        errorEl.textContent = 'Etwas ist schiefgelaufen – bitte nochmal versuchen, oder unten direkt schreiben.';
        errorEl.classList.remove('hidden');
        fallbackEl.classList.remove('hidden');
        btn.textContent = 'Mein Ergebnis sehen'; btn.disabled = false;
      }
    });

    document.querySelectorAll('.vd-restart').forEach(btn => btn.addEventListener('click', () => window.location.reload()));
    showStep('role');
  </script>
</Layout>
