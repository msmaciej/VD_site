---
// src/pages/de/check.astro  →  vortexdeep.ch/de/check
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
const theme = 'paper';
---

<Layout title="VortexDeep — Schnell-Check" theme={theme} lang="de">
  <style is:global define:vars={{ theme }}>
    :root[data-theme="paper"] {
      --zen-bg: #F9F7F2;
      --zen-text: #0a0a0a;
      --zen-muted: #737373;
      --zen-accent: #0a0a0a;
    }
  </style>

  <main class="min-h-[100svh] flex flex-col items-center justify-start sm:justify-center px-6 pt-16 pb-12 sm:py-24"
        style="background-color: var(--zen-bg); color: var(--zen-text);">
    <div class="max-w-xl w-full mx-auto" id="vd-root">

      <!-- Top bar: back link + language switcher -->
      <div class="flex justify-between items-center mb-3" style="color: var(--zen-text);">
        <a href="/de/"
           class="text-[11px] uppercase tracking-[1.2em] opacity-60 hover:opacity-100 transition-opacity translate-x-[0.3em]"
           style="text-decoration:none; color:inherit;">
          VortexDeep
        </a>
        <LanguageSwitcher lang="de" slug="check" />
      </div>

      <p class="text-[10px] uppercase tracking-[0.4em] mb-8 sm:mb-16 opacity-40 text-center">
        Schnell-Check
      </p>

      <div class="flex gap-2 mb-8 sm:mb-16" id="vd-progress"></div>

      <!-- F0: Rolle -->
      <div class="vd-q" data-q="0">
        <p class="vd-ql">Was trifft auf Sie am ehesten zu?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="business">Geschäftsführer oder Inhaber – ich verantworte den laufenden Betrieb</button>
          <button class="vd-opt" data-val="consultant">Berater oder Agentur – ich erkunde das für Kunden</button>
          <button class="vd-opt" data-val="curious">Ich informiere mich über KI-Automatisierung – oder bin einfach neugierig</button>
        </div>
      </div>

      <!-- F1: Bereich — abgestimmt auf die 10 Automatisierungskategorien -->
      <div class="vd-q hidden" data-q="1">
        <p class="vd-ql">In welchem Bereich Ihres Betriebs fällt am meisten unnötige Zeit an?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="comms">Eingehende Anfragen, Nachrichten oder Kundensupport-Fälle bearbeiten und beantworten</button>
          <button class="vd-opt" data-val="sales">Leads nachfassen oder die Vertriebspipeline verwalten — Dinge fallen durchs Raster</button>
          <button class="vd-opt" data-val="docs">Dokumente, Rechnungen, Verträge oder Formulare verarbeiten — lesen, extrahieren, neu erfassen</button>
          <button class="vd-opt" data-val="ops">Interne Freigaben, Aufgabenverteilung, Onboarding-Abläufe oder Terminplanung</button>
          <button class="vd-opt" data-val="reporting">Berichte oder Auswertungen aus verstreuten Datenquellen zusammenstellen</button>
          <button class="vd-opt" data-val="content">Inhalte erstellen oder verbreiten — Social, Newsletter oder E-Commerce-Benachrichtigungen</button>
          <button class="vd-opt" data-val="several">Mehreres davon gleichzeitig</button>
        </div>
      </div>

      <!-- F2: Zeitaufwand -->
      <div class="vd-q hidden" data-q="2">
        <p class="vd-ql">Wie viele Stunden pro Woche bindet das in etwa?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="high">Mehr als 5 Stunden</button>
          <button class="vd-opt" data-val="mid">1 bis 5 Stunden</button>
          <button class="vd-opt" data-val="low">Weniger als eine Stunde</button>
          <button class="vd-opt" data-val="unsure">Schwer zu sagen – es verteilt sich quer durchs Team</button>
        </div>
      </div>

      <!-- F3: Prozessklarheit -->
      <div class="vd-q hidden" data-q="3">
        <p class="vd-ql">Gibt es dafür einen klaren Ablauf – oder hängt es davon ab, wer gerade Zeit hat?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="none">Keinen richtigen Ablauf – wer Zeit hat, kümmert sich</button>
          <button class="vd-opt" data-val="partial">Es gibt Regeln, aber in der Praxis läuft es trotzdem uneinheitlich</button>
          <button class="vd-opt" data-val="full">Es gibt einen definierten Ablauf – wir müssen ihn nur schneller machen</button>
        </div>
      </div>

      <!-- F4: Ziel -->
      <div class="vd-q hidden" data-q="4">
        <p class="vd-ql">Was wäre für Sie ein gutes Ergebnis?</p>
        <div class="flex flex-col gap-1">
          <button class="vd-opt" data-val="solve">Ein Ablauf, der mir das abnimmt – oder zumindest deutlich reduziert</button>
          <button class="vd-opt" data-val="clarity">Mehr Überblick über das, was läuft – damit ich bessere Entscheidungen treffe</button>
          <button class="vd-opt" data-val="explore">Erst verstehen, was überhaupt möglich ist – bevor ich mich auf etwas einlasse</button>
          <button class="vd-opt" data-val="compare">Sehen, wie andere das angegangen sind</button>
        </div>
      </div>

      <div class="flex justify-between items-center mt-12" id="vd-nav">
        <button id="vd-back" class="text-[10px] uppercase tracking-[0.3em] opacity-40 hover:opacity-80 transition-opacity" disabled>← Zurück</button>
        <span id="vd-step" class="text-[10px] uppercase tracking-[0.3em] opacity-40">1 / 5</span>
      </div>

      <!-- GATE -->
      <div id="vd-gate" class="hidden text-center">
        <p class="vd-tag">Noch ein Schritt</p>
        <h2 class="vd-rh">Ihre E-Mail genügt – dann sehen Sie Ihr Ergebnis.</h2>
        <p class="vd-rb">
          Wir zeigen Ihnen, wo Sie stehen, und melden uns persönlich bei Ihnen,
          wenn es passt. Keine automatisierten E-Mails.
        </p>
        <form id="vd-gate-form" class="flex flex-col gap-5 max-w-sm mx-auto text-left mt-8">
          <input type="hidden" name="source" value="vortexdeep.ch/de schnell-check">
          <input type="hidden" name="bucket"  id="gate-bucket">
          <input type="hidden" name="pain"    id="gate-pain">
          <input type="hidden" name="time"    id="gate-time">
          <input type="hidden" name="process" id="gate-process">
          <input type="hidden" name="goal"    id="gate-goal">
          <input type="hidden" name="form_load_time" id="gate-load-time">
          <input type="text" name="website_url" style="position:absolute;left:-9999px;width:1px;height:1px;" tabindex="-1" autocomplete="off"/>
          <label class="block">
            <span class="vd-fl">E-Mail</span>
            <input name="email" type="email" required class="vd-input" placeholder="ihre@email.com"/>
          </label>
          <label class="block">
            <span class="vd-fl">Name (optional)</span>
            <input name="name" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Unternehmen (optional)</span>
            <input name="company" type="text" class="vd-input"/>
          </label>
          <label class="block">
            <span class="vd-fl">Kurze Situationsbeschreibung (optional)</span>
            <textarea name="note" rows="2" class="vd-input"></textarea>
          </label>
          <div style="border:1px solid var(--zen-muted); padding:16px 20px; border-radius:4px; opacity:0.85;">
            <div class="flex items-center justify-between gap-6">
              <div>
                <span class="vd-fl" style="margin-bottom:6px;display:block;">Sicherheitsfrage</span>
                <p class="text-[12px] uppercase tracking-[0.08em]" style="color:var(--zen-text); margin:0;">
                  Berechnen: <strong id="vd-math-q" style="opacity:1;">···</strong>
                </p>
              </div>
              <input name="math_answer" type="number" required
                     class="vd-input"
                     placeholder="?"
                     style="width:64px; text-align:center; font-size:16px; border-bottom:1px solid var(--zen-text);"/>
            </div>
          </div>
          <p id="vd-gate-error" class="hidden text-[10px] uppercase tracking-[0.1em] opacity-70" style="color:var(--zen-text);">
            Falsche Antwort oder ungültige E-Mail – bitte nochmal versuchen.
          </p>
          <button type="submit"
                  class="mt-2 text-[10px] uppercase tracking-[0.4em] border-b pb-2 self-center hover:opacity-50 transition-opacity"
                  style="background:none;border-top:none;border-left:none;border-right:none;border-bottom:1px solid var(--zen-text);cursor:pointer;font-family:inherit;color:var(--zen-text);">
            Mein Ergebnis sehen
          </button>
        </form>
      </div>

      <!-- ERGEBNIS: Lead -->
      <div class="vd-result hidden text-center" id="vd-res-lead">
        <p class="vd-tag">Wahrscheinlich passend</p>
        <h2 class="vd-rh">Das klingt nach genau der Situation, mit der wir regelmässig arbeiten.</h2>
        <p class="vd-rb">
          Echter operativer Aufwand, keine klare Zuständigkeit und ein konkretes Ziel –
          das ist das Muster hinter den meisten unserer Projekte. Wir melden uns direkt bei Ihnen.
        </p>
        <p id="vd-lead-context" class="vd-rb" style="opacity:0.5; font-style:normal;"></p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">LinkedIn folgen</a>
        <br><button class="vd-restart mt-8">Nochmals starten</button>
      </div>

      <!-- ERGEBNIS: Warm -->
      <div class="vd-result hidden text-center" id="vd-res-warm">
        <p class="vd-tag">Einen näheren Blick wert</p>
        <h2 class="vd-rh">Ihre Prozesse zu kennen ist ein gutes Zeichen — kein Ausschlusskriterium.</h2>
        <p class="vd-rb">
          Abläufe, die auf den ersten Blick wenig Zeit kosten, eignen sich oft gut für Automatisierung —
          der Nutzen zeigt sich in Verlässlichkeit, weniger Fehlern oder freigewordener Aufmerksamkeit,
          nicht nur in Stunden. Ein Discovery-Gespräch ist der richtige Weg, das sauber zu bewerten.
          Wir haben Ihre Angaben und melden uns bei Ihnen.
        </p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">LinkedIn folgen</a>
        <br><button class="vd-restart mt-8">Nochmals starten</button>
      </div>

      <!-- ERGEBNIS: Other -->
      <div class="vd-result hidden text-center" id="vd-res-other">
        <p class="vd-tag">Vielen Dank</p>
        <h2 class="vd-rh">Am besten sehen Sie, wie wir arbeiten, auf LinkedIn.</h2>
        <p class="vd-rb">
          Dort teilen wir konkrete Fallstudien und echte Workflow-Beispiele –
          den Einblick, den ein solcher Check nicht bieten kann.
        </p>
        <a href="https://www.linkedin.com/company/vortexdeep" class="vd-soft-link">LinkedIn folgen</a>
        <br><button class="vd-restart mt-8">Nochmals starten</button>
      </div>

    </div>
  </main>

  <style>
    .vd-ql { font-size:14px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 2rem; text-align:center; }
    .vd-opt { text-align:left; font-size:11px; letter-spacing:0.05em; text-transform:uppercase; padding:14px 4px; border:none; border-bottom:1px solid var(--zen-muted); background:transparent; color:var(--zen-text); opacity:0.6; cursor:pointer; font-family:inherit; transition:opacity 0.2s ease, border-color 0.2s ease; width:100%; }
    .vd-opt:hover { opacity:1; border-color:var(--zen-text); }
    .vd-opt.selected { opacity:1; border-color:var(--zen-text); font-weight:600; }
    .vd-tag { font-size:10px; letter-spacing:0.2em; text-transform:uppercase; opacity:0.5; border-bottom:1px solid var(--zen-muted); display:inline-block; padding-bottom:6px; margin-bottom:1.5rem; }
    .vd-rh { font-size:16px; font-weight:200; letter-spacing:0.04em; text-transform:uppercase; line-height:1.5; margin:0 0 1rem; }
    .vd-rb { opacity:0.65; font-size:13px; line-height:1.7; max-width:38rem; margin:0 auto 2rem; }
    .vd-fl { font-size:9px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; display:block; margin-bottom:4px; }
    .vd-input { width:100%; background:transparent; border:none; border-bottom:1px solid var(--zen-muted); color:var(--zen-text); font-family:inherit; font-size:13px; padding:8px 2px; resize:vertical; }
    .vd-input:focus { outline:none; border-color:var(--zen-text); }
    .vd-soft-link { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.5; color:var(--zen-text); border-bottom:1px solid var(--zen-muted); padding-bottom:3px; text-decoration:none; }
    .vd-soft-link:hover { opacity:1; }
    .vd-restart { font-size:10px; letter-spacing:0.3em; text-transform:uppercase; opacity:0.4; background:none; border:none; cursor:pointer; font-family:inherit; color:var(--zen-text); }
    .vd-restart:hover { opacity:0.9; }
    #vd-progress span { height:1px; flex:1; background:var(--zen-muted); opacity:0.3; transition:opacity 0.3s ease, background 0.3s ease; }
    #vd-progress span.done { opacity:1; background:var(--zen-text); }
    .hidden { display:none; }
  </style>

  <script>
    const TOTAL = 5;
    const answers: Record<number, string> = {};
    let current = 0;

    const progressWrap = document.getElementById('vd-progress')!;
    for (let i = 0; i < TOTAL; i++) progressWrap.appendChild(document.createElement('span'));

    const backBtn = document.getElementById('vd-back') as HTMLButtonElement;
    const stepEl  = document.getElementById('vd-step')!;
    const nav     = document.getElementById('vd-nav')!;
    const qEls    = Array.from(document.querySelectorAll<HTMLElement>('.vd-q'));

    function render() {
      qEls.forEach(q => q.classList.toggle('hidden', Number(q.dataset.q) !== current));
      progressWrap.querySelectorAll('span').forEach((s, i) => s.classList.toggle('done', i <= current));
      stepEl.textContent = `${current + 1} / ${TOTAL}`;
      backBtn.disabled = current === 0;
    }

    qEls.forEach(q => {
      q.querySelectorAll<HTMLButtonElement>('.vd-opt').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = Number(q.dataset.q);
          answers[idx] = btn.dataset.val || '';
          q.querySelectorAll('.vd-opt').forEach(o => o.classList.remove('selected'));
          btn.classList.add('selected');
          setTimeout(() => {
            if (idx < TOTAL - 1) { current = idx + 1; render(); }
            else showGate();
          }, 160);
        });
      });
    });

    backBtn.addEventListener('click', () => { if (current > 0) { current--; render(); } });

    // Schmerz-Werte: comms | sales | docs | ops | reporting | content | several
    // Kategorien:
    //   comms     → Kommunikation & Eingang + Kundenbetreuung & After-Sales
    //   sales     → Lead- & Vertriebsprozesse
    //   docs      → Dokumente & Daten + Finanzen & Verwaltung
    //   ops       → Interne Abläufe & Freigaben + Terminplanung & Buchungen
    //   reporting → Reporting & Analysen
    //   content   → Content & Marketing + E-Commerce & Fulfilment
    //   several   → mehrere Kategorien gleichzeitig (stärkstes Signal)
    function calcBucket(): 'lead' | 'warm' | 'other' {
      const role = answers[0], pain = answers[1], time = answers[2], process = answers[3], goal = answers[4];
      if (role === 'consultant' || goal === 'compare' || role === 'curious') return 'other';
      const hasRealTimeCost = time === 'high' || time === 'mid' || time === 'unsure';
      const hasMultiPain   = pain === 'several';
      const wantsOutcome   = goal === 'solve' || goal === 'clarity';
      const processGap     = process !== 'full';
      if (role === 'business' && (hasRealTimeCost || hasMultiPain) && processGap && wantsOutcome) return 'lead';
      if (role === 'business') return 'warm';
      return 'other';
    }

    async function showGate() {
      qEls.forEach(q => q.classList.add('hidden'));
      nav.classList.add('hidden');
      progressWrap.classList.add('hidden');

      const bucket = calcBucket();
      (document.getElementById('gate-bucket')  as HTMLInputElement).value = bucket;
      (document.getElementById('gate-pain')    as HTMLInputElement).value = answers[1] || '';
      (document.getElementById('gate-time')    as HTMLInputElement).value = answers[2] || '';
      (document.getElementById('gate-process') as HTMLInputElement).value = answers[3] || '';
      (document.getElementById('gate-goal')    as HTMLInputElement).value = answers[4] || '';
      (document.getElementById('gate-load-time') as HTMLInputElement).value = String(Math.floor(Date.now() / 1000));

      try {
        const res = await fetch('/get-math.php');
        const data = await res.json();
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = data.question;
      } catch (_) {
        const el = document.getElementById('vd-math-q');
        if (el) el.textContent = '3 + 5';
      }
      document.getElementById('vd-gate')!.classList.remove('hidden');
    }

    document.getElementById('vd-gate-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const errorEl = document.getElementById('vd-gate-error')!;
      const bucket  = (document.getElementById('gate-bucket') as HTMLInputElement).value;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.textContent = '...'; btn.disabled = true; errorEl.classList.add('hidden');
      try {
        const res = await fetch('/send-check.php', { method: 'POST', body: new FormData(form) });
        const data = await res.json();
        if (data.status === 'ok') {
          document.getElementById('vd-gate')!.classList.add('hidden');
          document.getElementById('vd-res-' + bucket)!.classList.remove('hidden');
          // Kategoriespezifische Zeile in Lead-Ergebnis einfügen
          if (bucket === 'lead') {
            const ctx: Record<string, string> = {
              comms:     'Kommunikation und Anfragebearbeitung ist einer unserer aktivsten Bereiche — Klassifizierung, Weiterleitung und Antwortentwürfe.',
              sales:     'Vertriebsautomatisierung passt gut zum phasenbasierten Ansatz — klarer Umfang, messbares Ergebnis ab Tag eins.',
              docs:      'Dokumentenverarbeitung — Rechnungsextraktion, Vertragsanalyse, Formularerfassung — liefert oft die schnellsten Projektergebnisse.',
              ops:       'Interne Workflow-Automatisierung — Freigaben, Onboarding, Terminplanung — reduziert Koordinationsaufwand nachhaltig.',
              reporting: 'Automatisiertes Reporting funktioniert gut als Managed Service — einmal aufgebaut, läuft es und Sie erhalten monatlich den Output.',
              content:   'Content- und E-Commerce-Automatisierung skaliert den Output, ohne Köpfe zu skalieren — genau der Hebel, den wir bauen.',
              several:   'Mehrere Problembereiche gleichzeitig sind oft das klarste Zeichen für einen guten Fit — wir priorisieren gemeinsam in Phase 1.',
            };
            const ctxEl = document.getElementById('vd-lead-context');
            if (ctxEl) ctxEl.textContent = ctx[answers[1]] || '';
          }
        } else {
          errorEl.classList.remove('hidden');
          btn.textContent = 'Mein Ergebnis sehen'; btn.disabled = false;
          const mathRes = await fetch('/get-math.php');
          const mathData = await mathRes.json();
          const mathEl = document.getElementById('vd-math-q');
          if (mathEl) mathEl.textContent = mathData.question;
          (form.querySelector('input[name="math_answer"]') as HTMLInputElement).value = '';
        }
      } catch (_) {
        errorEl.classList.remove('hidden'); btn.textContent = 'Mein Ergebnis sehen'; btn.disabled = false;
      }
    });

    document.querySelectorAll('.vd-restart').forEach(btn => btn.addEventListener('click', () => window.location.reload()));
    render();
  </script>
</Layout>
