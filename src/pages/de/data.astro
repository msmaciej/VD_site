---
// src/pages/de/data.astro  →  vortexdeep.ch/de/data
// Standalone "Wie wir mit Ihren Daten umgehen" page. Chrome mirrors
// de/check.astro; kept in sync by hand (does not route through SitePage.astro).
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { fontFamily, socialIcon } from '../../utils/siteHelpers.ts';

const settingFiles = await Astro.glob('../../content/settings/*.json');
const settings = settingFiles[0]?.default || {};

const currentTheme = settings.theme || 'light';
const currentYear  = new Date().getFullYear();

const activeFont = (settings.fontPreset === 'custom' && settings.customFontName)
  ? settings.customFontName
  : (settings.fontPreset || 'Inter');
const activeFontFamily = fontFamily(activeFont);

const headerHeight     = settings.headerHeight     || '52px';
const footerHeight     = settings.footerHeight     || '44px';
const headerInnerWidth = settings.headerInnerWidth || '680px';

const homeUrl = '/de/';
const resolvedNavLinks = (settings.navLinks || []).map((link: any) => ({
  label: link.label_de || link.label,
  url:   link.url,
}));
const contactEmail = settings.contactEmail || 'info@vortexdeep.ch';
---

<Layout title="Wie wir mit Ihren Daten umgehen — VortexDeep" theme={currentTheme} lang="de">
  <header class="vd-fixed-header"
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);" class="w-5 h-5 flex-shrink-0">
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class="text-[10px] uppercase tracking-[0.4em]"
              style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
          {settings.siteName || 'VortexDeep'}
        </span>
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`${settings.headerLinksFontSize || 'text-[10px]'} uppercase tracking-[0.3em] opacity-50 hover:opacity-100 transition-opacity`}
             style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="de" slug="data" />
      </nav>
    </div>
  </header>

  <main class="min-h-[100svh] flex flex-col items-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); font-family: ${activeFontFamily}; padding-top: calc(${headerHeight} + 32px); padding-bottom: calc(${footerHeight} + env(safe-area-inset-bottom, 0px) + 40px);`}>
    <article class="vd-doc">
      <p class="vd-eyebrow">Daten &amp; Datenschutz</p>
      <h1 class="vd-h1">Wie wir mit Ihren Daten umgehen</h1>
      <p class="vd-lede">Ihre Daten gehören Ihnen, und wir bauen so, dass es dabei bleibt — vieles an der Arbeit berührt Ihre echten Daten gar nicht.</p>

      <section>
        <h2 class="vd-h2">Standardmässig zuerst mit Beispielen</h2>
        <p>Das meiste an einer Automatisierung ist Struktur — wie etwas gelesen, sortiert und entworfen wird. Dieser Teil lässt sich mit Beispielen oder erfundenen Fällen aufbauen und testen, oft ganz ohne Ihre echten Daten.</p>
      </section>

      <section>
        <h2 class="vd-h2">Echte Daten — nur zum Testen, nur vor der Übergabe</h2>
        <p>Wenn zu belegen ist, dass die Automatisierung durchgängig funktioniert, brauchen wir womöglich Ihre echten Daten. Das geschieht in einem klar begrenzten Zeitfenster vor der Übergabe: nur zum Testen, danach gelöscht. Nichts wird darüber hinaus aufbewahrt und nichts weitergegeben.</p>
      </section>

      <section>
        <h2 class="vd-h2">Im Betrieb — in Ihren Systemen</h2>
        <p>Sobald sie läuft, arbeitet die Automatisierung in oder neben Ihren eigenen Systemen. Wir berühren nur, was eine Aufgabe gerade braucht.</p>
      </section>

      <section>
        <h2 class="vd-h2">Was wir nie tun</h2>
        <ul class="vd-list">
          <li>Ihre Daten über die Arbeit hinaus aufbewahren</li>
          <li>Sie an Dritte weitergeben</li>
          <li>Sie für etwas anderes nutzen als die beauftragte Aufgabe</li>
        </ul>
      </section>

      <section>
        <h2 class="vd-h2">Was ein KI-Dienst sieht</h2>
        <p>Sie entscheiden, was ein externer KI-Dienst überhaupt zu sehen bekommt. Sensible Bereiche — Finanzen, Recht, Gesundheit — werden mit strengeren Grenzen behandelt, was Ihre Umgebung verlässt.</p>
      </section>

      <section>
        <h2 class="vd-h2">Ein Mensch gibt jeden Schritt frei</h2>
        <p>Nichts wird von allein gesendet, bezahlt oder eingereicht. Dieser menschliche Schritt ist nicht nur Beruhigung — er ist auch das, was die folgenden Regeln bei automatisierten Entscheidungen über Menschen erwarten.</p>
      </section>

      <section>
        <h2 class="vd-h2">Die Regeln, nach denen wir arbeiten</h2>
        <p><strong>revDSG</strong> — das Schweizer Datenschutzgesetz, in Kraft seit September 2023. Es regelt, wie mit Personendaten umzugehen ist: nur für einen klaren Zweck, sicher aufbewahrt, nicht länger als nötig, und einsehbar für die betroffene Person.</p>
        <p><strong>DSGVO</strong> — das EU-Pendant. Sie gilt, wenn ein Unternehmen Menschen in der EU bedient oder beobachtet. Da wir weltweit mit Kunden arbeiten, bauen wir nach beiden.</p>
        <p class="vd-muted">Beide erwarten bei automatisierten Entscheidungen, die einen Menschen erheblich betreffen, einen Menschen im Ablauf — eine Prüfung, die man verlangen kann. Unser Prinzip „jeden Schritt freigeben" ist genau diese Prüfung, von Anfang an eingebaut.</p>
      </section>

      <section>
        <h2 class="vd-h2">Die Zusammenarbeit</h2>
        <p>Wenn wir Daten in Ihrem Auftrag verarbeiten, schliessen wir einen Auftragsverarbeitungsvertrag — Sie als Verantwortliche, wir als Auftragsverarbeiter — der all dies schriftlich festhält. Fragen Sie ihn jederzeit an.</p>
        <p class="vd-note">Diese Seite beschreibt, wie wir arbeiten; sie ist keine Rechtsberatung. Für Ihre eigenen Pflichten sind Ihr Anwalt oder Treuhänder die richtige Adresse.</p>
      </section>

      <p class="vd-contact"><a href={`mailto:${contactEmail}`} class="vd-soft-link">{contactEmail}</a></p>
    </article>
  </main>

  <footer class="vd-fixed-footer"
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`} title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${settings.footerTextFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30`}
       style={`color: var(--zen-text); font-family: ${activeFontFamily};`}>
      {settings.footerText ? settings.footerText : `© ${currentYear} ${settings.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global>
    .vd-fixed-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: center; }
    .vd-fixed-header-inner { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(1rem, 4vw, 2rem); }
    .vd-fixed-footer { position: fixed; bottom: 0; left: 0; right: 0; padding-bottom: env(safe-area-inset-bottom, 0px); z-index: 50; display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
    .vd-icon { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border: 1px solid currentColor; font-size: 8px; font-weight: 600; letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none; border-radius: 3px; opacity: 0.35; transition: opacity 0.25s ease; }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }
  </style>

  <style>
    .vd-doc { max-width: 640px; width: 100%; margin: 0 auto; line-height: 1.75; }
    .vd-eyebrow { font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--zen-accent, var(--zen-muted)); text-align: center; margin: 0 0 14px; }
    .vd-h1 { font-size: 20px; font-weight: 600; letter-spacing: 0.01em; text-align: center; margin: 0 0 16px; line-height: 1.4; }
    .vd-lede { font-size: 16px; text-align: center; opacity: 0.92; margin: 0 auto 52px; max-width: 540px; }
    .vd-doc section { border-top: 1px solid color-mix(in srgb, var(--zen-muted) 22%, transparent); padding-top: 24px; margin: 0 0 36px; }
    .vd-h2 { font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--zen-accent, var(--zen-muted)); margin: 0 0 14px; }
    .vd-doc p { font-size: 15px; margin: 0 0 12px; }
    .vd-muted { color: var(--zen-muted); }
    .vd-list { list-style: none; padding: 0; margin: 8px 0 0; }
    .vd-list li { font-size: 15px; padding: 7px 0 7px 20px; position: relative; }
    .vd-list li::before { content: ''; position: absolute; left: 0; top: 14px; width: 4px; height: 4px; border-radius: 50%; background: var(--zen-accent, var(--zen-muted)); }
    .vd-note { font-size: 12px; color: var(--zen-muted); border: 1px dashed color-mix(in srgb, var(--zen-muted) 40%, transparent); border-radius: 10px; padding: 14px 16px; margin-top: 10px; }
    .vd-contact { text-align: center; margin-top: 52px; }
    .vd-soft-link { color: var(--zen-accent, var(--zen-text)); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--zen-muted) 50%, transparent); padding-bottom: 2px; }
    .vd-soft-link:hover { opacity: 0.8; }
  </style>
</Layout>
