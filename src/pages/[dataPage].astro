---
// src/pages/[dataPage].astro  →  vortexdeep.ch/data
// Content comes from src/content/dataPage/en.json (editable in Tina).
// If that file's "enabled" is false, getStaticPaths returns nothing, so the
// page is not built at all — a direct visit just gets the normal not-found.
import Layout from '../layouts/Layout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { fontFamily, socialIcon, filterNavLinks, isFitCheckEnabled, fontSizeClass, textStyle, fontSizePx, fontWeightNumber, trackingEm, themeColors, themeFamily, fontScaleFactor } from '../utils/siteHelpers.ts';
import doc from '../content/dataPage/en.json';

export async function getStaticPaths() {
  const enabled = (doc as any)?.enabled !== false;
  return enabled ? [{ params: { dataPage: 'data' } }] : [];
}

const settingFiles = await Astro.glob('../content/settings/*.json');
const settings = settingFiles[0]?.default || {};
const typo = (settings.typography || {}) as any;

// Data page content — driven by Typography → Data page roles when set;
// otherwise now falls through to the SAME global roles every other title/
// body/label on the site reads (title/subTitle/body/label), before finally
// landing on a hard literal. Previously docTitle/docLede/docBody fell
// straight to a hardcoded number when unset, skipping the global roles
// entirely — meaning changing the site-wide Titles/Body typography had no
// effect here at all, unlike a normal section or "The Six Phases", which
// read typo.title/typo.body directly. This restores that inheritance while
// keeping the Data-page-specific roles available for anyone who wants this
// page to look deliberately different from the rest of the site.
const roleSize    = (specific: any, fallback: any, hard: string) => specific?.size    ? fontSizePx(specific.size)         : fallback?.size    ? fontSizePx(fallback.size)         : hard;
const roleWeight   = (specific: any, fallback: any, hard: string) => specific?.weight  ? fontWeightNumber(specific.weight) : fallback?.weight  ? fontWeightNumber(fallback.weight)  : hard;
const roleTracking = (specific: any, fallback: any, hard: string) => specific?.tracking ? trackingEm(specific.tracking)    : fallback?.tracking ? trackingEm(fallback.tracking)     : hard;
const roleOpacity  = (specific: any, fallback: any, hard: number) => specific?.opacity ?? fallback?.opacity ?? hard;
const roleFont     = (specific: any, fallback: any) => specific?.font ? fontFamily(specific.font) : fallback?.font ? fontFamily(fallback.font) : null;

// Inline per-field overrides (the Font/Size/Weight controls sitting right
// next to Eyebrow/Heading/Intro above) take priority over the Typography
// role, which takes priority over the shared global role — same 3-tier
// idea as everywhere else on the site, just merged into one object here so
// the existing roleSize/roleWeight/etc. helpers (specific, fallback, hard)
// still only need two levels to check.
const d = doc as any;
const inlineEyebrow = { font: d.eyebrowFont, size: d.eyebrowFontSize, weight: d.eyebrowFontWeight, tracking: typo.docEyebrow?.tracking, opacity: typo.docEyebrow?.opacity };
const inlineHeading = { font: d.headingFont, size: d.headingFontSize, weight: d.headingFontWeight, tracking: typo.docTitle?.tracking, opacity: typo.docTitle?.opacity };
const inlineIntro   = { font: d.introFont,   size: d.introFontSize,   weight: d.introFontWeight,   tracking: typo.docLede?.tracking,  opacity: typo.docLede?.opacity  };
// Falls through inline → Typography role → global role, in that order.
const mergedEyebrow = { ...typo.docEyebrow, ...Object.fromEntries(Object.entries(inlineEyebrow).filter(([, v]) => v)) };
const mergedHeading = { ...typo.docTitle,   ...Object.fromEntries(Object.entries(inlineHeading).filter(([, v]) => v)) };
const mergedIntro   = { ...typo.docLede,    ...Object.fromEntries(Object.entries(inlineIntro).filter(([, v]) => v)) };

const vd = {
  eyebrowSize: roleSize(mergedEyebrow, typo.label, '10px'),
  eyebrowWeight: roleWeight(mergedEyebrow, typo.label, '400'),
  eyebrowTracking: roleTracking(mergedEyebrow, typo.label, '0.24em'),
  eyebrowOpacity: roleOpacity(mergedEyebrow, typo.label, 100),
  h1Size: roleSize(mergedHeading, typo.title, '20px'),
  h1Weight: roleWeight(mergedHeading, typo.title, '600'),
  h1Tracking: roleTracking(mergedHeading, typo.title, '0.01em'),
  h1Opacity: roleOpacity(mergedHeading, typo.title, 100),
  ledeSize: roleSize(mergedIntro, typo.subTitle, '16px'),
  ledeWeight: roleWeight(mergedIntro, typo.subTitle, '400'),
  ledeTracking: roleTracking(mergedIntro, typo.subTitle, 'normal'),
  ledeOpacity: roleOpacity(mergedIntro, typo.subTitle, 92),
  h2Size: roleSize(typo.docSectionHeading, typo.label, '11px'),
  h2Weight: roleWeight(typo.docSectionHeading, typo.label, '600'),
  h2Tracking: roleTracking(typo.docSectionHeading, typo.label, '0.22em'),
  h2Opacity: roleOpacity(typo.docSectionHeading, typo.label, 100),
  bodySize: roleSize(typo.docBody, typo.body, '15px'),
  bodyWeight: roleWeight(typo.docBody, typo.body, '400'),
  bodyTracking: roleTracking(typo.docBody, typo.body, 'normal'),
  bodyOpacity: roleOpacity(typo.docBody, typo.body, 100),
  noteSize: roleSize(typo.docBody, typo.body, '12px'),
  docFont: roleFont(typo.docBody, typo.body),
  eyebrowFont: roleFont(mergedEyebrow, typo.label),
  h2Font: roleFont(typo.docSectionHeading, typo.label),
  // Found via a full audit of every text-bearing CSS rule on this page:
  // .vd-h1 and .vd-lede had size/weight/tracking/opacity correctly wired to
  // docTitle/docLede, but never had their OWN font-family — they silently
  // inherited whatever .vd-doc's (body-derived) font resolved to instead of
  // their own role's font. Size could diverge from the global Title/Subtitle
  // roles correctly; the actual typeface could not.
  h1Font: roleFont(mergedHeading, typo.title),
  ledeFont: roleFont(mergedIntro, typo.subTitle),
  // The contact email link — independent from the eyebrow on purpose. It
  // used to literally share eyebrowSize/eyebrowTracking/eyebrowFont, so
  // editing "Data & Privacy" silently dragged the email link's styling
  // along with it. Sourced from the shared Label role directly, same as
  // the email link on every other page, not from anything eyebrow-specific.
  linkSize: typo.label?.size ? fontSizePx(typo.label.size) : '10px',
  linkTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.24em',
  linkFont: typo.label?.font ? fontFamily(typo.label.font) : null,
};

// Per-section inline overrides — sections are a list, so each one can set
// its own Heading/Body Font/Size/Weight, unlike the single doc-level fields
// above. Same inline → Typography role → global fallback order, computed
// per-section at render time instead of once, and returned as a ready
// inline style string.
const sectionHeadingStyle = (sec: any) => {
  const merged = { ...typo.docSectionHeading, ...Object.fromEntries(Object.entries({
    font: sec.headingFont, size: sec.headingFontSize, weight: sec.headingFontWeight,
  }).filter(([, v]) => v)) };
  return `font-size: calc(${roleSize(merged, typo.label, '11px')} * var(--docTextScale, 1)); font-weight: ${roleWeight(merged, typo.label, '600')}; letter-spacing: ${roleTracking(merged, typo.label, '0.22em')}; opacity: ${roleOpacity(merged, typo.label, 100)}%; font-family: ${roleFont(merged, typo.label) || activeFontFamily};`;
};
const sectionBodyStyle = (sec: any) => {
  const merged = { ...typo.docBody, ...Object.fromEntries(Object.entries({
    font: sec.bodyFont, size: sec.bodyFontSize, weight: sec.bodyFontWeight,
  }).filter(([, v]) => v)) };
  return `font-size: calc(${roleSize(merged, typo.body, '15px')} * var(--docTextScale, 1)); font-weight: ${roleWeight(merged, typo.body, '400')}; letter-spacing: ${roleTracking(merged, typo.body, 'normal')}; opacity: ${roleOpacity(merged, typo.body, 100)}%; font-family: ${roleFont(merged, typo.body) || activeFontFamily};`;
};

const currentTheme = settings.appearance.theme || 'light';
const currentYear  = new Date().getFullYear();

// ── Theme toggle (mirrors SitePage.astro exactly) ──────────────────────────
// Without these, this page previously fell back to Layout's own defaults —
// no autoBg/autoText override and themeToggleEnabled=false — which meant the
// visitor's saved light/dark choice from the main page was never read here
// (Layout's FOUC script is gated on themeToggleEnabled), and any custom
// background/text color override from Site Settings was silently dropped in
// favour of the preset's flat default. Both are what made this page look
// "stuck" on one fixed theme regardless of what the visitor had chosen.
const getBgColor = () => {
  if (settings.appearance.customBackgroundColor) return settings.appearance.customBackgroundColor;
  return themeColors[currentTheme]?.bg || '#ffffff';
};
const getTextColor = (customColor?: string) => {
  const base = customColor || settings.appearance.baseTextColor;
  if (!base) return themeColors[currentTheme]?.text || '#0a0a0a';
  return base;
};
const themeToggleEnabled = settings.appearance.enableThemeToggle === true;
const autoFamily = themeFamily(getBgColor());

const activeFont = (settings.appearance.fontPreset === 'custom' && settings.appearance.customFontName)
  ? settings.appearance.customFontName
  : (settings.appearance.fontPreset || 'Inter');
let activeFontFamily = fontFamily(activeFont);

// ── Data Page appearance overrides (Tina: Page — Data → Appearance) ───────
// Same local-shortcut pattern as Fit Check's own Appearance section: Font,
// if set, overrides the site Global Default Font on this page only (blank =
// inherit); Text size is a scale factor multiplied into the docFont sizes
// below, same size-scale used across the site.
const docAppear = (doc as any).appearance || {};
const docFontChoice = docAppear.fontPreset || '';
if (docFontChoice) {
  const docFontName = (docFontChoice === 'custom' && docAppear.customFontName)
    ? docAppear.customFontName
    : docFontChoice;
  activeFontFamily = fontFamily(docFontName);
}
const docTextScale = fontScaleFactor(docAppear.baseSize, 'base');

const headerHeight     = settings.layout.headerHeight     || '52px';
const footerHeight     = settings.layout.footerHeight     || '44px';
const headerInnerWidth = settings.layout.headerInnerWidth || '680px';

const homeUrl = '/';
const fitCheckFiles = await Astro.glob('../content/fitcheck/*.json');
const fitCheckEnabled = isFitCheckEnabled(fitCheckFiles[0]?.default);
const resolvedNavLinks = filterNavLinks(settings.header.navLinks, fitCheckEnabled).map((link: any) => ({
  label: link.label,
  url:   link.url,
}));
const contactEmail = (doc as any).contactEmail || settings.seo.contactEmail || 'info@vortexdeep.ch';

const parts = (s: string) => (s || '').split('|').map((x) => x.trim()).filter(Boolean);
---

<Layout title={`${(doc as any).heading} — VortexDeep`} description={(doc as any).intro || ''} ogImage={settings.seo.ogImage || ''} siteUrl={settings.seo.siteUrl || 'https://vortexdeep.ch'} theme={currentTheme} lang="en"
        autoBg={getBgColor()} autoText={getTextColor()} autoFamily={autoFamily} themeToggleEnabled={themeToggleEnabled}>
  <header class="vd-fixed-header"
          style={`background-color: var(--zen-bg); color: var(--zen-text); height: ${headerHeight};`}>
    <div class="vd-fixed-header-inner" style={`max-width: ${headerInnerWidth};`}>
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity"
         style="text-decoration:none; color:inherit;">
        {settings.appearance.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style="color: var(--zen-text);" class="w-5 h-5 flex-shrink-0">
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class={`${fontSizeClass(settings.header.wordmarkFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.wordmarkFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.wordmarkTracking || typo.header?.tracking || 'tracking-[0.4em]'}`}
              style={textStyle('var(--zen-text)', settings.header.wordmarkFont || typo.header?.font, settings.header.wordmarkOpacity ?? typo.header?.opacity ?? 100) + ` font-family: ${settings.header.wordmarkFont || typo.header?.font ? fontFamily(settings.header.wordmarkFont || typo.header?.font) : activeFontFamily};`}>
          {settings.hero.siteName || 'VortexDeep'}
        </span>
      </a>

      <nav class="flex gap-6 items-center" style="color: var(--zen-text);">
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`vd-nav-link ${fontSizeClass(settings.header.headerLinksFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.headerLinksFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.headerLinksTracking || typo.header?.tracking || 'tracking-[0.3em]'}`}
             style={`color: var(--zen-text); opacity: ${settings.header.headerLinksOpacity ?? typo.header?.opacity ?? 50}%; font-family: ${settings.header.headerLinksFont || typo.header?.font ? fontFamily(settings.header.headerLinksFont || typo.header?.font) : activeFontFamily};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang="en" slug="data" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style="color: var(--zen-text);"
                  aria-label="Switch light/dark view">
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  <main class="min-h-[100svh] flex flex-col items-center px-6"
        style={`background-color: var(--zen-bg); color: var(--zen-text); font-family: ${activeFontFamily}; padding-top: calc(${headerHeight} + 32px); padding-bottom: calc(${footerHeight} + env(safe-area-inset-bottom, 0px) + 40px);`}>
    <article class="vd-doc">
      {(doc as any).eyebrow && <p class="vd-eyebrow" style={`font-size:calc(${vd.eyebrowSize} * ${docTextScale}); font-weight:${vd.eyebrowWeight}; letter-spacing:${vd.eyebrowTracking}; opacity:${vd.eyebrowOpacity}%; font-family:${vd.eyebrowFont || activeFontFamily};`}>{(doc as any).eyebrow}</p>}
      <h1 class="vd-h1" style={`font-size:calc(${vd.h1Size} * ${docTextScale}); font-weight:${vd.h1Weight}; letter-spacing:${vd.h1Tracking}; opacity:${vd.h1Opacity}%; font-family:${vd.h1Font || activeFontFamily};`}>{(doc as any).heading}</h1>
      {(doc as any).intro && <p class="vd-lede" style={`font-size:calc(${vd.ledeSize} * ${docTextScale}); font-weight:${vd.ledeWeight}; letter-spacing:${vd.ledeTracking}; opacity:${vd.ledeOpacity}%; font-family:${vd.ledeFont || activeFontFamily};`}>{(doc as any).intro}</p>}

      {(doc as any).sections?.map((sec: any) => (
        <section>
          {sec.heading && <h2 class="vd-h2" style={`font-size:calc(${vd.h2Size} * ${docTextScale}); font-weight:${vd.h2Weight}; letter-spacing:${vd.h2Tracking}; opacity:${vd.h2Opacity}%; font-family:${vd.h2Font || activeFontFamily};`}>{sec.heading}</h2>}
          {sec.style === 'list' ? (
            <ul class="vd-list">{parts(sec.body).map((li) => <li style={`font-size:calc(${vd.bodySize} * ${docTextScale}); font-weight:${vd.bodyWeight}; letter-spacing:${vd.bodyTracking}; opacity:${vd.bodyOpacity}%; font-family:${vd.docFont || activeFontFamily};`}>{li}</li>)}</ul>
          ) : sec.style === 'note' ? (
            <div class="vd-note" style={`font-size:calc(${vd.noteSize} * ${docTextScale}); font-weight:${vd.bodyWeight}; letter-spacing:${vd.bodyTracking}; opacity:${vd.bodyOpacity}%; font-family:${vd.docFont || activeFontFamily};`}>{parts(sec.body).map((p) => <p style="margin:0 0 6px;">{p}</p>)}</div>
          ) : (
            parts(sec.body).map((p, i) => (
              <p class={i === parts(sec.body).length - 1 && parts(sec.body).length > 2 ? 'vd-muted' : ''} style={`font-size:calc(${vd.bodySize} * ${docTextScale}); font-weight:${vd.bodyWeight}; letter-spacing:${vd.bodyTracking}; opacity:${vd.bodyOpacity}%; font-family:${vd.docFont || activeFontFamily};`}>{p}</p>
            ))
          )}
        </section>
      ))}

      <p class="vd-contact"><a href={`mailto:${contactEmail}`} class="vd-soft-link" style={`font-size:calc(${vd.linkSize} * ${docTextScale}); letter-spacing:${vd.linkTracking}; font-family:${vd.linkFont || activeFontFamily};`}>{contactEmail}</a></p>
    </article>
  </main>

  <footer class="vd-fixed-footer"
          style={`background-color: var(--zen-bg); color: var(--zen-text); min-height: ${footerHeight};`}>
    {settings.footer.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`} title={social.platform}
           style="color: var(--zen-text);">
          {icon}
        </a>
      );
    })}
    {settings.footer.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style="color: var(--zen-text);">·</span>
    )}
    <p class={`${fontSizeClass(settings.footer.footerTextFontSize || typo.footer?.size || 'text-[9px]')} ${settings.footer.footerTextFontWeight || typo.footer?.weight || ''} ${typo.footer?.uppercase !== false ? 'uppercase' : ''} ${settings.footer.footerTextTracking || typo.footer?.tracking || 'tracking-[0.25em]'}`}
       style={`color: var(--zen-text); opacity: ${settings.footer.footerTextOpacity ?? typo.footer?.opacity ?? 30}%; font-family: ${settings.footer.footerTextFont || typo.footer?.font ? fontFamily(settings.footer.footerTextFont || typo.footer?.font) : activeFontFamily};`}>
      {settings.footer.footerText ? settings.footer.footerText : `© ${currentYear} ${settings.hero.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <style is:global>
    .vd-nav-link { transition: opacity 0.2s ease; }
    .vd-nav-link:hover { opacity: 1 !important; }
    .vd-fixed-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: center; }
    .vd-fixed-header-inner { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(1rem, 4vw, 2rem); }
    .vd-fixed-footer { position: fixed; bottom: 0; left: 0; right: 0; padding-bottom: env(safe-area-inset-bottom, 0px); z-index: 50; display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
    .vd-icon { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border: 1px solid currentColor; font-size: 8px; font-weight: 600; letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none; border-radius: 3px; opacity: 0.35; transition: opacity 0.25s ease; }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    /* ── Theme toggle (sun/moon) — copied verbatim from SitePage.astro's
       is:global block. That block never reaches this page: Astro only
       bundles a component's styles into pages that actually render that
       component, and this page renders its own header rather than
       <SitePage>, so the rules have to live here too rather than relying
       on the main page's copy. Keep the two in sync if this ever changes. */
    .vd-theme-btn {
      position: relative;
      display: inline-flex; align-items: center; justify-content: center;
      width: 20px; height: 20px; padding: 0; border: none; background: none;
      cursor: pointer;
    }
    .vd-theme-icon {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transform: scale(0.4) rotate(-70deg);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .vd-theme-icon svg { width: 100%; height: 100%; }
    html:not([data-theme-forced])[data-auto-family="dark"]  .vd-theme-icon-sun  { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced])[data-auto-family="light"] .vd-theme-icon-moon { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced]) .vd-theme-btn:hover .vd-theme-icon { opacity: 0.62; }
    html[data-theme-forced="light"] .vd-theme-icon-sun  { opacity: 1; transform: scale(1) rotate(0deg); }
    html[data-theme-forced="dark"]  .vd-theme-icon-moon { opacity: 1; transform: scale(1) rotate(0deg); }
  </style>

  <style define:vars={{
    eyebrowSize: vd.eyebrowSize, eyebrowWeight: vd.eyebrowWeight, eyebrowTracking: vd.eyebrowTracking, eyebrowOpacity: vd.eyebrowOpacity,
    h1Size: vd.h1Size, h1Weight: vd.h1Weight, h1Tracking: vd.h1Tracking, h1Opacity: vd.h1Opacity,
    ledeSize: vd.ledeSize, ledeWeight: vd.ledeWeight, ledeTracking: vd.ledeTracking, ledeOpacity: vd.ledeOpacity,
    h2Size: vd.h2Size, h2Weight: vd.h2Weight, h2Tracking: vd.h2Tracking, h2Opacity: vd.h2Opacity,
    bodySize: vd.bodySize, bodyWeight: vd.bodyWeight, bodyTracking: vd.bodyTracking, bodyOpacity: vd.bodyOpacity,
    noteSize: vd.noteSize,
    docFont: vd.docFont || activeFontFamily, eyebrowFont: vd.eyebrowFont || activeFontFamily, h2Font: vd.h2Font || activeFontFamily,
    linkSize: vd.linkSize, linkTracking: vd.linkTracking, linkFont: vd.linkFont || activeFontFamily,
    h1Font: vd.h1Font || activeFontFamily, ledeFont: vd.ledeFont || activeFontFamily,
    docTextScale,
  }}>
    .vd-doc { max-width: 640px; width: 100%; margin: 0 auto; line-height: 1.75; font-family: var(--docFont); }
    .vd-eyebrow { font-size: calc(var(--eyebrowSize) * var(--docTextScale, 1)); font-weight: var(--eyebrowWeight); letter-spacing: var(--eyebrowTracking); opacity: calc(var(--eyebrowOpacity, 100) * 1%); text-transform: uppercase; color: var(--zen-accent, var(--zen-muted)); text-align: center; margin: 0 0 14px; font-family: var(--eyebrowFont); }
    .vd-h1 { font-size: calc(var(--h1Size) * var(--docTextScale, 1)); font-weight: var(--h1Weight); letter-spacing: var(--h1Tracking); opacity: calc(var(--h1Opacity, 100) * 1%); text-align: center; margin: 0 0 16px; line-height: 1.4; font-family: var(--h1Font); }
    .vd-lede { font-size: calc(var(--ledeSize) * var(--docTextScale, 1)); font-weight: var(--ledeWeight); letter-spacing: var(--ledeTracking); text-align: center; opacity: calc(var(--ledeOpacity, 92) * 1%); margin: 0 auto 52px; max-width: 540px; font-family: var(--ledeFont); }
