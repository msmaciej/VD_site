---
// src/components/PlanetarySystemsBackground.astro
// Fixed, full-viewport three.js scene: N small "solar systems" drifting
// slowly through 3D space. Each system is a star (point) with a handful of
// planets orbiting it, each planet's orbital plane given its own random 3D
// tilt — so orbits read as genuinely foreshortened ellipses seen from an
// angle, not a flat 2D approximation. Depth (closer = bigger/brighter,
// distant = smaller/fog-faded) comes from a real perspective camera + fog,
// the same mechanism DepthNetworkBackground uses, not simulated via opacity
// math. Can run alongside DepthNetworkBackground (both position:fixed,
// z-index:0, stack in DOM order) or on its own.

interface Props {
  starColor?: string;      // hex — defaults to the theme's text color if not overridden
  fogColor?: string;       // hex — defaults to the theme's background color if not overridden
  systemCount?: number;    // how many star systems drift through the scene at once
  maxPlanets?: number;     // each system gets a random planet count from 1 up to this
  orbitMinRadius?: number; // 0–1, fraction of a base orbit unit — inner edge of where orbits can start
  orbitMaxRadius?: number; // 0–1, fraction of a base orbit unit — outer edge
  pathOpacity?: number;    // 0–1 — how visible the faint orbit rings are
}
const {
  starColor = '#e0e2e8',
  fogColor = '#0c0f14',
  systemCount = 4,
  maxPlanets = 4,
  orbitMinRadius = 0.35,
  orbitMaxRadius = 1,
  pathOpacity = 0.12,
} = Astro.props;
---

<canvas
  id="vd-planetary-bg"
  data-star-color={starColor}
  data-fog-color={fogColor}
  data-system-count={systemCount}
  data-max-planets={maxPlanets}
  data-orbit-min={orbitMinRadius}
  data-orbit-max={orbitMaxRadius}
  data-path-opacity={pathOpacity}
  aria-hidden="true"
  style="position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block;"
></canvas>

<script>
  // Type-only import: erased entirely at build time (no runtime module,
  // no bundle weight) — it exists purely so the Planet/System interfaces
  // below can reference three.js's types. The actual three.js code is
  // pulled in dynamically further down, and only once we've confirmed
  // the canvas exists in the DOM. A static `import * as THREE from
  // 'three'` at the top of this file would otherwise get bundled into
  // every page's JS by Astro, even pages where this canvas never
  // renders — see DepthNetworkBackground.astro for the same pattern.
  import type * as ThreeNS from 'three';

  const canvas = document.getElementById('vd-planetary-bg') as HTMLCanvasElement | null;

  if (canvas) {
    (async () => {
      const THREE = await import('three');

      const starColorHex = canvas.dataset.starColor || '#e0e2e8';
      const fogColorHex  = canvas.dataset.fogColor  || '#0c0f14';
      const SYSTEM_COUNT  = Math.max(0, parseInt(canvas.dataset.systemCount || '4', 10));
      const MAX_PLANETS   = Math.max(0, parseInt(canvas.dataset.maxPlanets || '4', 10));
      const ORBIT_MIN     = Math.min(1, Math.max(0, parseFloat(canvas.dataset.orbitMin || '0.35')));
      const ORBIT_MAX     = Math.min(1, Math.max(ORBIT_MIN, parseFloat(canvas.dataset.orbitMax || '1')));
      const PATH_OPACITY  = Math.min(1, Math.max(0, parseFloat(canvas.dataset.pathOpacity || '0.12')));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const BASE_RADIUS = 2.2; // world units — orbitMin/orbitMax scale against this

      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(new THREE.Color(fogColorHex).getHex(), 10, 30);

      const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.z = 14;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);

      // ── Systems ────────────────────────────────────────────────────────────
      const BOUNDS = { x: 10, y: 7, z: 8 }; // half-extents of the volume systems drift within

      interface Planet {
        radius: number;
        squash: number;
        angle: number;
        angularSpeed: number;
        point: ThreeNS.Points; // position updated each frame within its parent group's local XY plane
      }
      interface System {
        group: ThreeNS.Group;
        velocity: ThreeNS.Vector3;
        speedFactor: number; // multiplies every planet's angular speed — "some fast, some slow"
        planets: Planet[];
      }

      const starMaterial = new THREE.PointsMaterial({
        color: new THREE.Color(starColorHex), size: 0.14, sizeAttenuation: true,
        transparent: true, opacity: 0.85,
      });
      const planetMaterial = new THREE.PointsMaterial({
        color: new THREE.Color(starColorHex), size: 0.07, sizeAttenuation: true,
        transparent: true, opacity: 0.6,
      });
      const pathMaterial = new THREE.LineBasicMaterial({
        color: new THREE.Color(starColorHex), transparent: true, opacity: PATH_OPACITY,
      });

      function makeOrbitLine(radius: number, squash: number): ThreeNS.Line {
        const segments = 64;
        const pts: ThreeNS.Vector3[] = [];
        for (let s = 0; s <= segments; s++) {
          const a = (s / segments) * Math.PI * 2;
          pts.push(new THREE.Vector3(Math.cos(a) * radius, Math.sin(a) * radius * squash, 0));
        }
        const geo = new THREE.BufferGeometry().setFromPoints(pts);
        return new THREE.Line(geo, pathMaterial);
      }

      function makeSystem(): System {
        const group = new THREE.Group();
        group.position.set(
          (Math.random() * 2 - 1) * BOUNDS.x,
          (Math.random() * 2 - 1) * BOUNDS.y,
          (Math.random() * 2 - 1) * BOUNDS.z,
        );

        const star = new THREE.Points(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0, 0, 0)]), starMaterial);
        group.add(star);

        const planetCount = MAX_PLANETS > 0 ? 1 + Math.floor(Math.random() * MAX_PLANETS) : 0;
        const planets: Planet[] = [];
        for (let p = 0; p < planetCount; p++) {
          const spread = ORBIT_MIN + Math.random() * (ORBIT_MAX - ORBIT_MIN);
          const radius = spread * BASE_RADIUS * (0.4 + (p / Math.max(planetCount - 1, 1)) * 0.6);
          const squash = 0.55 + Math.random() * 0.45;

          // The orbital PLANE itself gets a random 3D tilt — this is what
          // makes the ellipses read as real 3D orbits seen from an angle,
          // not flat rings all facing the camera the same way.
          const planeGroup = new THREE.Group();
          planeGroup.rotation.set(
            Math.random() * Math.PI,
            Math.random() * Math.PI,
            Math.random() * Math.PI,
          );
          planeGroup.add(makeOrbitLine(radius, squash));

          const point = new THREE.Points(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(radius, 0, 0)]), planetMaterial);
          planeGroup.add(point);
          group.add(planeGroup);

          planets.push({
            radius,
            squash,
            angle: Math.random() * Math.PI * 2,
            angularSpeed: (0.08 + Math.random() * 0.14) / (0.4 + p * 0.3), // outer planets drift slower, Kepler-ish
            point,
          });
        }

        scene.add(group);
        return {
          group,
          velocity: new THREE.Vector3((Math.random() - 0.5) * 0.01, (Math.random() - 0.5) * 0.01, (Math.random() - 0.5) * 0.01),
          speedFactor: 0.4 + Math.random() * 1.4,
          planets,
        };
      }

      const systems: System[] = Array.from({ length: SYSTEM_COUNT }, makeSystem);

      function animate() {
        requestAnimationFrame(animate);

        if (!reduceMotion) {
          systems.forEach((sys) => {
            sys.group.position.add(sys.velocity);
            (['x', 'y', 'z'] as const).forEach((axis) => {
              const bound = axis === 'x' ? BOUNDS.x : axis === 'y' ? BOUNDS.y : BOUNDS.z;
              if (sys.group.position[axis] > bound || sys.group.position[axis] < -bound) {
                sys.velocity[axis] *= -1;
              }
            });

            sys.planets.forEach((p) => {
              p.angle += p.angularSpeed * sys.speedFactor * 0.016; // ~60fps-normalized step
              const x = Math.cos(p.angle) * p.radius;
              const y = Math.sin(p.angle) * p.radius * p.squash;
              const posAttr = p.point.geometry.attributes.position as ThreeNS.BufferAttribute;
              posAttr.setXYZ(0, x, y, 0);
              posAttr.needsUpdate = true;
            });
          });
        }

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    })();
  }
</script>
