---
// src/components/DepthNetworkBackground.astro
// Fixed, full-viewport Three.js scene: a field of point "nodes" drifting
// slowly in 3D, with faint lines drawn between any two nodes close enough
// together. Depth is real (a perspective camera + fog), not simulated —
// distant nodes are naturally smaller and fade into the fog color, near
// ones are brighter. Sits behind all page content; SitePage.astro is
// responsible for making the section backgrounds transparent (or lightly
// tinted) so this shows through.
//
// Rendered once per page — mount it high up (e.g. in SitePage.astro,
// right after <Layout> opens) so it sits behind the fixed header/footer
// and the scrolling content, all of which need a higher z-index than this.

interface Props {
  nodeColor?: string;       // hex, matches the page's text color so it adapts per theme
  fogColor?: string;        // hex, matches the page's background color
  nodeCount?: number;       // how many drifting points — admin-tunable via Site Settings
  connectDistance?: number; // how close two points must be to draw a line between them — admin-tunable
  lineOpacity?: number;     // 0–1 — how visible the connecting lines are — admin-tunable
  nodeOpacity?: number;     // 0–1 — how visible the points themselves are — admin-tunable
  // Theme toggle: the two FIXED literal palettes the visitor toggle snaps
  // to (see Layout.astro / SitePage.astro). Optional — pages that never
  // pass these simply never get a live recolor listener attached below,
  // so this stays a no-op when the toggle feature is off.
  lightNodeColor?: string;
  lightFogColor?:  string;
  darkNodeColor?:  string;
  darkFogColor?:   string;
}
const {
  nodeColor = '#e0e2e8',
  fogColor = '#0c0f14',
  nodeCount = 90,
  connectDistance = 5.4,
  lineOpacity = 0.16,
  nodeOpacity = 0.75,
  lightNodeColor,
  lightFogColor,
  darkNodeColor,
  darkFogColor,
} = Astro.props;
---

<canvas
  id="vd-depth-bg"
  data-node-color={nodeColor}
  data-fog-color={fogColor}
  data-node-count={nodeCount}
  data-connect-distance={connectDistance}
  data-line-opacity={lineOpacity}
  data-node-opacity={nodeOpacity}
  data-light-node-color={lightNodeColor}
  data-light-fog-color={lightFogColor}
  data-dark-node-color={darkNodeColor}
  data-dark-fog-color={darkFogColor}
  aria-hidden="true"
  style="position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block;"
></canvas>

<script>
  // No static `import * as THREE from 'three'` here on purpose — Astro
  // bundles a component's <script> at build time, so a top-level import
  // would ship the (sizeable) three.js payload to every page, even ones
  // where this canvas never renders (background toggle off, or the page
  // doesn't include this component at all). Importing dynamically, only
  // once we've confirmed the canvas actually exists in the DOM, means
  // three.js is fetched and executed solely on pages that use it.
  const canvas = document.getElementById('vd-depth-bg') as HTMLCanvasElement | null;

  if (canvas) {
    (async () => {
      const THREE = await import('three');

      const nodeColorHex = canvas.dataset.nodeColor || '#e0e2e8';
      const fogColorHex  = canvas.dataset.fogColor  || '#0c0f14';
      const NODE_COUNT = parseInt(canvas.dataset.nodeCount || '90', 10);
      const CONNECT_DISTANCE = parseFloat(canvas.dataset.connectDistance || '5.4');
      const LINE_OPACITY = Math.min(1, Math.max(0, parseFloat(canvas.dataset.lineOpacity || '0.16')));
      const NODE_OPACITY = Math.min(1, Math.max(0, parseFloat(canvas.dataset.nodeOpacity || '0.75')));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(new THREE.Color(fogColorHex).getHex(), 9, 26);

      const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.z = 13;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(window.innerWidth, window.innerHeight);

      // ── Nodes ──────────────────────────────────────────────────────────────
      // Bounds scale with node count (cube root, so density stays roughly
      // constant) — an admin raising "number of points" gets a denser-looking
      // field without also needing to retune the volume it drifts within.
      const baseBounds = { x: 9, y: 6.5, z: 9 };
      const scale = Math.cbrt(NODE_COUNT / 90);
      const BOUNDS = { x: baseBounds.x * scale, y: baseBounds.y * scale, z: baseBounds.z * scale };
      const positions = new Float32Array(NODE_COUNT * 3);
      const velocities: number[] = [];
      for (let i = 0; i < NODE_COUNT; i++) {
        positions[i * 3]     = (Math.random() * 2 - 1) * BOUNDS.x;
        positions[i * 3 + 1] = (Math.random() * 2 - 1) * BOUNDS.y;
        positions[i * 3 + 2] = (Math.random() * 2 - 1) * BOUNDS.z;
        velocities.push((Math.random() - 0.5) * 0.006, (Math.random() - 0.5) * 0.006, (Math.random() - 0.5) * 0.006);
      }

      const nodeGeometry = new THREE.BufferGeometry();
      nodeGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const nodeMaterial = new THREE.PointsMaterial({
        color: new THREE.Color(nodeColorHex),
        size: 0.075,
        sizeAttenuation: true,
        transparent: true,
        opacity: NODE_OPACITY,
      });
      const points = new THREE.Points(nodeGeometry, nodeMaterial);
      scene.add(points);

      // ── Connecting lines ───────────────────────────────────────────────────
      // Recomputed periodically (not every frame — the pairwise distance
      // check is cheap, but no need to do it dozens of times/sec when the
      // nodes are barely moving between frames).
      let lineGeometry = new THREE.BufferGeometry();
      const lineMaterial = new THREE.LineBasicMaterial({
        color: new THREE.Color(nodeColorHex),
        transparent: true,
        opacity: LINE_OPACITY,
      });
      let lines = new THREE.LineSegments(lineGeometry, lineMaterial);
      scene.add(lines);

      function rebuildLines() {
        const linePositions: number[] = [];
        for (let i = 0; i < NODE_COUNT; i++) {
          for (let j = i + 1; j < NODE_COUNT; j++) {
            const dx = positions[i * 3]     - positions[j * 3];
            const dy = positions[i * 3 + 1] - positions[j * 3 + 1];
            const dz = positions[i * 3 + 2] - positions[j * 3 + 2];
            const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
            if (dist < CONNECT_DISTANCE) {
              linePositions.push(positions[i * 3], positions[i * 3 + 1], positions[i * 3 + 2]);
              linePositions.push(positions[j * 3], positions[j * 3 + 1], positions[j * 3 + 2]);
            }
          }
        }
        scene.remove(lines);
        lineGeometry.dispose();
        lineGeometry = new THREE.BufferGeometry();
        lineGeometry.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
        lines = new THREE.LineSegments(lineGeometry, lineMaterial);
        scene.add(lines);
      }
      rebuildLines();

      // ── Theme toggle: live recolor ────────────────────────────────────────
      // The toggle (Layout.astro) can't reach into a running WebGL scene via
      // CSS variables — color-mix()/var() strings mean nothing to Three.js,
      // it needs real numbers. So it dispatches a plain DOM event instead,
      // and this listens for it directly. 'auto' reverts to the colors this
      // canvas was actually initialized with (nodeColorHex/fogColorHex,
      // i.e. whatever "Current" resolved to at build time); 'light'/'dark'
      // use the two fixed palettes passed in as props, ignoring any custom
      // color override — matching the clean-snap behavior of the CSS side.
      window.addEventListener('vd-theme-change', ((e: CustomEvent) => {
        const mode = e.detail?.mode;
        const targetNode = mode === 'light' ? canvas.dataset.lightNodeColor
                          : mode === 'dark'  ? canvas.dataset.darkNodeColor
                          : nodeColorHex;
        const targetFog  = mode === 'light' ? canvas.dataset.lightFogColor
                          : mode === 'dark'  ? canvas.dataset.darkFogColor
                          : fogColorHex;
        if (targetNode) {
          nodeMaterial.color.set(targetNode);
          lineMaterial.color.set(targetNode);
        }
        if (targetFog && scene.fog) {
          (scene.fog as InstanceType<typeof THREE.Fog>).color.set(targetFog);
        }
      }) as EventListener);

      // ── Animation ──────────────────────────────────────────────────────────
      let frame = 0;
      function animate() {
        requestAnimationFrame(animate);

        if (!reduceMotion) {
          for (let i = 0; i < NODE_COUNT; i++) {
            for (let axis = 0; axis < 3; axis++) {
              const idx = i * 3 + axis;
              positions[idx] += velocities[idx];
              const bound = axis === 0 ? BOUNDS.x : axis === 1 ? BOUNDS.y : BOUNDS.z;
              if (positions[idx] > bound || positions[idx] < -bound) velocities[idx] *= -1;
            }
          }
          nodeGeometry.attributes.position.needsUpdate = true;

          frame += 1;
          if (frame % 8 === 0) rebuildLines();

          // Slow camera drift, not node drift alone — reinforces the sense of
          // depth (parallax) rather than just particles bobbing in place.
          const t = Date.now() * 0.00004;
          camera.position.x = Math.sin(t) * 2.2;
          camera.position.y = Math.cos(t * 0.8) * 1.2;
          camera.lookAt(0, 0, 0);
        }

        renderer.render(scene, camera);
      }
      animate();

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });
    })();
  }
</script>
