---
// src/components/SiteStatusScreen.astro
// Full-screen "site paused" notice shown INSTEAD of the normal page when
// Site Settings → "Site status" is set to "In preparation" or "Maintenance".
// It is wired in from Layout.astro, so it covers EVERY route at once — home,
// /check, /data and their /de equivalents — meaning the whole public site is
// replaced by this single screen and nothing else stays reachable. (The Tina
// admin at /admin lives in public/ and is NOT gated, so you can always get
// back in to switch the status to "Live" again.)
//
// It carries the SAME animated background as the live site (the setting in
// "Background style"), so it reads as "same VortexDeep, just paused" rather
// than a stranger's holding page.
//
// Two modes:
//   preparation  — "in preparation, not yet commercially active": the
//                  RAV / Fachstelle Selbstständigkeit-facing wording
//                  (no customers, no invoicing, no revenue).
//   maintenance  — "temporarily offline for maintenance, back shortly".
//
// Turn it off: Site Settings → Site status → "Live", then npm run build and
// upload dist/. See _docs/README-SITE-STATUS.md.

import DepthNetworkBackground from './DepthNetworkBackground.astro';
import PlanetarySystemsBackground from './PlanetarySystemsBackground.astro';
import { themeColors } from '../utils/siteHelpers.ts';
import settingsJson from '../content/settings/site.json';

interface Props {
  mode: 'preparation' | 'maintenance';
  lang?: 'en' | 'de';
}
const { mode } = Astro.props;
const settings: any = settingsJson;

// ── Colours: resolve exactly like SitePage so the canvas matches the theme ──
const currentTheme = settings.appearance.theme || 'light';
const bgColor   = settings.appearance.customBackgroundColor || themeColors[currentTheme]?.bg   || '#ffffff';
const textColor = settings.appearance.baseTextColor        || themeColors[currentTheme]?.text || '#0a0a0a';

// ── Background style: identical to the live site ──
const backgroundStyle = settings.animations.backgroundStyle || 'none';
const animDepthBg   = backgroundStyle === 'depth';
const animPlanetary = backgroundStyle === 'planetary';

// ── Copy: admin-overridable via settings.siteStatusContent, bilingual
//    defaults baked in so it works out of the box with nothing filled in. ──
const c: any = settings.siteStatusContent || {};

const defaults = {
  preparation: {
    badge_de: 'In Vorbereitung',
    badge_en: 'In preparation',
    msg_de: 'VortexDeep befindet sich derzeit in Vorbereitung und ist noch nicht kommerziell am Markt tätig. Es bestehen keine Kundenaufträge, keine laufenden Projekte, keine Rechnungsstellung und keine Einnahmen.',
    msg_en: 'VortexDeep is currently in preparation and is not yet commercially active. There are no customer orders, no ongoing projects, no invoicing, and no revenue.',
  },
  maintenance: {
    badge_de: 'Wartungsarbeiten',
    badge_en: 'Under maintenance',
    msg_de: 'Die Website wird derzeit gewartet und ist vorübergehend nicht verfügbar. Bitte versuchen Sie es in Kürze erneut.',
    msg_en: 'This site is undergoing maintenance and is temporarily unavailable. Please check back shortly.',
  },
};

const d = defaults[mode];
const pick = (prep: string, maint: string) => (mode === 'preparation' ? c[prep] : c[maint]);

const badgeDe = pick('preparationBadge_de',   'maintenanceBadge_de')   || d.badge_de;
const badgeEn = pick('preparationBadge_en',   'maintenanceBadge_en')   || d.badge_en;
const msgDe   = pick('preparationMessage_de', 'maintenanceMessage_de') || d.msg_de;
const msgEn   = pick('preparationMessage_en', 'maintenanceMessage_en') || d.msg_en;

const siteName = settings.hero.siteName || 'VortexDeep';
const updated  = new Date().toLocaleDateString('de-CH', { year: 'numeric', month: 'long' });
---

{animDepthBg && (
  <DepthNetworkBackground
    nodeColor={settings.animations.depthBackground?.nodeColor || textColor}
    fogColor={settings.animations.depthBackground?.fogColor || bgColor}
    nodeCount={settings.animations.depthBackground?.nodeCount || undefined}
    connectDistance={settings.animations.depthBackground?.connectDistance || undefined}
    lineOpacity={settings.animations.depthBackground?.lineOpacity ?? undefined}
    nodeOpacity={settings.animations.depthBackground?.nodeOpacity ?? undefined}
    lightNodeColor={themeColors.light.text}
    lightFogColor={themeColors.light.bg}
    darkNodeColor={themeColors.dark.text}
    darkFogColor={themeColors.dark.bg}
  />
)}

{animPlanetary && (
  <PlanetarySystemsBackground
    starColor={settings.animations.planetarySystems?.starColor || textColor}
    fogColor={settings.animations.depthBackground?.fogColor || bgColor}
    systemCount={settings.animations.planetarySystems?.systemCount ?? undefined}
    maxPlanets={settings.animations.planetarySystems?.maxPlanets ?? undefined}
    orbitMinRadius={settings.animations.planetarySystems?.orbitMinRadius ?? undefined}
    orbitMaxRadius={settings.animations.planetarySystems?.orbitMaxRadius ?? undefined}
    pathOpacity={settings.animations.planetarySystems?.pathOpacity ?? undefined}
    lightStarColor={themeColors.light.text}
    lightFogColor={themeColors.light.bg}
    darkStarColor={themeColors.dark.text}
    darkFogColor={themeColors.dark.bg}
  />
)}

<!-- Soft scrim: knocks the animated field back so it reads as a subtle
     backdrop (the full homepage covers most of it with content sections;
     this screen leaves the whole field exposed, so without this the same
     0.21 line opacity looks much stronger). Sits above the canvas (z-index 0)
     and below the text (z-index 2). Tune the 0.55 to taste: higher = fainter
     background, lower = more visible. Set to 0 to show the field at full
     strength. -->
<div class="vd-status__scrim" aria-hidden="true"></div>

<main class="vd-status">
  <div class="vd-status__inner">
    <div class="vd-status__brand">{siteName}</div>

    <div class="vd-status__badge">
      <span class="vd-status__dot" aria-hidden="true"></span>
      <span>{badgeDe} · {badgeEn}</span>
    </div>

    <p class="vd-status__msg" lang="de">{msgDe}</p>
    <div class="vd-status__rule" aria-hidden="true"></div>
    <p class="vd-status__msg vd-status__msg--muted" lang="en">{msgEn}</p>

    <footer class="vd-status__foot">Stand · Last updated: {updated}</footer>
  </div>
</main>

<style>
  .vd-status__scrim {
    position: fixed;
    inset: 0;
    z-index: 1;               /* above canvas (0), below content (2) */
    pointer-events: none;
    background: var(--zen-bg);
    opacity: 0.55;            /* ← tune: higher = fainter background */
  }
  .vd-status {
    position: relative;
    z-index: 2;               /* above the fixed background canvas (z-index 0) */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    box-sizing: border-box;
    text-align: center;
  }
  .vd-status__inner {
    width: 100%;
    max-width: 560px;
    animation: vd-status-fade 1.1s ease both;
  }
  .vd-status__brand {
    font-size: clamp(22px, 5vw, 30px);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--zen-text);
  }
  .vd-status__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 30px;
    padding: 7px 16px;
    border: 1px solid var(--zen-muted);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--zen-muted);
    background: color-mix(in srgb, var(--zen-bg) 55%, transparent);
    backdrop-filter: blur(2px);
  }
  .vd-status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--zen-accent);
    box-shadow: 0 0 12px 1px var(--zen-accent);
    animation: vd-status-breathe 3.4s ease-in-out infinite;
  }
  .vd-status__msg {
    margin: 0 auto;
    max-width: 46ch;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--zen-text);
  }
  .vd-status__msg--muted { color: var(--zen-muted); }
  .vd-status__rule {
    width: 40px;
    height: 1px;
    margin: 22px auto;
    background: var(--zen-muted);
    opacity: 0.5;
  }
  .vd-status__foot {
    margin-top: 34px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--zen-muted);
    opacity: 0.8;
  }

  @keyframes vd-status-fade {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes vd-status-breathe {
    0%, 100% { opacity: 0.45; transform: scale(0.85); }
    50%      { opacity: 1;    transform: scale(1); }
  }
  /* The global reduced-motion safeguard in Layout.astro already neutralises
     these; this is just an explicit belt-and-braces for the dot + fade. */
  @media (prefers-reduced-motion: reduce) {
    .vd-status__inner { animation: none; }
    .vd-status__dot   { animation: none; opacity: 0.8; }
  }
</style>
