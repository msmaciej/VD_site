        <LanguageSwitcher lang={lang} slug="" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style={`color: ${zenText};`}
                  aria-label={lang === 'de' ? 'Hell-/Dunkelansicht wechseln' : 'Switch light/dark view'}>
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  <!-- ── FIXED FOOTER ── -->
  <footer class="vd-fixed-footer vd-load-fade" style={headerFooterBg}>
    {settings.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style={`color: ${zenText};`}>
          {icon}
        </a>
      );
    })}
    {settings.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style={`color: ${zenText};`}>·</span>
    )}
    <p class={`${settings.footerTextFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30`}
       style={`color: ${zenText}; font-family: ${fontFamily(activeFont)};`}>
      {settings.footerText
        ? settings.footerText
        : `© ${currentYear} ${settings.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <!-- ── BACKGROUND WRAPPER ── -->
  <div style={contentWrapperBg}>

    <!-- SCREEN 1: Hero -->
    <div class="vd-screen vd-load-fade">
      <div class="w-full max-w-xl text-center">
        {!settings.showSubSiteNameOnly && settings.siteName && (
          <h1 class={`${settings.siteNameFontSize || 'text-3xl md:text-4xl'} ${settings.siteNameFontWeight || 'font-thin'} text-center tracking-[0.5em] uppercase leading-none translate-x-[0.25em] ${animTextHover ? 'vd-hover-grow' : ''}`}
              style={textStyle(zenText, settings.siteNameFont)}>
            {settings.siteName}
          </h1>
        )}
        {subSiteName && (
          <h2 class={`${settings.subSiteNameFontSize || 'text-[13px]'} ${settings.subSiteNameFontWeight || 'font-thin'} text-center tracking-[0.25em] uppercase mt-6 leading-relaxed translate-x-[0.12em]`}
              style={`${textStyle(zenText, settings.subSiteNameFont)} opacity: 0.7;`}>
            {contentLines(subSiteName).map(({ line, dots }) => (
              dots > 0 ? (
                <span class="vd-dots block" style={`margin: ${dotGapY[dots] || '0.9rem'} 0;`} aria-hidden="true">
                  {Array.from({ length: dots }).map(() => <span></span>)}
                </span>
              ) : (
                <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line}</span>
              )
            ))}
          </h2>
        )}
      </div>
      <div class="vd-hint" style={`color: ${zenText};`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>

    <!-- SCREENS 2…N: Content sections -->
    {pageData.map((block: any) => {
      if (!block.enabled) return null;

      // ── Process Flow ──────────────────────────────────────────────────────
      if (block._template === 'processFlow') {
        const isVertical = block.orientation === 'vertical';
        const relayUid = blockUidMap.get(block);
        const connectorCount = Math.max((block.steps?.length ?? 1) - 1, 0);
        const flowDotsN = block.dotsPerConnector || defaultDotsPerConnector;
        const flowDotSize = block.dotSize || defaultDotSize;
        const flowGap = block.connectorGap ?? defaultConnectorGap;
        const flowStepSpacing = block.stepSpacing ?? defaultStepSpacing;
        const relayDuration = (block.flowSpeed || defaultFlowSpeed) * connectorCount;
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">
              {block.title && (
                <h2 class={`${block.titleFontSize || 'text-[11px]'} ${block.titleFontWeight || 'font-thin'} uppercase tracking-[1.2em] mb-12 opacity-60 translate-x-[0.6em]`}
                    style={textStyle(zenText, block.titleFont)}>
                  {block.title.split('|').map((line: string) => (
                    <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line.trim()}</span>
                  ))}
                </h2>
              )}
              <div class={`flex ${isVertical ? 'flex-col items-center gap-0' : 'flex-row flex-wrap items-center justify-center'}`}>
                {block.steps?.map((step: any, i: number) => (
                  <div class={`flex ${isVertical ? 'flex-col items-center' : 'flex-row items-center'}`}>
                    <span class={`${step.fontSize || block.stepFontSize || 'text-[11px]'} ${step.fontWeight || block.stepFontWeight || 'font-thin'} uppercase tracking-[0.25em] opacity-75`}
                          style={`${textStyle(zenText, step.font || block.stepFont)} ${isVertical ? `padding-top: ${flowStepSpacing}px; padding-bottom: ${flowStepSpacing}px;` : `padding-left: ${flowStepSpacing}px; padding-right: ${flowStepSpacing}px;`}`}>
                      {step.label}
                    </span>
                    {i < (block.steps?.length ?? 0) - 1 && (
                      isVertical ? (
                        <span class="vd-connector-v" style={`color: ${zenText}; gap: ${flowGap}px;`} aria-hidden="true">
                          {Array.from({ length: flowDotsN }).map((_, k) => (
                            <span class="vd-relay-dot"
                                  style={`width: ${flowDotSize}px; height: ${flowDotSize}px;${animFlow ? ` animation-name: vdRelayDot_${relayUid}_${i}_${k}; animation-duration: ${relayDuration}s;` : ''}`}></span>
                          ))}
                        </span>
                      ) : (
                        <span class="vd-connector" style={`color: ${zenText}; gap: ${flowGap}px;`} aria-hidden="true">
                          {Array.from({ length: flowDotsN }).map((_, k) => (
                            <span class="vd-relay-dot"
                                  style={`width: ${flowDotSize}px; height: ${flowDotSize}px;${animFlow ? ` animation-name: vdRelayDot_${relayUid}_${i}_${k}; animation-duration: ${relayDuration}s;` : ''}`}></span>
                          ))}
                        </span>
                      )
                    )}
                  </div>
                ))}
              </div>

              {/* Optional explainer + CTA. Lets a processFlow block do more than
                  draw steps — it can also say what the steps are for and hand the
                  visitor the door. Used by the Fit Check screen; the Our Process
                  block leaves both fields empty and renders exactly as before. */}
              {block.content && (
                <div class={`${block.fontSize || 'text-[15px]'} ${block.fontWeight || 'font-normal'} opacity-90 leading-relaxed max-w-lg mx-auto text-center mt-10`}
                     style={block.bodyFont ? `font-family: ${fontFamily(block.bodyFont)};` : ''}>
                  {contentLines(block.content).map(({ line, dots }) => (
                    dots > 0 ? (
                      <div class="vd-dots" style={`margin: ${dotGapY[dots] || '0.9rem'} 0;`} aria-hidden="true">
                        {Array.from({ length: dots }).map(() => <span></span>)}
                      </div>
                    ) : (
                      <p class={`mb-3 ${animTextHover ? 'vd-hover-grow' : ''}`}>{line}</p>
                    )
                  ))}
                </div>
              )}

              {block.ctaLabel && block.ctaUrl && (
                <div class="flex justify-center mt-10">
                  <a href={lang === 'de' && block.ctaUrl.startsWith('/') ? `/de${block.ctaUrl}` : block.ctaUrl}
                     class="vd-cta text-[11px]"
                     style={`color: ${zenText};`}>
                    {block.ctaLabel}
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      }

      // ── Case Study ────────────────────────────────────────────────────────
      if (block._template === 'caseStudy') {
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">

              <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.3em] opacity-40 mb-2 translate-x-[0.15em]`}
                 style={textStyle(zenText, block.metaFont)}>
                {t.caseStudyTag}
              </p>

              <h2 class={`${block.titleFontSize || 'text-[13px]'} ${block.titleFontWeight || 'font-bold'} uppercase tracking-[1.2em] mb-1 opacity-60 translate-x-[0.6em] ${animTextHover ? 'vd-hover-grow' : ''}`}
                  style={textStyle(zenText, block.titleFont)}>
                {block.industry || 'Industry'}
              </h2>

              {/* Optional, and deliberately opt-in: a case study only names the
                  client when the client has said yes. Empty = anonymous, exactly
                  as before. */}
              {block.client && (
                <p class={`${block.labelFontSize || 'text-[11px]'} uppercase tracking-[0.25em] opacity-55 mb-1 translate-x-[0.125em]`}
                   style={textStyle(zenText, block.metaFont)}>
                  {block.client}
                </p>
              )}

              {block.location && (
                <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30 translate-x-[0.125em]
                  mb-6 md:mb-12`}
                   style={textStyle(zenText, block.metaFont)}>
                  {block.location}
                </p>
              )}

              {/* FIX 7: gap-4 on mobile saves ~64px on phones without changing desktop layout */}
              <div class="grid grid-cols-1 gap-4 md:gap-8 text-left mb-6 md:mb-10">

                {block.challenge && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont)}>{t.challenge}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(zenText, block.bodyFont)}>
                      {streamLines(block.challenge).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.built && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont)}>{t.built}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(zenText, block.bodyFont)}>
                      {streamLines(block.built).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.result && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont)}>{t.result}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(zenText, block.bodyFont)}>
                      {streamLines(block.result).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="flex justify-center gap-10 opacity-30">
                {block.package && (
                  <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.2em]`}
                     style={textStyle(zenText, block.metaFont)}>
                    {t.packageLabel}: {block.package}
                  </p>
                )}
                {block.timeline && (
                  <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.2em]`}
                     style={textStyle(zenText, block.metaFont)}>
                    {t.timelineLabel}: {block.timeline}
                  </p>
                )}
              </div>

            </div>
          </div>
        );
      }

      if (block._template === 'testimonial') {
        const attribution = [block.attributionName, block.attributionOrg].filter(Boolean).join(' — ');
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">

              <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.3em] opacity-40 mb-6 translate-x-[0.15em]`}
                 style={`color: ${zenText};`}>
                {t.testimonialTag}
              </p>

              {block.quote && (
                <blockquote class={`${block.quoteFontSize || 'text-[15px]'} ${block.quoteFontWeight || 'font-thin'} leading-relaxed opacity-80 mb-6 ${animTextHover ? 'vd-hover-grow' : ''}`}
                     style={textStyle(zenText)}>
                  “{block.quote}”
                </blockquote>
              )}

              {attribution && (
                <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-40`}
                   style={`color: ${zenText};`}>
                  {attribution}
                </p>
              )}

            </div>
          </div>
        );
      }

      // ── Standard content section ──────────────────────────────────────────
      return (
        <div class="vd-screen vd-reveal">
          <div class="w-full max-w-2xl text-center">

            {block.title && (
              <h2 class={`${block.titleFontSize || 'text-[11px]'} ${block.titleFontWeight || 'font-normal'} uppercase tracking-[0.4em] translate-x-[0.2em] mb-8 opacity-90`}
                  style={textStyle(zenText, block.titleFont)}>
                {block.title.split('|').map((line: string) => (
                  <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line.trim()}</span>
                ))}
              </h2>
            )}

            {block.subTitle && (
              <h3 class={`${block.subTitleFontSize || 'text-[11px]'} ${block.subTitleFontWeight || 'font-normal'} uppercase tracking-[0.15em] mb-3 opacity-70`}
                  style={textStyle(zenText, block.subTitleFont)}>
                {contentLines(block.subTitle).map(({ line, dots }) => (
                  dots > 0 ? (
                    <span class="vd-dots block" style={`margin: ${dotGapY[dots] || '0.9rem'} 0;`} aria-hidden="true">
                      {Array.from({ length: dots }).map(() => <span></span>)}
                    </span>
                  ) : (
                    <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line}</span>
                  )
                ))}
              </h3>
            )}

            {/* Folding groups. Ten flat labels is a wall; four is a map. The open
                marker is the same dot as everything else on the site — no chevrons,
                no plus signs, no borders. Exactly one group is open at a time. */}
            {block.groups?.length > 0 && (
              <div class="vd-acc max-w-md mx-auto mb-8" data-vd-acc>
                {block.groups.map((g: any, i: number) => (
                  <div class="vd-acc-item" data-vd-acc-item data-open={i === 0 ? 'true' : 'false'}>
                    <button type="button" class="vd-acc-head" data-vd-acc-head style={`color: ${zenText};`}>
                      <span class="vd-acc-dot" aria-hidden="true"></span>
                      <span class={`vd-acc-label ${block.subTitleFontSize || 'text-[13px]'}`}>{g.label}</span>
                    </button>
                    <div class="vd-acc-body" data-vd-acc-body>
                      <div class="vd-acc-inner">
                        {g.items?.map((it: any) => (
                          <span class="vd-acc-sub text-[11px]" style={`color: ${zenText};`}>{it.label}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {block.content && (
              <div class={`${block.fontSize || 'text-[15px]'} ${block.fontWeight || 'font-normal'} opacity-90 leading-relaxed max-w-lg mx-auto text-center`}
                   style={block.bodyFont ? `font-family: ${fontFamily(block.bodyFont)};` : ''}>
                {contentLines(block.content).map(({ line, dots }) => (
                  dots > 0 ? (
                    <div class="vd-dots" style={`margin: ${dotGapY[dots] || '0.9rem'} 0;`} aria-hidden="true">
                      {Array.from({ length: dots }).map(() => <span></span>)}
                    </div>
                  ) : (
                    <p class={`mb-3 ${animTextHover ? 'vd-hover-grow' : ''}`}>{line}</p>
                  )
                ))}
              </div>
            )}

            {(block.email || block.phone) && (
              <div class="flex justify-center items-center gap-6 mt-10">
                {block.email && (
                  <a href={`mailto:${block.email}`}
                     class="opacity-60 hover:opacity-100 transition-opacity tracking-[0.15em] text-[11px] translate-x-[0.075em]"
                     style={`color: ${zenText};`}>
                    {block.email}
                  </a>
                )}
                {block.email && block.phone && (
                  <span class="vd-dots" aria-hidden="true" style={`color: ${zenText};`}><span></span></span>
                )}
                {block.phone && (
                  <a href={`tel:${block.phone.replace(/[^+0-9]/g, '')}`}
                     class="opacity-60 hover:opacity-100 transition-opacity tracking-[0.15em] text-[11px] translate-x-[0.075em]"
                     style={`color: ${zenText};`}>
                    {block.phone}
                  </a>
                )}
              </div>
            )}

            {block.showArt && (
              <div class="w-full mt-10">
                <div class="flex flex-wrap justify-center gap-16 lg:gap-24 w-full">
                  {artFiles.filter(p => p.default.enabled).map((piece) => (
                    <div class={`${widthMap[block.columns] || 'md:w-[calc(33.333%-3rem)]'} w-full`}>
                      <ArtCard {...piece.default} />
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      );
    })}

  </div>
</Layout>

<script>
  // Folding groups: clicking a head opens it and folds whichever was open.
  // Deliberately not a <details> element — those come with a disclosure triangle
  // and a browser-default animation, and both are foreign to this design.
  document.querySelectorAll('[data-vd-acc]').forEach((acc) => {
    const items = Array.from(acc.querySelectorAll('[data-vd-acc-item]'));
    items.forEach((item) => {
      const head = item.querySelector('[data-vd-acc-head]');
      head?.addEventListener('click', () => {
        const wasOpen = item.getAttribute('data-open') === 'true';
        items.forEach((o) => o.setAttribute('data-open', 'false'));
        item.setAttribute('data-open', wasOpen ? 'false' : 'true');
      });
    });
  });

  // Original reveal animation — fires when 40% of a section is visible after snap
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('vd-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { root: null, threshold: 0.1 }
  );
  document.querySelectorAll('.vd-reveal').forEach(el => observer.observe(el));

  // Logo: scroll to top when already on the home page
  const logoLink = document.querySelector('.vd-fixed-header a');
  if (logoLink) {
    logoLink.addEventListener('click', (e) => {
      const target = new URL(logoLink.getAttribute('href'), location.href);
      if (target.pathname === location.pathname) {
        e.preventDefault();
        document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // Process-flow connectors are pure CSS now — one relay dot per connector,
  // sharing a single generated keyframe timeline per block (see
  // dotPulseKeyframes() in the frontmatter above). No animation script needed.

</script>
