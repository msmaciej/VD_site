---
// src/components/SitePage.astro
// Shared template for the main scroll page — used by both index.astro (EN) and de/index.astro (DE).
// Data is loaded by the calling page file via Astro.glob and passed in as props.

import Layout from '../layouts/Layout.astro';
import ArtCard from './ArtCard.astro';
import Fold from './Fold.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import DepthNetworkBackground from './DepthNetworkBackground.astro';
import PlanetarySystemsBackground from './PlanetarySystemsBackground.astro';
import { ui, type Lang } from '../i18n/ui.ts';
import { themeColors, themeFamily, fontFamily, textStyle, socialIcon, fontSizeClass, fontSizePx, trackingEm, fontWeightNumber } from '../utils/siteHelpers.ts';

interface Props {
  lang:     Lang;
  pageData: any[];
  settings: any;
  artFiles: any[];
}

const { lang, pageData, settings, artFiles } = Astro.props;
const t = ui[lang];

// Data page on/off — a section's "/data" button hides itself when the page is off.
const dataPageDocs = await Astro.glob('../content/dataPage/*.json');
const dataPageDoc = (dataPageDocs.find((d: any) => d.default?.lang === lang)
  || dataPageDocs.find((d: any) => d.default?.lang === 'en'))?.default || {};
const dataPageEnabled = (dataPageDoc as any).enabled !== false;

// Fit Check master switch — off hides the header nav link, any CTA button
// pointing at /check (incl. the home-page teaser block's own button), and
// (in check.astro / de/check.astro) blocks the quiz itself. See
// tina/fitcheck-schema.ts's "enabled" field for the single source of truth.
const fitCheckDocs = await Astro.glob('../content/fitcheck/*.json');
const fitCheckDoc = (fitCheckDocs[0]?.default || {}) as any;
const fitCheckEnabled = fitCheckDoc.enabled !== false;

// ── Theme & font ──────────────────────────────────────────────────────────────
const currentTheme = settings.appearance.theme || 'light';
const currentYear  = new Date().getFullYear();

const activeFont = (settings.appearance.fontPreset === 'custom' && settings.appearance.customFontName)
  ? settings.appearance.customFontName
  : (settings.appearance.fontPreset || 'Inter');

const activeFontFamily = fontFamily(activeFont);

const allFontsUrl = "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@100;200;300;400;500;600;700&family=Inter:wght@100;300;400;500;600;700&family=Lora:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Space+Mono:wght@400;700&family=Newsreader:ital,wght@0,100;0,300;0,400;0,700;1,400&display=swap";

// ── Colour helpers ────────────────────────────────────────────────────────────
const getBgColor = () => {
  if (settings.appearance.customBackgroundColor) return settings.appearance.customBackgroundColor;
  return themeColors[currentTheme]?.bg || '#ffffff';
};
const getTextColor = (customColor?: string) => {
  const base = customColor || settings.appearance.baseTextColor;
  if (!base) return themeColors[currentTheme]?.text || '#0a0a0a';
  return base;
};

// zenText/zenBg: plain CSS-variable references for the many inline
// `style="color: ..."` spots below. Unlike getTextColor()/getBgColor()
// (which resolve to a literal hex, still needed for Three.js canvas props
// and the color-mix() translucency below), these let the DOM keep
// responding when the visitor toggles the theme client-side, since
// var(--zen-text) re-reads whatever --zen-text currently resolves to
// rather than freezing a value at build time.
const zenText = 'var(--zen-text)';
const zenBg   = 'var(--zen-bg)';

// ── Theme toggle (sun/moon) ───────────────────────────────────────────────
const themeToggleEnabled = settings.appearance.enableThemeToggle === true;
// Classified from the *effective* background (custom override included, via
// getBgColor()) rather than the preset name — see themeFamily()'s doc comment.
const autoFamily = themeFamily(getBgColor());

// ── Layout dimensions ─────────────────────────────────────────────────────────
const headerHeight     = settings.layout.headerHeight     || '52px';
const footerHeight     = (settings.layout.matchFooterToHeader === false)
  ? (settings.layout.footerHeight || '52px')
  : headerHeight;
const headerInnerWidth = settings.layout.headerInnerWidth || '680px';

// ── Gallery column map ────────────────────────────────────────────────────────
const widthMap: Record<string, string> = {
  'grid-cols-2': 'md:w-[calc(50%-2rem)]',
  'grid-cols-3': 'md:w-[calc(33.333%-3rem)]',
  'grid-cols-4': 'md:w-[calc(25%-4rem)]',
};

// ── Lang-aware settings ───────────────────────────────────────────────────────
const subSiteName = lang === 'de'
  ? (settings.hero.subSiteName_de   || settings.hero.subSiteName)
  : settings.hero.subSiteName;

// Notice banner — small editable strip under the header (toggle in Site Settings).
const noticeBannerText = lang === 'de'
  ? (settings.noticeBanner.noticeBannerText_de || settings.noticeBanner.noticeBannerText_en)
  : (settings.noticeBanner.noticeBannerText_en || settings.noticeBanner.noticeBannerText_de);
const showNoticeBanner = settings.noticeBanner.noticeBannerEnabled && !!noticeBannerText;
const noticeBannerBody = lang === 'de'
  ? (settings.noticeBanner.noticeBannerBody_de || settings.noticeBanner.noticeBannerBody_en)
  : (settings.noticeBanner.noticeBannerBody_en || settings.noticeBanner.noticeBannerBody_de);
const noticeBannerStyle = settings.noticeBanner.noticeBannerStyle || 'ribbon';
const noticeFlowSecs    = settings.noticeBanner.noticeBannerFlowSeconds || '34';
// Reserved height for the persistent notice bar (ribbon/pill sit fixed under the
// header on every screen). Stacked stays hero-only, so it reserves nothing.
const noticeH = (!showNoticeBanner || noticeBannerStyle === 'stacked')
  ? '0px'
  : (noticeBannerStyle === 'pill' ? '38px' : '32px');
// Banner dot: 'static' (steady glow, default), 'animated' (pulses), or 'none'.
const noticeDot = settings.noticeBanner.noticeBannerDot || 'static';
// Site-wide typography defaults (Site Settings → Typography). Blocks inherit
// these unless they set their own size/weight. blank/undefined = fall through.
const typo = (settings.typography || {}) as any;

// The accordion system (Work We Take Off You), CTA buttons, the fold
// "More/Less" toggle, contact links, and footer icons were all fixed CSS
// with no Tina field at all. Now driven by Label / Body — each keeps its own
// current value as the fallback, so nothing moves until you set something.
const acc = {
  labelWeight: typo.label?.weight ? fontWeightNumber(typo.label.weight) : '400',
  labelTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.22em',
  labelOpacity: typo.label?.opacity ?? 50,
  subSize: typo.label?.size ? fontSizePx(typo.label.size) : '12px',
  subTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.15em',
  subOpacity: typo.label?.opacity ?? 40,
  introSize: typo.body?.size ? fontSizePx(typo.body.size) : '12px',
  introOpacity: typo.body?.opacity ?? 60,
  copySize: typo.body?.size ? fontSizePx(typo.body.size) : '12px',
  copyOpacity: typo.body?.opacity ?? 58,
  ctaTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.3em',
  ctaOpacity: typo.label?.opacity ?? 75,
  cueSize: typo.label?.size ? fontSizePx(typo.label.size) : '11px',
  cueTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.22em',
  cueOpacity: typo.label?.opacity ?? 50,
  iconTracking: typo.label?.tracking ? trackingEm(typo.label.tracking) : '0.03em',
  labelFont: typo.label?.font ? fontFamily(typo.label.font) : null,
  bodyFont2: typo.body?.font ? fontFamily(typo.body.font) : null,
};
const noticeTextSize     = fontSizePx(settings.noticeBanner.noticeBannerTextFontSize || typo.noticeBannerText?.size, 'xs');
const noticeTextWeight   = settings.noticeBanner.noticeBannerTextFontWeight || typo.noticeBannerText?.weight || '400';
const noticeTextFont     = settings.noticeBanner.noticeBannerFont || typo.noticeBannerText?.font;
const noticeTextOpacity  = settings.noticeBanner.noticeBannerOpacity ?? typo.noticeBannerText?.opacity;
const noticeTextTracking = trackingEm(settings.noticeBanner.noticeBannerTracking || typo.noticeBannerText?.tracking);
const noticeBodySize     = fontSizePx(settings.noticeBanner.noticeBannerBodyFontSize || typo.noticeBannerBody?.size, 'xs');
const noticeBodyWeight   = settings.noticeBanner.noticeBannerBodyFontWeight || typo.noticeBannerBody?.weight || '400';
const noticeBodyFont     = settings.noticeBanner.noticeBannerBodyFont || typo.noticeBannerBody?.font;
const noticeBodyOpacity  = settings.noticeBanner.noticeBannerBodyOpacity ?? typo.noticeBannerBody?.opacity;
const noticeBodyTracking = trackingEm(settings.noticeBanner.noticeBannerBodyTracking || typo.noticeBannerBody?.tracking);

const metaTitle = lang === 'de'
  ? (settings.seo.metaTitle_de     || settings.seo.metaTitle     || 'VortexDeep — KI-Automatisierung für KMU in Zürich')
  : (settings.seo.metaTitle        || `${settings.hero.siteName || 'VortexDeep'} — Practical AI Automation for Small Business`);

const metaDescription = lang === 'de'
  ? (settings.seo.metaDescription_de || settings.seo.metaDescription || 'KI-Automatisierung für KMU in Zürich.')
  : (settings.seo.metaDescription    || 'VortexDeep helps small businesses adopt practical AI automation. Based in Zürich, Switzerland.');

// ── Fold cue defaults (lang-aware) ────────────────────────────────────────────
// The visible word on a 'dot-label' cue defaults to a friendly "More"/"Mehr"
// when an editor hasn't typed one; the accessible names come from i18n so a
// dot-only cue still announces itself to screen readers on both language routes.
const foldMoreDefault = lang === 'de' ? 'Mehr' : 'More';
const foldLessDefault = lang === 'de' ? 'Weniger' : 'Less';
const foldAriaClosed  = t.foldMore;
const foldAriaOpen    = t.foldLess;

// ── Lang-aware nav links (label_de + /de prefix on URLs) ─────────────────────
const homeUrl = lang === 'de' ? '/de/' : '/';
// The Fit Check master switch hides its own nav entry — matched on the
// stored (un-prefixed) url before the lang-prefix step below.
const resolvedNavLinks = (settings.header.navLinks || [])
  .filter((link: any) => fitCheckEnabled || link.url !== '/check')
  .map((link: any) => ({
    label: lang === 'de' ? (link.label_de || link.label) : link.label,
    url:   lang === 'de' ? `/de${link.url}` : link.url,
  }));

// ── JSON-LD structured data ───────────────────────────────────────────────────
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": settings.hero.siteName || "VortexDeep",
  "description": metaDescription,
  "url": settings.seo.siteUrl || "https://vortexdeep.ch",
  "email": settings.seo.contactEmail || "info@vortexdeep.ch",
  ...(settings.seo.contactPhone ? { "telephone": settings.seo.contactPhone } : {}),
  "address": {
    "@type": "PostalAddress",
    "streetAddress":   settings.seo.addressStreet  || "",
    "addressLocality": settings.seo.addressCity    || "Zürich",
    "postalCode":      settings.seo.addressPostal  || "",
    "addressCountry":  "CH",
  },
  "areaServed": [
    { "@type": "City",    "name": "Zürich" },
    { "@type": "Country", "name": "Switzerland" },
  ],
  "serviceType": lang === 'de' ? "KI-Automatisierungsberatung" : "AI Automation Consulting",
  "priceRange": "$$",
  "sameAs": (settings.footer.socialLinks || []).map((l: any) => l.url).filter(Boolean),
};

// ── Animation toggles ──────────────────────────────────────────────────────────
// Each defaults to ON (!== false, not === true) so existing content with no
// value saved for these fields yet keeps animating exactly as it does today —
// this is opt-out from the CMS, not opt-in.
const animLogo    = settings.animations.enableLogoAnimation        !== false;
const animDot     = settings.animations.enableStatusDot            !== false;
const animFlow    = settings.animations.processFlow?.enabled !== false;
const animCascade = settings.animations.enableCascadeReveal        !== false;
const animTextHover = settings.animations.enableTextHover          !== false;
// Unlike the other five toggles, this one defaults OFF ('none', not an
// opt-out default) — it's a much bigger visual commitment than a quiet dot
// or a hover nudge, and should be something someone deliberately turns on
// for a theme, not something that silently appears site-wide the first
// time this code ships.
//
// backgroundStyle replaces two independent booleans (enableDepthBackground,
// enablePlanetarySystems) that used to allow both three.js renderers to run
// at once. It's a single select now, so at most one can ever be active.
const backgroundStyle = settings.animations.backgroundStyle || 'none';
const animDepthBg = backgroundStyle === 'depth';
const animPlanetary = backgroundStyle === 'planetary';
const anyFixedBackground = animDepthBg || animPlanetary; // either one needs the same translucency + z-index treatment below

// ── Fixed-background translucency ───────────────────────────────────────────
// When any fixed background layer (depth network, planetary systems) is on,
// the header/footer/content backgrounds switch from fully opaque to a
// translucent version of the same color, so the moving background shows
// through instead of being hidden behind a solid panel. Text itself stays at
// full opacity — only the background layer is see-through — since fading the
// whole element (via CSS opacity) would wash out the text too, not just
// reveal what's behind it.
// Kept for the Three.js canvas props further down, which need a literal hex,
// not a CSS variable — WebGL can't parse color-mix()/var() strings.
const hexToRgba = (hex: string, alpha: number) => {
  const clean = (hex || '#000000').replace('#', '');
  const full = clean.length === 3 ? clean.split('').map((c) => c + c).join('') : clean;
  const num = parseInt(full, 16) || 0;
  return `rgba(${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}, ${alpha})`;
};
const headerFooterBg = anyFixedBackground
  ? `background-color: color-mix(in srgb, ${zenBg} 70%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);`
  : `background-color: ${zenBg};`;
const contentWrapperBg = anyFixedBackground
  ? `background-color: color-mix(in srgb, ${zenBg} 82%, transparent); position: relative; z-index: 1;`
  : `background-color: ${zenBg};`;
// Every connector previously ran its own independent, continuously-looping
// comet — since they all loop on their own schedule, several were visibly
// active at once ("dots everywhere"). Instead: all connectors in one
// processFlow block share a single master cycle. Each connector's dot is
// only non-transparent during its own back-to-back slice of that shared
// timeline — the rest of the time it's invisible — so only one dot is ever
// visibly moving, handing off from connector to connector down the chain.
// Pure CSS (no JS position measurement, no resize handling needed) because
// each dot is fixed in place — only its opacity animates, nothing moves.
const defaultFlowSpeed = 2;          // seconds "owned" by each connector, if a block doesn't override it
const defaultDotsPerConnector = 4;   // how many fixed dots sit between each pair of steps, if not overridden
const defaultDotSize = 3;            // px
const defaultDotRestOpacity = 0.14;  // "light grey" resting look
const defaultDotPeakOpacity = 0.85;  // "dark" look when the flow passes through
const defaultConnectorGap = 8;       // px, direct spacing between adjacent dots
const defaultStepSpacing = 12;       // px, padding on each label's connector-facing side

// Generates the keyframes for ONE specific dot (connector i, dot k of
// dotsN) within the block's shared master cycle. The dot itself never
// moves — only its opacity rises to peakOpacity and back down again. Each
// dot still peaks at its own evenly-spaced moment (same cascading hand-off
// timing as before), but the rise/fall is deliberately wider than its own
// slice of the cycle, so it overlaps with its neighbors on both sides — one
// dot is already brightening before the previous one has fully dimmed.
// That overlap is what turns this into a flowing wave passing through the
// row instead of a strict relay of isolated flashes with dead air between
// them.
function dotPulseKeyframes(
  name: string, i: number, k: number, count: number,
  dotsN: number, restOpacity: number, peakOpacity: number,
) {
  const slot = 100 / count;                // this connector's share of the full cycle
  const dotSlot = slot / dotsN;            // this dot's own share of the connector's slot
  const mid = i * slot + k * dotSlot + dotSlot * 0.5; // this dot's peak moment — evenly spaced

  const spread = dotSlot * 1.7;            // wider than dotSlot on purpose — overlaps neighboring dots' windows
  const riseStart = mid - spread / 2;
  const fallEnd   = mid + spread / 2;

  const raw: [number, string][] = [
    [0,         `opacity: ${restOpacity};`],
    [riseStart, `opacity: ${restOpacity};`],
    [mid,       `opacity: ${peakOpacity};`],
    [fallEnd,   `opacity: ${restOpacity};`],
    [100,       `opacity: ${restOpacity};`],
  ];

  // Map de-dupes identical percentage stops (e.g. the very first dot's own
  // "base" coincides with the fixed 0% bookend) — last write wins, values
  // match since both represent the same rest state.
  const stops = new Map<string, string>();
  raw
    .sort((a, b) => a[0] - b[0])
    .forEach(([pct, decl]) => {
      const key = `${Math.min(100, Math.max(0, pct)).toFixed(3)}%`;
      stops.set(key, decl);
    });
  const body = Array.from(stops.entries()).map(([pct, decl]) => `${pct} { ${decl} }`).join(' ');
  return `@keyframes ${name} { ${body} }`;
}

// Pre-pass over pageData: assign each processFlow block a stable id and
// generate every connector's dots' keyframes up front, so the render pass
// below can just reference them by name. blockUidMap uses object identity —
// safe here since it's the same array being iterated both times.
const blockUidMap = new Map<any, string>();
let relayCss = '';
{
  let pfCounter = 0;
  pageData.forEach((block: any) => {
    if (block.enabled && block._template === 'processFlow') {
      const uid = `pf${pfCounter++}`;
      blockUidMap.set(block, uid);
      const count = Math.max((block.steps?.length ?? 1) - 1, 0);
      const dotsN = block.dotsPerConnector || defaultDotsPerConnector;
      const rest  = block.dotRestOpacity ?? defaultDotRestOpacity;
      const peak  = block.dotPeakOpacity ?? defaultDotPeakOpacity;
      if (count > 0 && animFlow) {
        for (let i = 0; i < count; i++) {
          for (let k = 0; k < dotsN; k++) {
            relayCss += dotPulseKeyframes(`vdRelayDot_${uid}_${i}_${k}`, i, k, count, dotsN, rest, peak) + '\n';
          }
        }
      }
    }
  });
}
// Splits a '|'-delimited string into lines and returns each with an
// incrementing transition-delay, so the lines populate in sequence rather
// than all at once when the parent .vd-reveal section becomes visible.
// When the cascade-reveal toggle is off, every line gets the same fixed
// delay instead — they still use the same fade+rise transition (so nothing
// looks broken), they just all arrive together as one block, same as every
// other section on the page.
const streamLines = (text: string, startDelay = 0.25, step = 0.14) =>
  text.split('|').map((line: string, i: number) => ({
    text: line.trim(),
    delay: animCascade ? `${(startDelay + i * step).toFixed(2)}s` : `${startDelay.toFixed(2)}s`,
  }));

// ── Dot dividers ──────────────────────────────────────────────────────────────
// The `...` / `..` / `.` marks authored into the copy are not punctuation and
// they are not typos — they are the same motif as the depth-network background
// and the processFlow connectors. They were only ever *typed* because there was
// nowhere to draw them. Here they get drawn.
//
// Any '|'-delimited segment consisting solely of dots (and whitespace) is
// lifted out of the reading flow and rendered as a row of small centred
// circles instead of as a <p>. The authored count is preserved as rhythm:
// ... opens a screen, .. separates groups, . closes. Vertical margin scales
// with the count, so a one-dot separator inside a ten-item list stays tight
// while a three-dot opener still breathes.
const DOT_ONLY = /^[.\s·]+$/;
const dotCount = (line: string) => (line.match(/[.·]/g) || []).length;
// No gap map. A dot row is a LINE — it occupies exactly one line of the rhythm,
// like any other line, whatever the dot count. The count says something about the
// copy (... opens, .. separates, . closes); it says nothing about spacing.

// Splits a '|'-delimited string into typed lines, tagging each segment as
// either a dot divider (with its count) or real text, so every caller renders
// the two the same way.
const contentLines = (text: string) =>
  text.split('|').map((raw: string) => {
    const line = raw.trim();
    const dots = DOT_ONLY.test(line) && line.length > 0 ? dotCount(line) : 0;
    return { line, dots };
  });

// Groups a '|'-delimited string into paragraphs. Consecutive text segments become
// LINES inside one paragraph — natural leading, no margin, because a pipe is a line
// break, exactly as authored. A dot-only segment closes the paragraph and renders as
// a drawn divider with generous margin. So: pipes break lines, dots break thought.
// Previously every pipe emitted its own <p class="mb-3">, so a line break in `content`
// opened a 12px gap while the identical break in `subTitle` did not — which is why the
// same sentence looked airy in one field and compact in the other.
const contentGroups = (text: string) => {
  const out: Array<{ kind: 'text'; lines: string[] } | { kind: 'dots'; n: number }> = [];
  let run: string[] = [];
  for (const { line, dots } of contentLines(text)) {
    if (dots > 0) {
      if (run.length) { out.push({ kind: 'text', lines: run }); run = []; }
      out.push({ kind: 'dots', n: dots });
    } else if (line) {
      run.push(line);
    }
  }
  if (run.length) out.push({ kind: 'text', lines: run });
  return out;
};

---

<Layout
  lang={lang}
  title={metaTitle}
  theme={currentTheme}
  description={metaDescription}
  ogImage={settings.seo.ogImage || ''}
  siteUrl={settings.seo.siteUrl || 'https://vortexdeep.ch'}
  autoBg={getBgColor()}
  autoText={getTextColor()}
  autoFamily={autoFamily}
  themeToggleEnabled={themeToggleEnabled}
>
  <link rel="stylesheet" href={allFontsUrl} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  {animDepthBg && (
    <DepthNetworkBackground
      nodeColor={settings.animations.depthBackground?.nodeColor || getTextColor()}
      fogColor={settings.animations.depthBackground?.fogColor || getBgColor()}
      nodeCount={settings.animations.depthBackground?.nodeCount || undefined}
      connectDistance={settings.animations.depthBackground?.connectDistance || undefined}
      lineOpacity={settings.animations.depthBackground?.lineOpacity ?? undefined}
      nodeOpacity={settings.animations.depthBackground?.nodeOpacity ?? undefined}
      lightNodeColor={themeColors.light.text}
      lightFogColor={themeColors.light.bg}
      darkNodeColor={themeColors.dark.text}
      darkFogColor={themeColors.dark.bg}
    />
  )}

  {animPlanetary && (
    <PlanetarySystemsBackground
      starColor={settings.animations.planetarySystems?.starColor || getTextColor()}
      fogColor={settings.animations.depthBackground?.fogColor || getBgColor()}
      systemCount={settings.animations.planetarySystems?.systemCount ?? undefined}
      maxPlanets={settings.animations.planetarySystems?.maxPlanets ?? undefined}
      orbitMinRadius={settings.animations.planetarySystems?.orbitMinRadius ?? undefined}
      orbitMaxRadius={settings.animations.planetarySystems?.orbitMaxRadius ?? undefined}
      pathOpacity={settings.animations.planetarySystems?.pathOpacity ?? undefined}
      lightStarColor={themeColors.light.text}
      lightFogColor={themeColors.light.bg}
      darkStarColor={themeColors.dark.text}
      darkFogColor={themeColors.dark.bg}
    />
  )}

  <style is:global define:vars={{ activeFont, activeFontFamily, headerHeight, footerHeight, headerInnerWidth, noticeH,
    accLabelWeight: acc.labelWeight, accLabelTracking: acc.labelTracking, accLabelOpacity: acc.labelOpacity,
    accSubSize: acc.subSize, accSubTracking: acc.subTracking, accSubOpacity: acc.subOpacity,
    accIntroSize: acc.introSize, accIntroOpacity: acc.introOpacity,
    accCopySize: acc.copySize, accCopyOpacity: acc.copyOpacity,
    accCtaTracking: acc.ctaTracking, accCtaOpacity: acc.ctaOpacity,
    accCueSize: acc.cueSize, accCueTracking: acc.cueTracking, accCueOpacity: acc.cueOpacity,
    accIconTracking: acc.iconTracking,
    accLabelFont: acc.labelFont || activeFontFamily, accBodyFont: acc.bodyFont2 || activeFontFamily,
  }}>
    html, body { font-family: var(--activeFontFamily); }

    /* Nav link base opacity is now a flexible inline value (Typography →
       Header), so the hover-to-full-opacity effect can't use Tailwind's
       hover: utility (that only toggles a class, not an inline style) —
       this rule does the same job regardless of the configured base value. */
    .vd-nav-link { transition: opacity 0.2s ease; }
    .vd-nav-link:hover { opacity: 1 !important; }

    /* ── Scroll snap — original setup, unchanged ── */
    html {
      scroll-snap-type: y mandatory !important;
      overflow-y: scroll !important;
      height: 100% !important;
    }
    body {
      height: 100% !important;
      margin: 0 !important;
      overflow-y: visible !important;
      overflow-x: clip !important;
    }
    html::-webkit-scrollbar { display: none; }
    html { -ms-overflow-style: none; scrollbar-width: none; }

    /* ── Fixed Header ── */
    .vd-fixed-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--headerHeight);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
    }
    .vd-fixed-header-inner {
      width: 100%; max-width: var(--headerInnerWidth);
      display: flex; align-items: center; justify-content: space-between;
      /* FIX 9: clamp prevents the logo + nav from colliding on iPhone SE (320px).
         1rem on very narrow viewports, interpolates up to 2rem by ~500px. */
      padding: 0 clamp(1rem, 4vw, 2rem);
    }

    /* ── Fixed Footer ── */
    .vd-fixed-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      /* FIX 8: min-height + padding-bottom so the home indicator bar on iPhone X+
         (env(safe-area-inset-bottom) ≈ 34px) does not overlap the footer content.
         Older devices and desktop return 0px so layout is identical there. */
      min-height: var(--footerHeight);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
      gap: 1.2rem;
    }

    /* ── Social icons ── */
    .vd-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px;
      border: 1px solid currentColor;
      font-size: 8px; font-weight: 600;
      letter-spacing: var(--accIconTracking); text-transform: lowercase; text-decoration: none;
      border-radius: 3px; opacity: 0.35;
      transition: opacity 0.25s ease;
    }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    /* ── Theme toggle (sun/moon, single morphing icon) ─────────────────────
       One button, two stacked SVGs. Exactly one is visible at a time,
       decided purely by attributes on <html> (no JS needed to redraw —
       the click script in Layout.astro only ever flips those attributes):
         • No [data-theme-forced]  → "Current" (Auto). Shows whichever icon
           is OPPOSITE Current's own family — e.g. Current = deep (dark) ⇒
           shows the sun — at a light, clearly-inactive opacity. This is
           also exactly the icon the first click will activate.
         • [data-theme-forced="light"] → sun shown solid (selected).
         • [data-theme-forced="dark"]  → moon shown solid (selected).
       Both icons always occupy the same box (position: absolute) so the
       transition between them reads as one icon morphing into the other,
       rather than two separate elements. */
    .vd-theme-btn {
      position: relative;
      display: inline-flex; align-items: center; justify-content: center;
      width: 20px; height: 20px; padding: 0; border: none; background: none;
      cursor: pointer;
    }
    .vd-theme-icon {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transform: scale(0.4) rotate(-70deg);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    .vd-theme-icon svg { width: 100%; height: 100%; }

    /* Auto: opposite-of-current icon, dimmed — an invitation, not a selection */
    html:not([data-theme-forced])[data-auto-family="dark"]  .vd-theme-icon-sun  { opacity: 0.32; transform: scale(1) rotate(0deg); }
    html:not([data-theme-forced])[data-auto-family="light"] .vd-theme-icon-moon { opacity: 0.32; transform: scale(1) rotate(0deg); }
    /* Scoped to :not([data-theme-forced]) on purpose — once a choice is
       forced, the selected icon is already solid and should stay solid on
       hover, not dip back down toward the dimmed resting opacity. */
    html:not([data-theme-forced]) .vd-theme-btn:hover .vd-theme-icon { opacity: 0.62; }

    /* Forced: selected icon, fully solid, unaffected by hover */
    html[data-theme-forced="light"] .vd-theme-icon-sun  { opacity: 1; transform: scale(1) rotate(0deg); }
    html[data-theme-forced="dark"]  .vd-theme-icon-moon { opacity: 1; transform: scale(1) rotate(0deg); }

    /* ── Snap sections ── */
    .vd-screen {
      /* FIX 4: 100vh = full viewport incl. browser chrome on iOS Safari,
         so sections appear taller than the visible area → content clips under
         the address bar / toolbar. 100svh = "small viewport height" which always
         excludes the browser chrome. Browsers that don't support svh fall back
         to 100vh gracefully. */
      height: 100vh;
      height: 100svh;
      scroll-snap-align: start; scroll-snap-stop: always;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding-top: calc(var(--headerHeight) + var(--noticeH, 0px) + 12px);
      /* FIX 8 cont: match the footer's expanded height on notched phones */
      padding-bottom: calc(var(--footerHeight) + env(safe-area-inset-bottom, 0px) + 12px);
      padding-left: 1.5rem; padding-right: 1.5rem;
      box-sizing: border-box; position: relative;
    }

    /* ── Animations ── */
    .vd-load-fade { animation: vdLoad 1.8s cubic-bezier(0.4,0,0.2,1) forwards; }
    @keyframes vdLoad {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0);    }
    }

    /* ── Notice banner (under header) ── */
    .vd-notice-wrap { position:absolute; top:calc(var(--headerHeight) + 10px); left:0; right:0;
      display:flex; justify-content:center; padding:0; pointer-events:none; z-index:2; }
    .vd-notice-wrap > * { pointer-events:auto; }
    .vd-notice-row { width:100%; max-width:var(--headerInnerWidth); padding:2px clamp(1rem,4vw,2rem);
      display:flex; align-items:center; gap:16px; }
    .vd-notice-block { width:100%; max-width:var(--headerInnerWidth); padding:0 clamp(1rem,4vw,2rem); text-align:center; }
    .vd-notice-bar { position:fixed; top:var(--headerHeight); left:0; right:0; z-index:49;
      min-height:var(--noticeH,0px); display:flex; align-items:center; justify-content:center; }
    .vd-notice-dot { width:7px; height:7px; border-radius:50%; background:var(--zen-accent);
      box-shadow:0 0 11px 1px var(--zen-accent); flex:none; display:inline-block; }
    .vd-notice-dot--pulse { animation: vdNoticePulse 3s ease-in-out infinite; }
    @keyframes vdNoticePulse { 0%,100%{ opacity:1; box-shadow:0 0 11px 1px var(--zen-accent); }
      50%{ opacity:0.45; box-shadow:0 0 4px 0 var(--zen-accent); } }
    @media (prefers-reduced-motion: reduce){ .vd-notice-dot--pulse{ animation:none; } }
    .vd-notice-flow { flex:1; min-width:0; overflow:hidden;
      -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%);
      mask-image:linear-gradient(90deg,transparent 0,#000 8%,#000 92%,transparent 100%); }
    .vd-notice-track { display:inline-flex; white-space:nowrap; will-change:transform;
      animation: vdNoticeFlow var(--vdFlowSecs,34s) linear infinite; }
    .vd-notice-flow:hover .vd-notice-track { animation-play-state:paused; }
    @keyframes vdNoticeFlow { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    @media (prefers-reduced-motion: reduce){ .vd-notice-track{ animation:none; } }
    .vd-reveal {
      opacity: 0; transform: translateY(10px);
      transition: opacity 1.6s cubic-bezier(0.4,0,0.2,1),
                  transform 1.6s cubic-bezier(0.4,0,0.2,1);
      transition-delay: 0.15s;
    }
    .vd-reveal.vd-visible { opacity:1; transform:translateY(0); }

    /* ── Dot dividers ──────────────────────────────────────────────────────
       Drawn version of the ... / .. / . marks in the copy. Sized and faded to
       match the resting state of the processFlow connector dots and the nodes
       in the depth-network background, so the three read as one family. */
    .vd-dots {
      display: flex; justify-content: center; align-items: center;
      gap: 7px;
      /* One line tall, matching leading-relaxed on the surrounding text, so a dot
         row sits in the rhythm exactly where a line of text would — no margin, no
         gap, regardless of how many dots it holds. */
      height: 1.625em;
    }
    .vd-dots span {
      display: block;
      width: 3px; height: 3px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.32;
    }

    /* ── Folding groups ──────────────────────────────────────────────────────
       Three things this has to get right, all of which are easy to get wrong:

       1. overflow:hidden on the folding body. The 0fr→1fr grid trick only clips
          if the row actually clips — without it the sub-items paint outside the
          collapsed row for the length of the transition, which reads as a flicker.
       2. No padding change on the animating element. Padding that only exists in
          the open state jumps discretely at both ends of the transition; it lives
          on an inner wrapper instead, inside the clip.
       3. Reserved height on the whole group. This sits on a flex-centred 100svh
          screen, so if the accordion grows, the screen re-centres and the title
          and closing line visibly lurch. min-height freezes the composition: the
          dots and labels stay exactly where they are, and only the sub-areas move. */
    .vd-acc { min-height: 216px; } /* was 264px — reserved space so the body below
                                      the accordion doesn't jump when you switch
                                      groups. Trimmed to tighten the at-rest gap;
                                      raise it back toward 264 if a tall open group
                                      starts nudging the closing line. */
    .vd-acc-item { padding: 3px 0; }
    .vd-acc-head {
      display: flex; align-items: center; justify-content: center; gap: 12px;
      width: 100%; background: none; border: none; cursor: pointer;
      font-family: inherit; padding: 7px 0;
    }
    .vd-acc-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: currentColor; opacity: 0.28;
      transition: opacity 0.4s cubic-bezier(0.4,0,0.2,1);
      flex-shrink: 0;
    }
    .vd-acc-label {
      text-transform: uppercase; letter-spacing: var(--accLabelTracking);
      font-weight: var(--accLabelWeight); font-family: var(--accLabelFont);
      opacity: calc(var(--accLabelOpacity, 50) * 1%); transition: opacity 0.4s cubic-bezier(0.4,0,0.2,1);
    }
    .vd-acc-head:hover .vd-acc-label { opacity: 0.85; }
    .vd-acc-item[data-open="true"] .vd-acc-dot   { opacity: 0.9; }
    .vd-acc-item[data-open="true"] .vd-acc-label { opacity: 0.95; }
    .vd-acc-body {
      display: grid; grid-template-rows: 0fr;
      overflow: hidden;
      transition: grid-template-rows 0.55s cubic-bezier(0.4,0,0.2,1),
                  opacity 0.4s cubic-bezier(0.4,0,0.2,1);
      opacity: 0;
    }
    .vd-acc-item[data-open="true"] .vd-acc-body { grid-template-rows: 1fr; opacity: 1; }
    .vd-acc-inner {
      min-height: 0; overflow: hidden; padding-top: 8px;
      /* Nest the open group's contents in a narrower centred column so its
         sub-topics read as CHILDREN of the open group, visibly set in from the
         full-width top-level rows above and below it. */
      max-width: 22rem; margin-left: auto; margin-right: auto;
    }
    /* A breath of space below an open group before the next top-level group,
       so the nested block reads as one unit rather than merging into the list. */
    .vd-acc-item[data-open="true"] { padding-bottom: 14px; }
    .vd-acc-sub {
      display: block; text-transform: uppercase; letter-spacing: var(--accSubTracking);
      opacity: calc(var(--accSubOpacity, 40) * 1%); padding: 1px 0; font-size: var(--accSubSize);
      font-family: var(--accLabelFont);
    }
    /* ── Nested fold-out (Problems We Solve): group -> sub-topic names ->
       one description at a time. Keeps each open state small so the panel
       stays near one screen and never spills into the panel above. ── */
    .vd-acc-head { position: relative; scroll-margin-top: calc(var(--headerHeight) + 24px); }
    .vd-acc-close {
      position: absolute; right: 2px; top: 50%; transform: translateY(-50%);
      font-size: 15px; line-height: 1; opacity: 0; color: var(--zen-muted, currentColor);
      transition: opacity 0.3s; pointer-events: none;
    }
    .vd-acc-item[data-open="true"] .vd-acc-close { opacity: 0.55; }
    .vd-acc-intro {
      text-transform: none; letter-spacing: normal; font-family: var(--accBodyFont);
      font-size: var(--accIntroSize); line-height: 1.55; opacity: calc(var(--accIntroOpacity, 60) * 1%);
      max-width: 28rem; margin: 0 auto 12px; text-align: center;
    }
    .vd-acc-subs { border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent); margin-top: 4px; }
    .vd-acc-sub-item { border-bottom: 1px solid color-mix(in srgb, currentColor 8%, transparent); }
    .vd-acc-sub-item--static { padding: 11px 0; }
    .vd-acc-sub-head {
      display: flex; align-items: center; justify-content: center; gap: 9px;
      width: 100%; background: none; border: none; cursor: pointer;
      font-family: inherit; padding: 6px 0; /* row-to-row distance lever; ~5–8px is the sweet spot */
    }
    .vd-acc-sub-dot {
      width: 3px; height: 3px; border-radius: 50%; background: currentColor;
      opacity: 0.22; transition: opacity 0.35s; flex-shrink: 0;
    }
    .vd-acc-sub-head:hover .vd-acc-sub { opacity: 0.82; }
    .vd-acc-sub-item[data-open="true"] .vd-acc-sub-dot { opacity: 0.85; }
    .vd-acc-sub-item[data-open="true"] .vd-acc-sub { opacity: 0.9; }
    .vd-acc-sub-body {
      display: grid; grid-template-rows: 0fr; overflow: hidden; opacity: 0;
      transition: grid-template-rows 0.45s cubic-bezier(0.4,0,0.2,1), opacity 0.3s;
    }
    .vd-acc-sub-item[data-open="true"] .vd-acc-sub-body { grid-template-rows: 1fr; opacity: 1; }
    .vd-acc-sub-inner { min-height: 0; overflow: hidden; padding: 0 0 12px; }
    .vd-acc-copy {
      text-transform: none; letter-spacing: normal; font-family: var(--accBodyFont);
      font-size: var(--accCopySize); line-height: 1.6; opacity: calc(var(--accCopyOpacity, 58) * 1%);
      max-width: 27rem; margin: 5px auto 0; text-align: center;
    }
    .vd-acc-handled { opacity: calc(var(--accCopyOpacity, 58) * 1% + 20%); margin-top: 6px; }

    /* The groups section grows and top-aligns so an open fold-out flows
       DOWNWARD, never up into the panel above. It stays a snap target, so
       closing a group settles back on the Problems We Solve panel. */
    .vd-screen--groups {
      height: auto; min-height: 100svh;
      justify-content: flex-start;
      scroll-snap-stop: normal;
    }

    /* Tall process-flow sections (e.g. the Fit Check: title + six steps +
       explainer + CTA) can exceed a small phone's viewport. Let them grow and
       centre-or-top-flow via my-auto on the inner block, so the title never
       spills up into the section above. Longer German copy made this worse. */
    .vd-screen--flow {
      height: auto; min-height: 100svh;
      justify-content: flex-start;
      scroll-snap-stop: normal;
    }
    @media (prefers-reduced-motion: reduce) {
      .vd-acc-body { transition: none; }
    }

    /* ── Per-section fold + breathing cue ─────────────────────────────────────
       An opt-in fold for a section's body (or a processFlow's steps). At rest
       the content is clipped to nothing behind a small cue; a click unfolds it.
       Reuses the same 0fr→1fr grid clip as the accordion above (see the three
       gotchas documented there) so nothing paints outside the collapsed row.

       The cue is the site's own dot motif, never a chevron or plus sign. It
       BREATHES (a slow scale pulse) rather than sitting still, because a fold
       nobody notices is just hidden content — the motion is the discoverability.
       Brightness is deliberately kept OFF the breathing animation and on plain
       opacity instead, so hover and the open state can brighten the dot while it
       keeps breathing: rest 0.3 → hover 0.72 → open 0.9. Being a real <button>,
       it works on touch with no reliance on hover. */
    .vd-cue {
      display: inline-flex; align-items: center; justify-content: center; gap: 11px;
      background: none; border: none; cursor: pointer; font-family: inherit;
      padding: 10px 8px; margin: 6px auto 0;
    }
    .vd-cue-dots { display: inline-flex; align-items: center; gap: 7px; }
    .vd-cue-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      transition: opacity 0.4s cubic-bezier(0.4,0,0.2,1);
      animation: vdCueBreath 3s ease-in-out infinite;
    }
    /* A gentle left-to-right phase for the trio, echoing the connector relay —
       still the same single breathing motion, just handed along the row. */
    .vd-cue-dots .vd-cue-dot:nth-child(2) { animation-delay: 0.4s; }
    .vd-cue-dots .vd-cue-dot:nth-child(3) { animation-delay: 0.8s; }
    .vd-cue-label {
      text-transform: uppercase; letter-spacing: var(--accCueTracking); font-size: var(--accCueSize);
      font-family: var(--accLabelFont);
      opacity: calc(var(--accCueOpacity, 50) * 1%); transition: opacity 0.4s cubic-bezier(0.4,0,0.2,1);
    }
    /* The visible word swaps closed→open (More → Less), CSS-driven so there's
       no flash before JS runs. The JS still swaps the hidden aria-label. */
    .vd-cue-label-open { display: none; }
    [data-vd-fold][data-open="true"] .vd-cue-label-closed { display: none; }
    [data-vd-fold][data-open="true"] .vd-cue-label-open   { display: inline; }
    .vd-cue:hover .vd-cue-dot   { opacity: 0.72; }
    .vd-cue:hover .vd-cue-label { opacity: 0.85; }
    /* Open state: hold + brighten, and settle the breath so the cue reads as
       "opened" rather than still inviting — mirrors the accordion dot. */
    [data-vd-fold][data-open="true"] .vd-cue-dot {
      opacity: 0.9; animation-play-state: paused;
    }
    [data-vd-fold][data-open="true"] .vd-cue-label { opacity: 0.95; }

    @keyframes vdCueBreath {
      0%, 100% { transform: scale(1);    }
      50%      { transform: scale(1.42); }
    }

    .vd-fold-body {
      display: grid; grid-template-rows: 0fr; overflow: hidden; opacity: 0;
      transition: grid-template-rows 0.55s cubic-bezier(0.4,0,0.2,1),
                  opacity 0.4s cubic-bezier(0.4,0,0.2,1);
    }
    [data-vd-fold][data-open="true"] .vd-fold-body { grid-template-rows: 1fr; opacity: 1; }
    .vd-fold-inner { min-height: 0; overflow: hidden; padding-top: 14px; }

    @media (prefers-reduced-motion: reduce) {
      /* No breath and no slide — but keep the cue clearly visible (a touch
         brighter, since motion is what was carrying discoverability). */
      .vd-cue-dot { animation: none; opacity: 0.5; }
      .vd-fold-body { transition: opacity 0.3s ease; }
    }

    /* ── Inline CTA ── */
    .vd-cta {
      display: inline-block;
      border: 1px solid currentColor;
      border-color: color-mix(in srgb, currentColor 30%, transparent);
      padding: 0.85rem 1.9rem;
      text-transform: uppercase;
      letter-spacing: var(--accCtaTracking);
      font-family: var(--accLabelFont);
      opacity: calc(var(--accCtaOpacity, 75) * 1%);
      transition: opacity 0.35s cubic-bezier(0.4,0,0.2,1),
                  border-color 0.35s cubic-bezier(0.4,0,0.2,1);
    }
    .vd-cta:hover {
      opacity: 1;
      border-color: color-mix(in srgb, currentColor 60%, transparent);
    }

    /* ── Scroll hint ── */
    .vd-hint {
      position: absolute;
      bottom: calc(var(--footerHeight) + 1rem);
      left: 50%; transform: translateX(-50%);
      opacity: 0.2;
      animation: vdBounce 2.4s ease-in-out infinite;
    }
    @keyframes vdBounce {
      0%,100% { transform: translateX(-50%) translateY(0);   }
      50%      { transform: translateX(-50%) translateY(7px); }
    }

    /* ── NEW 1: Logo ink-draw ──────────────────────────────────────────────
       The wordmark svg is a hex node-graph. On load, the outline and the
       inner "V" stroke draw themselves in rather than just fading, so the
       mark reads as a network assembling itself — reinforcing "automation"
       without adding any new visual element. Fires once per full page load;
       it will not replay on Tina's in-place content patches, only on a
       real navigation / hard refresh. */
    .vd-logo polygon,
    .vd-logo polyline,
    .vd-logo path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: vdDraw 1.3s ease forwards;
    }
    .vd-logo polyline,
    .vd-logo path { animation-delay: 0.85s; }
    .vd-logo circle {
      opacity: 0;
      animation: vdDot 0.35s ease forwards 1.25s;
    }
    @keyframes vdDraw { to { stroke-dashoffset: 0; } }
    @keyframes vdDot  { to { opacity: 1; } }

    /* ── NEW 2: Breathing status dot ───────────────────────────────────────
       A single slow-pulsing dot beside the wordmark. Not language-gated —
       renders identically on every language route since this file is the
       single shared template for both / and /de/. */
    .vd-status-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      display: inline-block; margin-left: 8px;
      animation: vdBreathe 3s ease-in-out infinite;
    }
    @keyframes vdBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1);   }
      50%      { opacity: 0.85; transform: scale(1.5); }
    }

    /* ── NEW 3: Process-flow — dots that light up as the flow passes ────────
       Each connector between two steps is now a row of fixed dots (see
       dotsPerConnector, set per-block in Tina) instead of a line with something moving along
       it. The dots never move — only their opacity animates, from a resting
       "light grey" look up to a "dark" peak and back down, one at a time in
       sequence, generated per-dot in the frontmatter above and injected as
       raw CSS just below this style block (percentage breakpoints depend on
       step count, which plain CSS custom properties can't parameterize).
       This class just holds the shared layout + visual properties. */
    .vd-connector {
      display: flex; align-items: center;
      height: 8px; margin: 0 14px;
      vertical-align: middle; flex-shrink: 0;
    }
    .vd-connector-v {
      display: flex; flex-direction: column; align-items: center;
      width: 8px; margin: 6px auto;
    }
    .vd-relay-dot {
      width: 3px; height: 3px; border-radius: 50%;
      background: currentColor;
      opacity: 0.14;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      animation-iteration-count: infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .vd-relay-dot { animation: none; opacity: 0.14; }
    }

    /* ── NEW 4: Cascading line reveal ──────────────────────────────────────
       Individual lines inside a .vd-reveal section (case-study challenge /
       built / result fields) populate one after another instead of all at
       once — reading like an automated report filling in its fields in
       sequence, rather than a generic fade-up block. Delay is set per-line
       inline via streamLines() above; this class only defines the motion. */
    .vd-line {
      display: block;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.9s cubic-bezier(0.4,0,0.2,1),
                  transform 0.9s cubic-bezier(0.4,0,0.2,1);
    }
    .vd-visible .vd-line { opacity: 1; transform: translateY(0); }

    /* ── NEW 5: Text-line hover grow ─────────────────────────────────────────
       Individual text lines (body copy, case-study lines) scale up slightly
       on hover — a quiet way of making prose feel alive without turning it
       into a button. .vd-hover-grow alone handles plain lines; the .vd-line
       combination below preserves the cascade-reveal's own transform state
       (translateY) instead of clobbering it, so a line that's already
       settled into place on-screen doesn't jump when scaling on hover. */
    .vd-hover-grow {
      display: inline-block;
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      transform-origin: center;
    }
    .vd-hover-grow:hover { transform: scale(1.045); }

    /* Guards against load-order flukes between this stylesheet and Tailwind's
       compiled one — .block.vd-hover-grow (two classes) always outranks the
       single-class .vd-hover-grow{display:inline-block} above regardless of
       which stylesheet loads second, so title/subtitle line stacking can't
       silently break. */
    .block.vd-hover-grow { display: block; }

    .vd-line.vd-hover-grow { display: block; }
    .vd-visible .vd-line.vd-hover-grow:hover {
      transform: translateY(0) scale(1.045);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
    }

    @media (prefers-reduced-motion: reduce) {
      .vd-hover-grow:hover,
      .vd-visible .vd-line.vd-hover-grow:hover { transform: none; }
    }
  </style>

  <!-- Generated per-dot pulse keyframes — see dotPulseKeyframes() above.
       Raw CSS injected via set:html because the percentage breakpoints are
       computed from each block's step count at build time. -->
  <style is:global set:html={relayCss}></style>

  <!-- ── FIXED HEADER ── -->
  <header class="vd-fixed-header vd-load-fade" style={headerFooterBg}>
    <div class="vd-fixed-header-inner">
      <!-- Wordmark / logo -->
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity">
        {settings.appearance.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style={`color: ${zenText};`}
               class={`w-5 h-5 flex-shrink-0 ${animLogo ? 'vd-logo' : ''}`}>
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class={`${fontSizeClass(settings.header.wordmarkFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.wordmarkFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.wordmarkTracking || typo.header?.tracking || 'tracking-[0.4em]'}`}
              style={textStyle(zenText, settings.header.wordmarkFont || typo.header?.font || activeFont, settings.header.wordmarkOpacity ?? typo.header?.opacity ?? 100)}>
          {settings.hero.siteName || 'VortexDeep'}
        </span>
        {animDot && (
          <span class="vd-status-dot" style={`color: ${zenText};`} aria-hidden="true"></span>
        )}
      </a>

      <!-- Nav links + language switcher -->
      <nav class="flex gap-6 items-center" style={`color: ${zenText};`}>
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`vd-nav-link ${fontSizeClass(settings.header.headerLinksFontSize || typo.header?.size || 'text-[10px]')} ${settings.header.headerLinksFontWeight || typo.header?.weight || ''} ${typo.header?.uppercase !== false ? 'uppercase' : ''} ${settings.header.headerLinksTracking || typo.header?.tracking || 'tracking-[0.3em]'}`}
             style={textStyle(zenText, settings.header.headerLinksFont || typo.header?.font || activeFont, settings.header.headerLinksOpacity ?? typo.header?.opacity ?? 50)}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang={lang} slug="" />
        {themeToggleEnabled && (
          <button type="button" data-vd-theme-cycle
                  class="vd-theme-btn" style={`color: ${zenText};`}
                  aria-label={lang === 'de' ? 'Hell-/Dunkelansicht wechseln' : 'Switch light/dark view'}>
            <span class="vd-theme-icon vd-theme-icon-sun" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.2"/>
                <path d="M12 2.5v2.4M12 19.1v2.4M4.4 4.4l1.7 1.7M17.9 17.9l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.4 19.6l1.7-1.7M17.9 6.1l1.7-1.7"/>
              </svg>
            </span>
            <span class="vd-theme-icon vd-theme-icon-moon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.7 6.7 0 0 0 10.7 10.7Z"/>
              </svg>
            </span>
          </button>
        )}
      </nav>
    </div>
  </header>

  {showNoticeBanner && noticeBannerStyle !== 'stacked' && (
    <div class="vd-notice-bar vd-load-fade" role="status" style={headerFooterBg}>
      {noticeBannerStyle === 'ribbon' && (
        <div class="vd-notice-row">
          <span style={`display:inline-flex; align-items:center; gap:9px; flex:none; color:var(--zen-muted); font-size:${noticeTextSize}; font-weight:${noticeTextWeight}; letter-spacing:${noticeTextTracking || '0.2em'}; text-transform:uppercase; font-family:${fontFamily(noticeTextFont || activeFont)}; opacity:${noticeTextOpacity ?? 100}%;`}>
            {noticeDot !== 'none' && (<span aria-hidden="true" class={`vd-notice-dot ${noticeDot === 'animated' ? 'vd-notice-dot--pulse' : ''}`}></span>)}{noticeBannerText}
          </span>
          {noticeBannerBody && (
            <Fragment>
              <span style="width:1px; height:15px; background:var(--zen-muted); opacity:0.5; flex:none;"></span>
              <div class="vd-notice-flow">
                <div class="vd-notice-track" style={`--vdFlowSecs:${noticeFlowSecs}s; color:var(--zen-muted); font-size:${noticeBodySize}; font-weight:${noticeBodyWeight}; letter-spacing:${noticeBodyTracking || '0.12em'}; font-family:${fontFamily(noticeBodyFont || activeFont)}; opacity:${noticeBodyOpacity ?? 100}%;`}>
                  <span style="padding:0 42px;">{noticeBannerBody}</span>
                  <span style="padding:0 42px;" aria-hidden="true">{noticeBannerBody}</span>
                </div>
              </div>
            </Fragment>
          )}
        </div>
      )}
      {noticeBannerStyle === 'pill' && (
        <span style={`display:inline-flex; align-items:center; gap:9px; padding:6px 15px; border:1px solid var(--zen-muted); border-radius:999px; color:var(--zen-muted); font-size:${noticeTextSize}; font-weight:${noticeTextWeight}; letter-spacing:${noticeTextTracking || '0.16em'}; text-transform:uppercase; font-family:${fontFamily(noticeTextFont || activeFont)}; opacity:${noticeTextOpacity ?? 100}%;`}>
          {noticeDot !== 'none' && (<span aria-hidden="true" class={`vd-notice-dot ${noticeDot === 'animated' ? 'vd-notice-dot--pulse' : ''}`}></span>)}{noticeBannerText}
        </span>
      )}
    </div>
  )}

  <!-- ── FIXED FOOTER ── -->
  <footer class="vd-fixed-footer vd-load-fade" style={headerFooterBg}>
    {settings.footer.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style={`color: ${zenText};`}>
          {icon}
        </a>
      );
    })}
    {settings.footer.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style={`color: ${zenText};`}>·</span>
    )}
    <p class={`${fontSizeClass(settings.footer.footerTextFontSize || typo.footer?.size || 'text-[9px]')} ${settings.footer.footerTextFontWeight || typo.footer?.weight || ''} ${typo.footer?.uppercase !== false ? 'uppercase' : ''} ${settings.footer.footerTextTracking || typo.footer?.tracking || 'tracking-[0.25em]'}`}
       style={textStyle(zenText, settings.footer.footerTextFont || typo.footer?.font || activeFont, settings.footer.footerTextOpacity ?? typo.footer?.opacity ?? 30)}>
      {settings.footer.footerText
        ? settings.footer.footerText
        : `© ${currentYear} ${settings.hero.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <!-- ── BACKGROUND WRAPPER ── -->
  <div style={contentWrapperBg}>

    <!-- SCREEN 1: Hero -->
    <div class="vd-screen vd-load-fade">
      {showNoticeBanner && noticeBannerStyle === 'stacked' && (
        <div class="vd-notice-wrap vd-load-fade" role="status">
          <div class="vd-notice-block">
            <span style={`display:inline-flex; align-items:center; gap:9px; padding:6px 15px; border:1px solid var(--zen-muted); border-radius:999px; color:var(--zen-muted); font-size:${noticeTextSize}; font-weight:${noticeTextWeight}; letter-spacing:${noticeTextTracking || '0.16em'}; text-transform:uppercase; font-family:${fontFamily(noticeTextFont || activeFont)}; opacity:${noticeTextOpacity ?? 100}%;`}>
              {noticeDot !== 'none' && (<span aria-hidden="true" class={`vd-notice-dot ${noticeDot === 'animated' ? 'vd-notice-dot--pulse' : ''}`}></span>)}{noticeBannerText}
            </span>
            {noticeBannerBody && (
              <p style={`max-width:52ch; margin:14px auto 0; color:var(--zen-muted); font-size:${noticeBodySize}; font-weight:${noticeBodyWeight}; line-height:1.65; letter-spacing:${noticeBodyTracking || '0.02em'}; opacity:${noticeBodyOpacity ?? 90}%; font-family:${fontFamily(noticeBodyFont || activeFont)};`}>{noticeBannerBody}</p>
            )}
          </div>
        </div>
      )}
      <div class="w-full max-w-xl text-center">
        {!settings.hero.showSubSiteNameOnly && settings.hero.siteName && (
          <h1 class={`${fontSizeClass(settings.hero.siteNameFontSize || typo.title?.size || 'text-3xl md:text-4xl')} ${settings.hero.siteNameFontWeight || typo.title?.weight || 'font-thin'} text-center ${settings.hero.siteNameTracking || typo.title?.tracking || 'tracking-[0.5em]'} uppercase leading-none translate-x-[0.25em] ${animTextHover ? 'vd-hover-grow' : ''}`}
              style={textStyle(zenText, settings.hero.siteNameFont || typo.title?.font, settings.hero.siteNameOpacity ?? typo.title?.opacity ?? 100)}>
            {settings.hero.siteName}
          </h1>
        )}
        {subSiteName && (
          <h2 class={`${fontSizeClass(settings.hero.subSiteNameFontSize || typo.subTitle?.size || 'text-[13px]')} ${settings.hero.subSiteNameFontWeight || typo.subTitle?.weight || 'font-thin'} text-center ${settings.hero.subSiteNameTracking || typo.subTitle?.tracking || 'tracking-[0.25em]'} uppercase mt-6 leading-relaxed translate-x-[0.12em]`}
              style={textStyle(zenText, settings.hero.subSiteNameFont || typo.subTitle?.font, settings.hero.subSiteNameOpacity ?? typo.subTitle?.opacity ?? 70)}>
            {contentLines(subSiteName).map(({ line, dots }) => (
              dots > 0 ? (
                <span class="vd-dots block" aria-hidden="true">
                  {Array.from({ length: dots }).map(() => <span></span>)}
                </span>
              ) : (
                <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line}</span>
              )
            ))}
          </h2>
        )}
      </div>
      <div class="vd-hint" style={`color: ${zenText};`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>

    <!-- SCREENS 2…N: Content sections -->
    {pageData.map((block: any, blockIdx: number) => {
      if (!block.enabled) return null;

      // ── Per-section visibility & folding (section + processFlow) ──────────
      // Three independent "show" switches, default ON (undefined on existing
      // content still renders, exactly as before). Folds are opt-in (default
      // OFF) so a single-line section or the contact block never folds.
      const showTitle    = block.showTitle    !== false;
      const showSubtitle = block.showSubtitle !== false;
      const showBody     = block.showBody     !== false;
      const cueStyle     = block.cueStyle || 'dot';
      const cueLabel     = block.cueLabel || foldMoreDefault;
      const cueLabelOpen = block.cueLabelOpen || foldLessDefault;

      // ── Process Flow ──────────────────────────────────────────────────────
      if (block._template === 'processFlow') {
        const isVertical = block.orientation === 'vertical';
        const relayUid = blockUidMap.get(block);
        const connectorCount = Math.max((block.steps?.length ?? 1) - 1, 0);
        const flowDotsN = block.dotsPerConnector || defaultDotsPerConnector;
        const flowDotSize = block.dotSize || defaultDotSize;
        const flowGap = block.connectorGap ?? defaultConnectorGap;
        const flowStepSpacing = block.stepSpacing ?? defaultStepSpacing;
        const relayDuration = (block.flowSpeed || defaultFlowSpeed) * connectorCount;
        // processFlow already grows + top-flows via .vd-screen--flow, so a fold
        // just decides whether the steps / explainer start hidden behind a cue.
        const pfFoldProcess = block.foldProcess === true && (block.steps?.length > 0);
        const pfFoldBody    = block.foldBody === true && showBody && !!block.content;

        // Steps + explainer defined once, then rendered either inline (as today)
        // or inside a fold. Two independent folds are possible on one block; in
        // practice an editor picks one.
        const stepsEl = (
          <div class={`flex ${isVertical ? 'flex-col items-center gap-0' : 'flex-row flex-wrap items-center justify-center'}`}>
            {block.steps?.map((step: any, i: number) => (
              <div class={`flex ${isVertical ? 'flex-col items-center' : 'flex-row items-center'}`}>
                <span class={`${fontSizeClass(step.fontSize || block.stepFontSize || typo.label?.size || 'text-[11px]')} ${step.fontWeight || block.stepFontWeight || typo.label?.weight || 'font-thin'} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'}`}
                      style={textStyle(zenText, step.font || block.stepFont || typo.label?.font, typo.label?.opacity ?? 75) + `${isVertical ? `padding-top: ${flowStepSpacing}px; padding-bottom: ${flowStepSpacing}px;` : `padding-left: ${flowStepSpacing}px; padding-right: ${flowStepSpacing}px;`}`}>
                  {step.label}
                </span>
                {i < (block.steps?.length ?? 0) - 1 && (
                  isVertical ? (
                    <span class="vd-connector-v" style={`color: ${zenText}; gap: ${flowGap}px;`} aria-hidden="true">
                      {Array.from({ length: flowDotsN }).map((_, k) => (
                        <span class="vd-relay-dot"
                              style={`width: ${flowDotSize}px; height: ${flowDotSize}px;${animFlow ? ` animation-name: vdRelayDot_${relayUid}_${i}_${k}; animation-duration: ${relayDuration}s;` : ''}`}></span>
                      ))}
                    </span>
                  ) : (
                    <span class="vd-connector" style={`color: ${zenText}; gap: ${flowGap}px;`} aria-hidden="true">
                      {Array.from({ length: flowDotsN }).map((_, k) => (
                        <span class="vd-relay-dot"
                              style={`width: ${flowDotSize}px; height: ${flowDotSize}px;${animFlow ? ` animation-name: vdRelayDot_${relayUid}_${i}_${k}; animation-duration: ${relayDuration}s;` : ''}`}></span>
                      ))}
                    </span>
                  )
                )}
              </div>
            ))}
          </div>
        );

        const explainerEl = block.content ? (
          <div class={`${fontSizeClass(block.fontSize || typo.body?.size || 'text-[15px]')} ${block.fontWeight || 'font-normal'} leading-relaxed max-w-lg mx-auto text-center mt-10`}
               style={`${(block.bodyFont || typo.body?.font) ? `font-family: ${fontFamily(block.bodyFont || typo.body?.font)};` : ''} opacity: ${block.bodyOpacity ?? typo.body?.opacity ?? 90}%;`}>
            {contentGroups(block.content).map((g) => (
              g.kind === 'dots' ? (
                <div class="vd-dots" aria-hidden="true">
                  {Array.from({ length: g.n }).map(() => <span></span>)}
                </div>
              ) : (
                <p class="mb-0">
                  {g.lines.map((l) => (
                    <span class={`block ${animTextHover ? 'vd-hover-grow' : ''}`}>{l}</span>
                  ))}
                </p>
              )
            ))}
          </div>
        ) : null;

        return (
          <div class="vd-screen vd-reveal vd-screen--flow">
            <div class="w-full max-w-2xl text-center my-auto">
              {showTitle && block.title && (
                <h2 class={`${fontSizeClass(block.titleFontSize || typo.title?.size || 'text-[11px]')} ${block.titleFontWeight || typo.title?.weight || 'font-thin'} ${typo.title?.uppercase !== false ? 'uppercase' : ''} ${block.titleTracking || typo.title?.tracking || 'tracking-[1.2em]'} ${block.subTitle ? 'mb-8' : 'mb-12'} translate-x-[0.6em]`}
                    style={textStyle(zenText, block.titleFont || typo.title?.font, block.titleOpacity ?? typo.title?.opacity ?? 90)}>
                  {block.title.split('|').map((line: string) => (
                    <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line.trim()}</span>
                  ))}
                </h2>
              )}
              {/* Sits between the title and the drawn steps, exactly where a section's
                  sub-title sits — so a process flow can say what it is FOR before it shows
                  what it IS. Dot-only segments render as drawn dividers, same as elsewhere. */}
              {showSubtitle && block.subTitle && (
                <h3 class={`${fontSizeClass(block.subTitleFontSize || typo.subTitle?.size || 'text-[11px]')} ${block.subTitleFontWeight || typo.subTitle?.weight || 'font-normal'} ${typo.subTitle?.uppercase !== false ? 'uppercase' : ''} ${block.subTitleTracking || typo.subTitle?.tracking || 'tracking-[0.15em]'} mb-3`}
                    style={textStyle(zenText, block.subTitleFont || typo.subTitle?.font, block.subTitleOpacity ?? typo.subTitle?.opacity ?? 70)}>
                  {contentLines(block.subTitle).map(({ line, dots }) => (
                    dots > 0 ? (
                      <span class="vd-dots block" aria-hidden="true">
                        {Array.from({ length: dots }).map(() => <span></span>)}
                      </span>
                    ) : (
                      <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line}</span>
                    )
                  ))}
                </h3>
              )}

              {pfFoldProcess ? (
                <Fold id={`vd-fold-${blockIdx}-steps`} cueStyle={cueStyle} cueLabel={cueLabel} cueLabelOpen={cueLabelOpen}
                      ariaClosed={foldAriaClosed} ariaOpen={foldAriaOpen} color={zenText}>
                  {stepsEl}
                </Fold>
              ) : stepsEl}

              {/* Optional explainer + CTA. Lets a processFlow block do more than
                  draw steps — it can also say what the steps are for and hand the
                  visitor the door. Used by the Fit Check screen; the Our Process
                  block leaves both fields empty and renders exactly as before. */}
              {showBody && explainerEl && (
                pfFoldBody ? (
                  <Fold id={`vd-fold-${blockIdx}-body`} cueStyle={cueStyle} cueLabel={cueLabel} cueLabelOpen={cueLabelOpen}
                        ariaClosed={foldAriaClosed} ariaOpen={foldAriaOpen} color={zenText}>
                    {explainerEl}
                  </Fold>
                ) : explainerEl
              )}

              {block.ctaLabel && block.ctaUrl && (block.ctaUrl !== '/check' || fitCheckEnabled) && (
                <div class="flex justify-center mt-10">
                  <a href={lang === 'de' && block.ctaUrl.startsWith('/') ? `/de${block.ctaUrl}` : block.ctaUrl}
                     class={`vd-cta ${fontSizeClass(typo.label?.size || 'text-[11px]')}`}
                     style={`color: ${zenText};`}>
                    {block.ctaLabel}
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      }

      // ── Case Study ────────────────────────────────────────────────────────
      if (block._template === 'caseStudy') {
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">

              <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.3em]'} mb-2 translate-x-[0.15em]`}
                 style={textStyle(zenText, block.metaFont || typo.label?.font, typo.label?.opacity ?? 40)}>
                {t.caseStudyTag}
              </p>

              <h2 class={`${fontSizeClass(block.titleFontSize || typo.title?.size || 'text-[13px]')} ${block.titleFontWeight || typo.title?.weight || 'font-bold'} ${typo.title?.uppercase !== false ? 'uppercase' : ''} ${typo.title?.tracking || 'tracking-[1.2em]'} mb-1 translate-x-[0.6em] ${animTextHover ? 'vd-hover-grow' : ''}`}
                  style={textStyle(zenText, block.titleFont || typo.title?.font, typo.title?.opacity ?? 60)}>
                {block.industry || 'Industry'}
              </h2>

              {/* Optional, and deliberately opt-in: a case study only names the
                  client when the client has said yes. Empty = anonymous, exactly
                  as before. */}
              {block.client && (
                <p class={`${fontSizeClass(block.labelFontSize || typo.label?.size || 'text-[11px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'} mb-1 translate-x-[0.125em]`}
                   style={textStyle(zenText, block.metaFont || typo.label?.font, typo.label?.opacity ?? 55)}>
                  {block.client}
                </p>
              )}

              {block.location && (
                <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'} translate-x-[0.125em]
                  mb-6 md:mb-12`}
                   style={textStyle(zenText, block.metaFont || typo.label?.font, typo.label?.opacity ?? 30)}>
                  {block.location}
                </p>
              )}

              {/* FIX 7: gap-4 on mobile saves ~64px on phones without changing desktop layout */}
              <div class="grid grid-cols-1 gap-4 md:gap-8 text-left mb-6 md:mb-10">

                {block.challenge && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${fontSizeClass(block.labelFontSize || typo.label?.size || 'text-[9px]')} ${block.labelFontWeight || typo.label?.weight || 'font-normal'} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'} mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont || typo.label?.font, typo.label?.opacity ?? 30)}>{t.challenge}</p>
                    <div class={`${fontSizeClass(block.bodyFontSize || typo.body?.size || 'text-[12px]')} ${block.bodyFontWeight || typo.body?.weight || 'font-thin'} leading-relaxed`}
                         style={textStyle(zenText, block.bodyFont || typo.body?.font, typo.body?.opacity ?? 70)}>
                      {streamLines(block.challenge).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.built && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${fontSizeClass(block.labelFontSize || typo.label?.size || 'text-[9px]')} ${block.labelFontWeight || typo.label?.weight || 'font-normal'} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'} mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont || typo.label?.font, typo.label?.opacity ?? 30)}>{t.built}</p>
                    <div class={`${fontSizeClass(block.bodyFontSize || typo.body?.size || 'text-[12px]')} ${block.bodyFontWeight || typo.body?.weight || 'font-thin'} leading-relaxed`}
                         style={textStyle(zenText, block.bodyFont || typo.body?.font, typo.body?.opacity ?? 70)}>
                      {streamLines(block.built).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.result && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${fontSizeClass(block.labelFontSize || typo.label?.size || 'text-[9px]')} ${block.labelFontWeight || typo.label?.weight || 'font-normal'} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'} mb-2 translate-x-[0.125em]`}
                       style={textStyle(zenText, block.labelFont || typo.label?.font, typo.label?.opacity ?? 30)}>{t.result}</p>
                    <div class={`${fontSizeClass(block.bodyFontSize || typo.body?.size || 'text-[12px]')} ${block.bodyFontWeight || typo.body?.weight || 'font-thin'} leading-relaxed`}
                         style={textStyle(zenText, block.bodyFont || typo.body?.font, typo.body?.opacity ?? 70)}>
                      {streamLines(block.result).map((line) => (
                        <span class={`vd-line ${animTextHover ? "vd-hover-grow" : ""}`} style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="flex justify-center gap-10 opacity-30">
                {block.package && (
                  <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.2em]'}`}
                     style={textStyle(zenText, block.metaFont || typo.label?.font)}>
                    {t.packageLabel}: {block.package}
                  </p>
                )}
                {block.timeline && (
                  <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.2em]'}`}
                     style={textStyle(zenText, block.metaFont || typo.label?.font)}>
                    {t.timelineLabel}: {block.timeline}
                  </p>
                )}
              </div>

            </div>
          </div>
        );
      }

      if (block._template === 'testimonial') {
        const attribution = [block.attributionName, block.attributionOrg].filter(Boolean).join(' — ');
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">

              <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.3em]'} mb-6 translate-x-[0.15em]`}
                 style={textStyle(zenText, typo.label?.font, typo.label?.opacity ?? 40)}>
                {t.testimonialTag}
              </p>

              {block.quote && (
                <blockquote class={`${fontSizeClass(block.quoteFontSize || typo.body?.size || 'text-[15px]')} ${block.quoteFontWeight || typo.body?.weight || 'font-thin'} leading-relaxed mb-6 ${animTextHover ? 'vd-hover-grow' : ''}`}
                     style={textStyle(zenText, typo.body?.font, typo.body?.opacity ?? 80)}>
                  “{block.quote}”
                </blockquote>
              )}

              {attribution && (
                <p class={`${fontSizeClass(block.metaFontSize || typo.label?.size || 'text-[9px]')} ${typo.label?.uppercase !== false ? 'uppercase' : ''} ${typo.label?.tracking || 'tracking-[0.25em]'}`}
                   style={textStyle(zenText, typo.label?.font, typo.label?.opacity ?? 40)}>
                  {attribution}
                </p>
              )}

            </div>
          </div>
        );
      }

      // ── Standard content section ──────────────────────────────────────────
      // Body fold is only live when there IS a body to fold and it's shown.
      // A foldable section borrows the proven .vd-screen--flow treatment (grow +
      // top-flow) plus my-auto on the inner block: short (folded) → centred;
      // tall (unfolded) → flows downward, never spilling into the panel above.
      const foldBody  = block.foldBody === true && showBody && !!block.content;
      const hasGroups = block.groups?.length > 0;
      // .vd-screen--groups uses the SAME grow-and-top-flow treatment as
      // --flow (see both rules below), so it needs the same my-auto
      // centring compensation — otherwise a groups section whose body text
      // is hidden/absent (showBody off, foldBody off, or no `content`) is
      // permanently pinned to the top of the screen instead of centring
      // when its content is shorter than the viewport. Previously this was
      // gated on foldBody alone, which happened to hold for "The Work We
      // Take Off You" only while it also had a foldable intro paragraph —
      // any groups section without one silently lost centring.
      const foldableSection = foldBody || hasGroups;
      // Body markup defined once, then rendered either inline (as today) or
      // inside the fold — identical either way, so folding changes nothing but
      // whether it starts hidden behind the cue.
      const sectionBodyEl = block.content ? (
        <div class={`${fontSizeClass(block.fontSize || typo.body?.size || 'text-[15px]')} ${block.fontWeight || 'font-normal'} ${typo.body?.uppercase === true ? 'uppercase' : ''} leading-relaxed max-w-lg mx-auto text-center`}
             style={`${(block.bodyFont || typo.body?.font) ? `font-family: ${fontFamily(block.bodyFont || typo.body?.font)};` : ''} opacity: ${block.bodyOpacity ?? typo.body?.opacity ?? 90}%;`}>
          {contentGroups(block.content).map((g) => (
            g.kind === 'dots' ? (
              <div class="vd-dots" aria-hidden="true">
                {Array.from({ length: g.n }).map(() => <span></span>)}
              </div>
            ) : (
              <p class="mb-0">
                {g.lines.map((l) => (
                  <span class={`block ${animTextHover ? 'vd-hover-grow' : ''}`}>{l}</span>
                ))}
              </p>
            )
          ))}
        </div>
      ) : null;
      return (
        <div class={`vd-screen vd-reveal ${hasGroups ? 'vd-screen--groups' : ''} ${foldBody ? 'vd-screen--flow' : ''}`}>
          <div class={`w-full max-w-2xl text-center ${foldableSection ? 'my-auto' : ''}`}>

            {showTitle && block.title && (
              <h2 class={`${fontSizeClass(block.titleFontSize || typo.title?.size || 'text-[11px]')} ${block.titleFontWeight || typo.title?.weight || 'font-normal'} ${typo.title?.uppercase !== false ? 'uppercase' : ''} ${block.titleTracking || typo.title?.tracking || 'tracking-[0.4em]'} translate-x-[0.2em] mb-8`}
                  style={textStyle(zenText, block.titleFont || typo.title?.font, block.titleOpacity ?? typo.title?.opacity ?? 90)}>
                {block.title.split('|').map((line: string) => (
                  <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line.trim()}</span>
                ))}
              </h2>
            )}

            {showSubtitle && block.subTitle && (
              <h3 class={`${fontSizeClass(block.subTitleFontSize || typo.subTitle?.size || 'text-[11px]')} ${block.subTitleFontWeight || typo.subTitle?.weight || 'font-normal'} ${typo.subTitle?.uppercase !== false ? 'uppercase' : ''} ${block.subTitleTracking || typo.subTitle?.tracking || 'tracking-[0.15em]'} mb-3`}
                  style={textStyle(zenText, block.subTitleFont || typo.subTitle?.font, block.subTitleOpacity ?? typo.subTitle?.opacity ?? 70)}>
                {contentLines(block.subTitle).map(({ line, dots }) => (
                  dots > 0 ? (
                    <span class="vd-dots block" aria-hidden="true">
                      {Array.from({ length: dots }).map(() => <span></span>)}
                    </span>
                  ) : (
                    <span class={`block ${animTextHover ? "vd-hover-grow" : ""}`}>{line}</span>
                  )
                ))}
              </h3>
            )}

            {/* Folding groups. Ten flat labels is a wall; four is a map. The open
                marker is the same dot as everything else on the site — no chevrons,
                no plus signs, no borders. Exactly one group is open at a time. */}
            {block.groups?.length > 0 && (
              <div class="vd-acc max-w-md mx-auto mb-6" data-vd-acc>
                {block.groups.map((g: any, i: number) => (
                  <div class="vd-acc-item" data-vd-acc-item data-open="false">
                    <button type="button" class="vd-acc-head" data-vd-acc-head style={`color: ${zenText};`}>
                      <span class="vd-acc-dot" aria-hidden="true"></span>
                      <span class={`vd-acc-label ${fontSizeClass(typo.label?.size || 'text-[13px]')}`}>{g.label}</span>
                      <span class="vd-acc-close" aria-hidden="true">{'\u00d7'}</span>
                    </button>
                    <div class="vd-acc-body" data-vd-acc-body>
                      <div class="vd-acc-inner">
                        {g.intro && block.showGroupIntros !== false && g.showIntro !== false && (
                          <p class="vd-acc-intro" style={`color: ${zenText};`}>{g.intro}</p>
                        )}
                        <div class="vd-acc-subs">
                          {g.items?.map((it: any) => {
                            const expandable = (it.problem || it.handled) && block.showItemCopy !== false && it.showCopy !== false;
                            return expandable ? (
                              <div class="vd-acc-sub-item" data-vd-sub data-open="false">
                                <button type="button" class="vd-acc-sub-head" data-vd-sub-head style={`color: ${zenText};`}>
                                  <span class="vd-acc-sub-dot" aria-hidden="true"></span>
                                  <span class="vd-acc-sub">{it.label}</span>
                                </button>
                                <div class="vd-acc-sub-body" data-vd-sub-body>
                                  <div class="vd-acc-sub-inner">
                                    {it.problem && (
                                      <p class="vd-acc-copy vd-acc-problem" style={`color: ${zenText};`}>{it.problem}</p>
                                    )}
                                    {it.handled && (
                                      <p class="vd-acc-copy vd-acc-handled" style={`color: ${zenText};`}>{it.handled}</p>
                                    )}
                                  </div>
                                </div>
                              </div>
                            ) : (
                              <div class="vd-acc-sub-item vd-acc-sub-item--static">
                                <span class="vd-acc-sub" style={`color: ${zenText};`}>{it.label}</span>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {/* Card grid. The non-folding counterpart to the accordion above:
                a handful of points that should all read at a glance, nothing
                behind a click. Same hairline-rule primitive as the case-study
                fields (border + tracked label + short copy), turned horizontal
                and laid out in a grid instead of stacked full-width blocks. */}
            {block.cards?.length > 0 && (
              <div class={`grid ${block.cardColumns || 'grid-cols-2'} ${block.cardGridSpacing || settings.layout?.cardGridSpacing || ''} ${block.cardGap || settings.layout?.cardGap || 'gap-x-6 gap-y-5'} text-left max-w-xl mx-auto mb-6`}>
                {block.cards.map((c: any, i: number) => (
                  <div class="border-t border-current border-opacity-10 pt-2.5">
                    <p class={`${fontSizeClass(typo.label?.size || 'text-[9px]')} uppercase ${typo.label?.tracking || 'tracking-[0.25em]'} ${block.cardInternalSpacing || settings.layout?.cardInternalSpacing || 'mb-1.5'} translate-x-[0.125em]`}
                       style={textStyle(zenText, typo.label?.font, typo.label?.opacity ?? 30)}>
                      {String(i + 1).padStart(2, '0')}
                    </p>
                    {c.title && (
                      <p class={`${fontSizeClass(block.cardTitleFontSize || typo.cardTitle?.size || 'sm')} ${block.cardTitleFontWeight || typo.cardTitle?.weight || 'font-medium'} ${typo.cardTitle?.uppercase === true ? 'uppercase' : ''} ${block.cardTitleTracking || typo.cardTitle?.tracking || ''} ${block.cardInternalSpacing || settings.layout?.cardInternalSpacing || 'mb-1.5'} ${animTextHover ? 'vd-hover-grow' : ''}`}
                         style={textStyle(zenText, block.cardTitleFont || typo.cardTitle?.font, block.cardTitleOpacity ?? typo.cardTitle?.opacity ?? 100)}>
                        {c.title}
                      </p>
                    )}
                    {c.line && (
                      <p class={`${fontSizeClass(block.cardLineFontSize || typo.cardLine?.size || 'xs')} ${block.cardLineFontWeight || typo.cardLine?.weight || 'font-light'} ${typo.cardLine?.uppercase === true ? 'uppercase' : ''} ${block.cardLineTracking || typo.cardLine?.tracking || ''} leading-relaxed`}
                         style={textStyle(zenText, block.cardLineFont || typo.cardLine?.font, block.cardLineOpacity ?? typo.cardLine?.opacity ?? 65)}>
                        {c.line}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            )}

            {showBody && sectionBodyEl && (
              foldBody ? (
                <Fold id={`vd-fold-${blockIdx}`} cueStyle={cueStyle} cueLabel={cueLabel} cueLabelOpen={cueLabelOpen}
                      ariaClosed={foldAriaClosed} ariaOpen={foldAriaOpen} color={zenText}>
                  {sectionBodyEl}
                </Fold>
              ) : sectionBodyEl
            )}

            {(block.email || block.phone) && (
              <div class="flex justify-center items-center gap-6 mt-10">
                {block.email && (
                  <a href={`mailto:${block.email}`}
                     class={`vd-nav-link ${fontSizeClass(typo.label?.size || 'text-[11px]')} ${typo.label?.tracking || 'tracking-[0.15em]'} translate-x-[0.075em]`}
                     style={textStyle(zenText, typo.label?.font, typo.label?.opacity ?? 60)}>
                    {block.email}
                  </a>
                )}
                {block.email && block.phone && (
                  <span class="vd-dots" aria-hidden="true" style={`color: ${zenText};`}><span></span></span>
                )}
                {block.phone && (
                  <a href={`tel:${block.phone.replace(/[^+0-9]/g, '')}`}
                     class={`vd-nav-link ${fontSizeClass(typo.label?.size || 'text-[11px]')} ${typo.label?.tracking || 'tracking-[0.15em]'} translate-x-[0.075em]`}
                     style={textStyle(zenText, typo.label?.font, typo.label?.opacity ?? 60)}>
                    {block.phone}
                  </a>
                )}
              </div>
            )}

            {block.ctaLabel && block.ctaUrl && (block.ctaUrl !== '/data' || dataPageEnabled) && (block.ctaUrl !== '/check' || fitCheckEnabled) && (
              <div class="flex justify-center mt-10">
                <a href={lang === 'de' && block.ctaUrl.startsWith('/') ? `/de${block.ctaUrl}` : block.ctaUrl}
                   class={`vd-cta ${fontSizeClass(typo.label?.size || 'text-[11px]')}`}
                   style={`color: ${zenText};`}>
                  {block.ctaLabel}
                </a>
              </div>
            )}

            {block.showArt && (
              <div class="w-full mt-10">
                <div class="flex flex-wrap justify-center gap-16 lg:gap-24 w-full">
                  {artFiles.filter(p => p.default.enabled).map((piece) => (
                    <div class={`${widthMap[block.columns] || 'md:w-[calc(33.333%-3rem)]'} w-full`}>
                      <ArtCard {...piece.default} />
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      );
    })}

  </div>
</Layout>

<script>
  // Folding groups: clicking a head opens it and folds whichever was open.
  // Deliberately not a <details> element — those come with a disclosure triangle
  // and a browser-default animation, and both are foreign to this design.
  document.querySelectorAll('[data-vd-acc]').forEach((acc) => {
    const section = acc.closest('.vd-screen');
    const items = Array.from(acc.querySelectorAll('[data-vd-acc-item]'));
    const closeAllSubs = () =>
      acc.querySelectorAll('[data-vd-sub]').forEach((s) => s.setAttribute('data-open', 'false'));

    items.forEach((item) => {
      const head = item.querySelector('[data-vd-acc-head]');
      head?.addEventListener('click', () => {
        const wasOpen = item.getAttribute('data-open') === 'true';
        items.forEach((o) => o.setAttribute('data-open', 'false'));
        closeAllSubs();
        if (wasOpen) {
          // Closing a group returns to the top of the Problems We Solve panel,
          // never the panel above or below.
          section?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          item.setAttribute('data-open', 'true');
          // Anchor the opened group's header near the top so its content
          // unfolds downward rather than pushing up into the panel above.
          setTimeout(() => head.scrollIntoView({ behavior: 'smooth', block: 'start' }), 60);
        }
      });

      // Second level: sub-topics, one open at a time within the group.
      item.querySelectorAll('[data-vd-sub]').forEach((sub) => {
        const shead = sub.querySelector('[data-vd-sub-head]');
        shead?.addEventListener('click', (e) => {
          e.stopPropagation();
          const wasOpen = sub.getAttribute('data-open') === 'true';
          item.querySelectorAll('[data-vd-sub]').forEach((o) => o.setAttribute('data-open', 'false'));
          sub.setAttribute('data-open', wasOpen ? 'false' : 'true');
        });
      });
    });
  });

  // Per-section folds: the breathing cue toggles its slotted content open/closed.
  // Same interaction language as the accordion above — clicking anchors the
  // section to the top so the body unfolds DOWNWARD rather than pushing the
  // title up into the previous snap section; closing settles back on it.
  document.querySelectorAll('[data-vd-fold]').forEach((fold) => {
    const cue = fold.querySelector('[data-vd-fold-cue]');
    const section = fold.closest('.vd-screen');
    cue?.addEventListener('click', () => {
      const willOpen = fold.getAttribute('data-open') !== 'true';
      fold.setAttribute('data-open', willOpen ? 'true' : 'false');
      cue.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      const nextAria = willOpen
        ? cue.getAttribute('data-aria-open')
        : cue.getAttribute('data-aria-closed');
      if (nextAria) cue.setAttribute('aria-label', nextAria);
      if (section) {
        setTimeout(
          () => section.scrollIntoView({ behavior: 'smooth', block: 'start' }),
          willOpen ? 60 : 0,
        );
      }
    });
  });

  // Original reveal animation — fires when 40% of a section is visible after snap
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('vd-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { root: null, threshold: 0.1 }
  );
  document.querySelectorAll('.vd-reveal').forEach(el => observer.observe(el));

  // Logo: scroll to top when already on the home page
  const logoLink = document.querySelector('.vd-fixed-header a');
  if (logoLink) {
    logoLink.addEventListener('click', (e) => {
      const target = new URL(logoLink.getAttribute('href'), location.href);
      if (target.pathname === location.pathname) {
        e.preventDefault();
        document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // Process-flow connectors are pure CSS now — one relay dot per connector,
  // sharing a single generated keyframe timeline per block (see
  // dotPulseKeyframes() in the frontmatter above). No animation script needed.

</script>
