---
// src/components/SitePage.astro
// Shared template for the main scroll page — used by both index.astro (EN) and de/index.astro (DE).
// Data is loaded by the calling page file via Astro.glob and passed in as props.

import Layout from '../layouts/Layout.astro';
import ArtCard from './ArtCard.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui, type Lang } from '../i18n/ui.ts';
import { themeColors, fontFamily, textStyle, socialIcon } from '../utils/siteHelpers.ts';

interface Props {
  lang:     Lang;
  pageData: any[];
  settings: any;
  artFiles: any[];
}

const { lang, pageData, settings, artFiles } = Astro.props;
const t = ui[lang];

// ── Theme & font ──────────────────────────────────────────────────────────────
const currentTheme = settings.theme || 'light';
const currentYear  = new Date().getFullYear();

const activeFont = (settings.fontPreset === 'custom' && settings.customFontName)
  ? settings.customFontName
  : (settings.fontPreset || 'Inter');

const activeFontFamily = fontFamily(activeFont);

const allFontsUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600;700&family=Lora:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Space+Mono:wght@400;700&family=Newsreader:ital,wght@0,100;0,300;0,400;0,700;1,400&display=swap";

// ── Colour helpers ────────────────────────────────────────────────────────────
const getBgColor = () => {
  if (settings.customBackgroundColor) return settings.customBackgroundColor;
  return themeColors[currentTheme]?.bg || '#ffffff';
};
const getTextColor = (customColor?: string) => {
  const base = customColor || settings.baseTextColor;
  if (!base) return themeColors[currentTheme]?.text || '#0a0a0a';
  return base;
};

// ── Layout dimensions ─────────────────────────────────────────────────────────
const headerHeight     = settings.headerHeight     || '52px';
const footerHeight     = settings.footerHeight     || '44px';
const headerInnerWidth = settings.headerInnerWidth || '680px';

// ── Gallery column map ────────────────────────────────────────────────────────
const widthMap: Record<string, string> = {
  'grid-cols-2': 'md:w-[calc(50%-2rem)]',
  'grid-cols-3': 'md:w-[calc(33.333%-3rem)]',
  'grid-cols-4': 'md:w-[calc(25%-4rem)]',
};

// ── Lang-aware settings ───────────────────────────────────────────────────────
const subSiteName = lang === 'de'
  ? (settings.subSiteName_de   || settings.subSiteName)
  : settings.subSiteName;

const metaTitle = lang === 'de'
  ? (settings.metaTitle_de     || settings.metaTitle     || 'VortexDeep — KI-Automatisierung für KMU in Zürich')
  : (settings.metaTitle        || `${settings.siteName || 'VortexDeep'} — Practical AI Automation for Small Business`);

const metaDescription = lang === 'de'
  ? (settings.metaDescription_de || settings.metaDescription || 'KI-Automatisierung für KMU in Zürich.')
  : (settings.metaDescription    || 'VortexDeep helps small businesses adopt practical AI automation. Based in Zürich, Switzerland.');

// ── Lang-aware nav links (label_de + /de prefix on URLs) ─────────────────────
const homeUrl = lang === 'de' ? '/de/' : '/';
const resolvedNavLinks = (settings.navLinks || []).map((link: any) => ({
  label: lang === 'de' ? (link.label_de || link.label) : link.label,
  url:   lang === 'de' ? `/de${link.url}` : link.url,
}));

// ── JSON-LD structured data ───────────────────────────────────────────────────
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": settings.siteName || "VortexDeep",
  "description": metaDescription,
  "url": settings.siteUrl || "https://vortexdeep.ch",
  "email": settings.contactEmail || "info@vortexdeep.ch",
  ...(settings.contactPhone ? { "telephone": settings.contactPhone } : {}),
  "address": {
    "@type": "PostalAddress",
    "streetAddress":   settings.addressStreet  || "",
    "addressLocality": settings.addressCity    || "Zürich",
    "postalCode":      settings.addressPostal  || "",
    "addressCountry":  "CH",
  },
  "areaServed": [
    { "@type": "City",    "name": "Zürich" },
    { "@type": "Country", "name": "Switzerland" },
  ],
  "serviceType": lang === 'de' ? "KI-Automatisierungsberatung" : "AI Automation Consulting",
  "priceRange": "$$",
  "sameAs": (settings.socialLinks || []).map((l: any) => l.url).filter(Boolean),
};

// ── Cascading-reveal helper (4th animation) ───────────────────────────────────
// Splits a '|'-delimited string into lines and returns each with an
// incrementing transition-delay, so the lines populate in sequence rather
// than all at once when the parent .vd-reveal section becomes visible.
const streamLines = (text: string, startDelay = 0.25, step = 0.14) =>
  text.split('|').map((line: string, i: number) => ({
    text: line.trim(),
    delay: `${(startDelay + i * step).toFixed(2)}s`,
  }));
---

<Layout
  lang={lang}
  title={metaTitle}
  theme={currentTheme}
  description={metaDescription}
  ogImage={settings.ogImage || ''}
  siteUrl={settings.siteUrl || 'https://vortexdeep.ch'}
>
  <link rel="stylesheet" href={allFontsUrl} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <style is:global define:vars={{ activeFont, activeFontFamily, headerHeight, footerHeight, headerInnerWidth }}>
    html, body { font-family: var(--activeFontFamily); }

    /* ── Scroll snap — original setup, unchanged ── */
    html {
      scroll-snap-type: y mandatory !important;
      overflow-y: scroll !important;
      height: 100% !important;
    }
    body {
      height: 100% !important;
      margin: 0 !important;
      overflow-y: visible !important;
      overflow-x: clip !important;
    }
    html::-webkit-scrollbar { display: none; }
    html { -ms-overflow-style: none; scrollbar-width: none; }

    /* ── Fixed Header ── */
    .vd-fixed-header {
      position: fixed; top: 0; left: 0; right: 0;
      height: var(--headerHeight);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
    }
    .vd-fixed-header-inner {
      width: 100%; max-width: var(--headerInnerWidth);
      display: flex; align-items: center; justify-content: space-between;
      /* FIX 9: clamp prevents the logo + nav from colliding on iPhone SE (320px).
         1rem on very narrow viewports, interpolates up to 2rem by ~500px. */
      padding: 0 clamp(1rem, 4vw, 2rem);
    }

    /* ── Fixed Footer ── */
    .vd-fixed-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      /* FIX 8: min-height + padding-bottom so the home indicator bar on iPhone X+
         (env(safe-area-inset-bottom) ≈ 34px) does not overlap the footer content.
         Older devices and desktop return 0px so layout is identical there. */
      min-height: var(--footerHeight);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      z-index: 50;
      display: flex; align-items: center; justify-content: center;
      gap: 1.2rem;
    }

    /* ── Social icons ── */
    .vd-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px;
      border: 1px solid currentColor;
      font-size: 8px; font-weight: 600;
      letter-spacing: 0.03em; text-transform: lowercase; text-decoration: none;
      border-radius: 3px; opacity: 0.35;
      transition: opacity 0.25s ease;
    }
    .vd-icon:hover { opacity: 0.9; }
    .vd-icon.round { border-radius: 50%; }

    /* ── Snap sections ── */
    .vd-screen {
      /* FIX 4: 100vh = full viewport incl. browser chrome on iOS Safari,
         so sections appear taller than the visible area → content clips under
         the address bar / toolbar. 100svh = "small viewport height" which always
         excludes the browser chrome. Browsers that don't support svh fall back
         to 100vh gracefully. */
      height: 100vh;
      height: 100svh;
      scroll-snap-align: start; scroll-snap-stop: always;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding-top: calc(var(--headerHeight) + 12px);
      /* FIX 8 cont: match the footer's expanded height on notched phones */
      padding-bottom: calc(var(--footerHeight) + env(safe-area-inset-bottom, 0px) + 12px);
      padding-left: 1.5rem; padding-right: 1.5rem;
      box-sizing: border-box; position: relative;
    }

    /* ── Animations ── */
    .vd-load-fade { animation: vdLoad 1.8s cubic-bezier(0.4,0,0.2,1) forwards; }
    @keyframes vdLoad {
      from { opacity:0; transform:translateY(10px); }
      to   { opacity:1; transform:translateY(0);    }
    }
    .vd-reveal {
      opacity: 0; transform: translateY(10px);
      transition: opacity 1.6s cubic-bezier(0.4,0,0.2,1),
                  transform 1.6s cubic-bezier(0.4,0,0.2,1);
      transition-delay: 0.15s;
    }
    .vd-reveal.vd-visible { opacity:1; transform:translateY(0); }

    /* ── Scroll hint ── */
    .vd-hint {
      position: absolute;
      bottom: calc(var(--footerHeight) + 1rem);
      left: 50%; transform: translateX(-50%);
      opacity: 0.2;
      animation: vdBounce 2.4s ease-in-out infinite;
    }
    @keyframes vdBounce {
      0%,100% { transform: translateX(-50%) translateY(0);   }
      50%      { transform: translateX(-50%) translateY(7px); }
    }

    /* ── NEW 1: Logo ink-draw ──────────────────────────────────────────────
       The wordmark svg is a hex node-graph. On load, the outline and the
       inner "V" stroke draw themselves in rather than just fading, so the
       mark reads as a network assembling itself — reinforcing "automation"
       without adding any new visual element. Fires once per full page load;
       it will not replay on Tina's in-place content patches, only on a
       real navigation / hard refresh. */
    .vd-logo polygon,
    .vd-logo polyline,
    .vd-logo path {
      stroke-dasharray: 500;
      stroke-dashoffset: 500;
      animation: vdDraw 1.3s ease forwards;
    }
    .vd-logo polyline,
    .vd-logo path { animation-delay: 0.85s; }
    .vd-logo circle {
      opacity: 0;
      animation: vdDot 0.35s ease forwards 1.25s;
    }
    @keyframes vdDraw { to { stroke-dashoffset: 0; } }
    @keyframes vdDot  { to { opacity: 1; } }

    /* ── NEW 2: Breathing status dot ───────────────────────────────────────
       A single slow-pulsing dot beside the wordmark. Not language-gated —
       renders identically on every language route since this file is the
       single shared template for both / and /de/. */
    .vd-status-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: currentColor; opacity: 0.3;
      display: inline-block; margin-left: 8px;
      animation: vdBreathe 3s ease-in-out infinite;
    }
    @keyframes vdBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1);   }
      50%      { opacity: 0.85; transform: scale(1.5); }
    }

    /* ── NEW 3: Process-flow — single traveling dot ────────────────────────
       Replaced the earlier "pulse on every segment simultaneously" version.
       The connector lines below stay as a static, faint track; a single dot
       (.vd-flow-dot, appended once per track) is moved along that track by
       the script at the bottom of this file, which measures the real
       rendered position of each connector — so it works regardless of step
       count, label length, or orientation. This reads as one process moving
       step by step, not several steps running at once. */
    .vd-flow-track { position: relative; }
    .vd-flow-dot {
      position: absolute; top: 0; left: 0;
      width: 6px; height: 6px; border-radius: 50%;
      background: currentColor; opacity: 0;
      pointer-events: none;
      /* centers the dot ON the coordinate instead of placing its
         top-left corner there — this is what kept it off the line */
      transform: translate(-50%, -50%);
    }
    .vd-connector {
      position: relative; display: inline-block;
      width: 48px; height: 2px; margin: 0 12px;
      vertical-align: middle; flex-shrink: 0;
    }
    .vd-connector-line { position: absolute; inset: 0; background: currentColor; opacity: 0.15; }
    .vd-connector-v {
      position: relative; display: block;
      width: 2px; height: 20px; margin: 4px auto;
    }
    .vd-connector-v-line { position: absolute; inset: 0; background: currentColor; opacity: 0.15; }

    /* ── NEW 4: Cascading line reveal ──────────────────────────────────────
       Individual lines inside a .vd-reveal section (case-study challenge /
       built / result fields) populate one after another instead of all at
       once — reading like an automated report filling in its fields in
       sequence, rather than a generic fade-up block. Delay is set per-line
       inline via streamLines() above; this class only defines the motion. */
    .vd-line {
      display: block;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.9s cubic-bezier(0.4,0,0.2,1),
                  transform 0.9s cubic-bezier(0.4,0,0.2,1);
    }
    .vd-visible .vd-line { opacity: 1; transform: translateY(0); }
  </style>

  <!-- ── FIXED HEADER ── -->
  <header class="vd-fixed-header vd-load-fade" style={`background-color: ${getBgColor()};`}>
    <div class="vd-fixed-header-inner">
      <!-- Wordmark / logo -->
      <a href={homeUrl} class="flex items-center gap-2 opacity-70 hover:opacity-100 transition-opacity">
        {settings.showLogo && (
          <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"
               style={`color: ${getTextColor()};`}
               class="w-5 h-5 flex-shrink-0 vd-logo">
            <polygon points="100,22 168,61 168,139 100,178 32,139 32,61"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
            <circle cx="100" cy="22"  r="5" fill="currentColor"/>
            <circle cx="168" cy="61"  r="5" fill="currentColor"/>
            <circle cx="168" cy="139" r="5" fill="currentColor"/>
            <circle cx="100" cy="178" r="5" fill="currentColor"/>
            <circle cx="32"  cy="139" r="5" fill="currentColor"/>
            <circle cx="32"  cy="61"  r="5" fill="currentColor"/>
            <polyline points="56,76 78,122 100,76"
                      fill="none" stroke="currentColor" stroke-width="6"
                      stroke-linecap="round" stroke-linejoin="miter"/>
            <line x1="104" y1="76" x2="104" y2="122"
                  stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            <path d="M 104,76 C 134,76 144,86 144,99 C 144,112 134,122 104,122"
                  fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
          </svg>
        )}
        <span class="text-[10px] uppercase tracking-[0.4em]"
              style={`color: ${getTextColor()}; font-family: ${fontFamily(activeFont)};`}>
          {settings.siteName || 'VortexDeep'}
        </span>
        <span class="vd-status-dot" style={`color: ${getTextColor()};`} aria-hidden="true"></span>
      </a>

      <!-- Nav links + language switcher -->
      <nav class="flex gap-6 items-center" style={`color: ${getTextColor()};`}>
        {resolvedNavLinks.map((link: any) => (
          <a href={link.url}
             class={`${settings.headerLinksFontSize || 'text-[10px]'} uppercase tracking-[0.3em] opacity-50 hover:opacity-100 transition-opacity`}
             style={`color: ${getTextColor()}; font-family: ${fontFamily(activeFont)};`}>
            {link.label}
          </a>
        ))}
        <LanguageSwitcher lang={lang} slug="" />
      </nav>
    </div>
  </header>

  <!-- ── FIXED FOOTER ── -->
  <footer class="vd-fixed-footer vd-load-fade" style={`background-color: ${getBgColor()};`}>
    {settings.socialLinks?.map((social: any) => {
      const { icon, round } = socialIcon(social.platform || '');
      return (
        <a href={social.url} target="_blank" rel="noopener noreferrer"
           class={`vd-icon ${round ? 'round' : ''}`}
           title={social.platform}
           style={`color: ${getTextColor()};`}>
          {icon}
        </a>
      );
    })}
    {settings.socialLinks?.length > 0 && (
      <span class="opacity-20 text-[9px]" style={`color: ${getTextColor()};`}>·</span>
    )}
    <p class={`${settings.footerTextFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30`}
       style={`color: ${getTextColor()}; font-family: ${fontFamily(activeFont)};`}>
      {settings.footerText
        ? settings.footerText
        : `© ${currentYear} ${settings.siteName || 'VortexDeep'}`}
    </p>
  </footer>

  <!-- ── BACKGROUND WRAPPER ── -->
  <div style={`background-color: ${getBgColor()};`}>

    <!-- SCREEN 1: Hero -->
    <div class="vd-screen vd-load-fade">
      <div class="w-full max-w-xl text-center">
        {!settings.showSubSiteNameOnly && settings.siteName && (
          <h1 class={`${settings.siteNameFontSize || 'text-3xl md:text-4xl'} ${settings.siteNameFontWeight || 'font-thin'} text-center tracking-[0.5em] uppercase leading-none translate-x-[0.25em]`}
              style={textStyle(getTextColor(), settings.siteNameFont)}>
            {settings.siteName}
          </h1>
        )}
        {subSiteName && (
          <h2 class={`${settings.subSiteNameFontSize || 'text-[13px]'} ${settings.subSiteNameFontWeight || 'font-thin'} text-center tracking-[0.25em] uppercase mt-6 leading-relaxed translate-x-[0.12em]`}
              style={`${textStyle(getTextColor(), settings.subSiteNameFont)} opacity: 0.7;`}>
            {subSiteName.split('|').map((line: string) => (
              <span class="block">{line.trim()}</span>
            ))}
          </h2>
        )}
      </div>
      <div class="vd-hint" style={`color: ${getTextColor()};`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.2">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </div>

    <!-- SCREENS 2…N: Content sections -->
    {pageData.map((block: any) => {
      if (!block.enabled) return null;

      // ── Process Flow ──────────────────────────────────────────────────────
      if (block._template === 'processFlow') {
        const isVertical = block.orientation === 'vertical';
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">
              {block.title && (
                <h2 class={`${block.titleFontSize || 'text-[11px]'} ${block.titleFontWeight || 'font-thin'} uppercase tracking-[1.2em] mb-12 opacity-60 translate-x-[0.6em]`}
                    style={textStyle(getTextColor(), block.titleFont)}>
                  {block.title.split('|').map((line: string) => (
                    <span class="block">{line.trim()}</span>
                  ))}
                </h2>
              )}
              <div class={`flex ${isVertical ? 'flex-col items-center gap-0' : 'flex-row flex-wrap items-center justify-center'} vd-flow-track`}>
                {block.steps?.map((step: any, i: number) => (
                  <div class={`flex ${isVertical ? 'flex-col items-center' : 'flex-row items-center'}`}>
                    <span class={`${step.fontSize || block.stepFontSize || 'text-[11px]'} ${step.fontWeight || block.stepFontWeight || 'font-thin'} uppercase tracking-[0.25em] opacity-75 py-3`}
                          style={textStyle(getTextColor(), step.font || block.stepFont)}>
                      {step.label}
                    </span>
                    {i < (block.steps?.length ?? 0) - 1 && (
                      isVertical ? (
                        <span class="vd-connector-v" style={`color: ${getTextColor()};`} aria-hidden="true">
                          <span class="vd-connector-v-line"></span>
                        </span>
                      ) : (
                        <span class="vd-connector" style={`color: ${getTextColor()};`} aria-hidden="true">
                          <span class="vd-connector-line"></span>
                        </span>
                      )
                    )}
                  </div>
                ))}
                <span class="vd-flow-dot" style={`color: ${getTextColor()};`} aria-hidden="true"></span>
              </div>
            </div>
          </div>
        );
      }

      // ── Case Study ────────────────────────────────────────────────────────
      if (block._template === 'caseStudy') {
        return (
          <div class="vd-screen vd-reveal">
            <div class="w-full max-w-2xl text-center">

              <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.3em] opacity-40 mb-2 translate-x-[0.15em]`}
                 style={textStyle(getTextColor(), block.metaFont)}>
                {t.caseStudyTag}
              </p>

              <h2 class={`${block.titleFontSize || 'text-[13px]'} ${block.titleFontWeight || 'font-bold'} uppercase tracking-[1.2em] mb-1 opacity-60 translate-x-[0.6em]`}
                  style={textStyle(getTextColor(), block.titleFont)}>
                {block.industry || 'Industry'}
              </h2>

              {block.location && (
                <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.25em] opacity-30 translate-x-[0.125em]
                  mb-6 md:mb-12`}
                   style={textStyle(getTextColor(), block.metaFont)}>
                  {block.location}
                </p>
              )}

              {/* FIX 7: gap-4 on mobile saves ~64px on phones without changing desktop layout */}
              <div class="grid grid-cols-1 gap-4 md:gap-8 text-left mb-6 md:mb-10">

                {block.challenge && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(getTextColor(), block.labelFont)}>{t.challenge}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(getTextColor(), block.bodyFont)}>
                      {streamLines(block.challenge).map((line) => (
                        <span class="vd-line" style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.built && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(getTextColor(), block.labelFont)}>{t.built}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(getTextColor(), block.bodyFont)}>
                      {streamLines(block.built).map((line) => (
                        <span class="vd-line" style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}

                {block.result && (
                  <div class="border-l border-current border-opacity-10 pl-5">
                    <p class={`${block.labelFontSize || 'text-[9px]'} ${block.labelFontWeight || 'font-normal'} uppercase tracking-[0.25em] opacity-30 mb-2 translate-x-[0.125em]`}
                       style={textStyle(getTextColor(), block.labelFont)}>{t.result}</p>
                    <div class={`${block.bodyFontSize || 'text-[12px]'} ${block.bodyFontWeight || 'font-thin'} leading-relaxed opacity-70`}
                         style={textStyle(getTextColor(), block.bodyFont)}>
                      {streamLines(block.result).map((line) => (
                        <span class="vd-line" style={`transition-delay: ${line.delay};`}>{line.text}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="flex justify-center gap-10 opacity-30">
                {block.package && (
                  <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.2em]`}
                     style={textStyle(getTextColor(), block.metaFont)}>
                    {t.packageLabel}: {block.package}
                  </p>
                )}
                {block.timeline && (
                  <p class={`${block.metaFontSize || 'text-[9px]'} uppercase tracking-[0.2em]`}
                     style={textStyle(getTextColor(), block.metaFont)}>
                    {t.timelineLabel}: {block.timeline}
                  </p>
                )}
              </div>

            </div>
          </div>
        );
      }

      // ── Standard content section ──────────────────────────────────────────
      return (
        <div class="vd-screen vd-reveal">
          <div class="w-full max-w-2xl text-center">

            {block.title && (
              <h2 class={`${block.titleFontSize || 'text-[11px]'} ${block.titleFontWeight || 'font-thin'} uppercase tracking-[1.2em] mb-8 opacity-60 translate-x-[0.6em]`}
                  style={textStyle(getTextColor(), block.titleFont)}>
                {block.title.split('|').map((line: string) => (
                  <span class="block">{line.trim()}</span>
                ))}
              </h2>
            )}

            {block.subTitle && (
              <h3 class={`${block.subTitleFontSize || 'text-[11px]'} ${block.subTitleFontWeight || 'font-thin'} uppercase tracking-[0.5em] mb-6 opacity-50`}
                  style={textStyle(getTextColor(), block.subTitleFont)}>
                {block.subTitle.split('|').map((line: string) => (
                  <span class="block">{line.trim()}</span>
                ))}
              </h3>
            )}

            {block.content && (
              <div class={`${block.fontSize || 'text-[11px]'} ${block.fontWeight || 'font-thin'} opacity-80 leading-relaxed`}
                   style={block.bodyFont ? `font-family: ${fontFamily(block.bodyFont)};` : ''}>
                {block.content.split('|').map((line: string) => (
                  <p class="mb-3">{line.trim()}</p>
                ))}
              </div>
            )}

            {block.email && (
              <div class="flex justify-center mt-10">
                <a href={`mailto:${block.email}`}
                   class="opacity-60 hover:opacity-100 transition-opacity tracking-[0.15em] text-[11px] translate-x-[0.075em]"
                   style={`color: ${getTextColor()};`}>
                  {block.email}
                </a>
              </div>
            )}

            {block.showArt && (
              <div class="w-full mt-10">
                <div class="flex flex-wrap justify-center gap-16 lg:gap-24 w-full">
                  {artFiles.filter(p => p.default.enabled).map((piece) => (
                    <div class={`${widthMap[block.columns] || 'md:w-[calc(33.333%-3rem)]'} w-full`}>
                      <ArtCard {...piece.default} />
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      );
    })}

  </div>
</Layout>

<script>
  // Original reveal animation — fires when 40% of a section is visible after snap
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('vd-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { root: null, threshold: 0.1 }
  );
  document.querySelectorAll('.vd-reveal').forEach(el => observer.observe(el));

  // Logo: scroll to top when already on the home page
  const logoLink = document.querySelector('.vd-fixed-header a');
  if (logoLink) {
    logoLink.addEventListener('click', (e) => {
      const target = new URL(logoLink.getAttribute('href'), location.href);
      if (target.pathname === location.pathname) {
        e.preventDefault();
        document.documentElement.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // ── Process-flow: single dot traveling through every step in sequence ────
  // Rather than every connector pulsing independently (looked like several
  // steps running at once), one dot is measured against the *real* rendered
  // position of each connector line and moved along the whole chain — a
  // single process moving step by step, pausing briefly "at" each label
  // before continuing to the next connector. Works for any step count,
  // label length, or orientation because positions are measured, not
  // hardcoded. Respects prefers-reduced-motion by simply not animating.
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let frameIds: number[] = [];

    // Returns one {start, end} pair per connector line — NOT a flat list —
    // so the animation loop below can never index past the end of it.
    function computeSegments(track: Element) {
      const lines = Array.from(track.querySelectorAll('.vd-connector-line, .vd-connector-v-line'));
      if (lines.length === 0) return null;
      const trackRect = track.getBoundingClientRect();
      const segments = lines.map((line) => {
        const r = line.getBoundingClientRect();
        const vertical = line.classList.contains('vd-connector-v-line');
        return vertical
          ? {
              start: { x: r.left + r.width / 2 - trackRect.left, y: r.top - trackRect.top },
              end:   { x: r.left + r.width / 2 - trackRect.left, y: r.bottom - trackRect.top },
            }
          : {
              start: { x: r.left - trackRect.left, y: r.top + r.height / 2 - trackRect.top },
              end:   { x: r.right - trackRect.left, y: r.top + r.height / 2 - trackRect.top },
            };
      });
      return segments.length > 0 ? segments : null;
    }

    function animateTrack(track: Element) {
      const dot = track.querySelector('.vd-flow-dot') as HTMLElement | null;
      if (!dot) return;
      if (reduceMotion) { dot.style.display = 'none'; return; }

      const segments = computeSegments(track);
      if (!segments) { dot.style.display = 'none'; return; }

      const speed       = 45;   // px/sec while travelling a connector
      const pause        = 320; // ms held, visibly resting, at each step
      const restOpacity  = 0.35;
      const peakOpacity  = 0.85;

      let i = 0;                                  // which connector we're on
      let phase: 'rest' | 'travel' = 'rest';       // resting AT a step, or travelling BETWEEN two
      let phaseStart: number | null = null;

      function tick(ts: number) {
        if (phaseStart === null) phaseStart = ts;
        const seg = segments![i];

        if (phase === 'rest') {
          // Resting at the step this connector leaves FROM — this is what
          // makes step 1 visibly "hold" before the dot ever starts moving,
          // instead of appearing to begin mid-flight.
          dot!.style.left = `${seg.start.x}px`;
          dot!.style.top  = `${seg.start.y}px`;
          dot!.style.opacity = String(restOpacity);
          if (ts - (phaseStart as number) >= pause) { phase = 'travel'; phaseStart = ts; }
        } else {
          const dist = Math.hypot(seg.end.x - seg.start.x, seg.end.y - seg.start.y);
          const dur = Math.max((dist / speed) * 1000, 220);
          const t = Math.min((ts - (phaseStart as number)) / dur, 1);
          dot!.style.left = `${seg.start.x + (seg.end.x - seg.start.x) * t}px`;
          dot!.style.top  = `${seg.start.y + (seg.end.y - seg.start.y) * t}px`;
          dot!.style.opacity = String(restOpacity + (peakOpacity - restOpacity) * Math.sin(Math.PI * t));
          if (t >= 1) {
            i = (i + 1) % segments!.length; // always wraps within a valid index — no overflow
            phase = 'rest';
            phaseStart = ts;
          }
        }
        frameIds.push(requestAnimationFrame(tick));
      }
      frameIds.push(requestAnimationFrame(tick));
    }

    function start() {
      frameIds.forEach((id) => cancelAnimationFrame(id));
      frameIds = [];
      document.querySelectorAll('.vd-flow-track').forEach(animateTrack);
    }

    start();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(start, 250);
    });
  })();
</script>
