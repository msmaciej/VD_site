---
// src/components/Hero.astro 
const { title, content, email, showLine, customColor, baseTextColor, theme } = Astro.props;

// Ghost Text Fallback Logic
const isDarkMode = theme === 'dark';
const themeDefaultColor = isDarkMode ? '#FFFFFF' : '#2A2A2A';
const finalTextColor = customColor || baseTextColor || themeDefaultColor;
---

<div 
  class="max-w-3xl mx-auto text-center px-4 w-full" 
  style={{ color: finalTextColor }}
>
  {title && (
    <h2 class="text-[11px] uppercase tracking-[1.2em] mb-16 opacity-60 translate-x-[0.6em]">
      {title}
    </h2>
  )}
  
  <div class="text-lg md:text-xl font-thin leading-relaxed tracking-[0.1em] uppercase">
    {/* Split the content by '|' for line breaks  */}
    {content && content.split('|').map((line) => (
      <span class="block mb-4 last:mb-0">{line.trim()}</span>
    ))}
  </div>

  {/* ZEN EMAIL: minimalist link [cite: 6] */}
  {email && (
    <div class="mt-16 group">
      <a 
        href={`mailto:${email}`} 
        class="text-sm md:text-base tracking-[0.6em] uppercase opacity-80 hover:opacity-100 transition-all duration-500 hover:tracking-[0.8em]"
      >
        {email}
      </a>
      <div 
        class="h-[1px] w-0 group-hover:w-24 mx-auto mt-4 transition-all duration-500 opacity-30" 
        style={{ backgroundColor: finalTextColor }}
      ></div>
    </div>
  )}
  
  {showLine === true && (
    <div 
      class="w-24 h-[1px] mx-auto mt-24 opacity-20" 
      style={{ backgroundColor: finalTextColor }}
    ></div>
  )}
</div>